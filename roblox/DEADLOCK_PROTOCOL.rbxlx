    [&quot;有效伤害&quot;]=&quot;Damage dealt&quot;,[&quot;有效伤害  &quot;]=&quot;Damage  &quot;,[&quot;有效恢复&quot;]=&quot;Healing done&quot;,[&quot;终局已由服务器确认&quot;]=&quot;Final result confirmed&quot;,[&quot;结算确认&quot;]=&quot;Resolution confirmed&quot;,[&quot;对手阵容全部阵亡，行动完成。&quot;]=&quot;The opposing team has been eliminated.&quot;,[&quot;己方阵容全部阵亡，行动结束。&quot;]=&quot;Your team has been eliminated.&quot;,[&quot;死亡连锁结束后，双方阵容全部阵亡。&quot;]=&quot;The death chain has ended. Both teams were eliminated.&quot;,[&quot;死亡连锁结束 · 双方阵容全部阵亡&quot;]=&quot;Death chain complete · Both teams eliminated&quot;,[&quot;阵亡，行动结束&quot;]=&quot; falls; match complete&quot;,[&quot;正在依次揭示最后的伤害与连锁。胜负已由服务器确认，演出结束后进入行动战报。&quot;]=&quot;Final damage and chains are resolving. The battle report follows.&quot;,[&quot;正在结算&quot;]=&quot;Resolving&quot;,[&quot;结算中…&quot;]=&quot;Resolving…&quot;,[&quot;战报尚未收到。&quot;]=&quot;Waiting for the battle report.&quot;,[&quot;正在确认&quot;]=&quot;Confirming&quot;,
    [&quot;按实际揭示顺序&quot;]=&quot;In reveal order&quot;,[&quot; · 按实际揭示顺序&quot;]=&quot; · In reveal order&quot;,[&quot; · 公开结算&quot;]=&quot; · Revealed events&quot;,[&quot;该档案未保留终局事件，可查看逐回合汇总。&quot;]=&quot;Final events are unavailable in this record. See the round summaries.&quot;,[&quot;早期起手已超出档案保留范围；以下为保留的公开结算。&quot;]=&quot;The opening events are no longer retained. The remaining revealed events follow.&quot;,[&quot;早期事件已超出档案保留范围；回合汇总仍可查阅。&quot;]=&quot;Earlier events are no longer retained. Round summaries are still available.&quot;,[&quot;这一回合没有保留的公开事件。&quot;]=&quot;No revealed events are retained for this round.&quot;,[&quot;无单位阵亡&quot;]=&quot;No units eliminated&quot;,[&quot;上一步&quot;]=&quot;Previous&quot;,[&quot;下一步&quot;]=&quot;Next&quot;,[&quot;查看 R&quot;]=&quot;View R&quot;,[&quot; 事件&quot;]=&quot; events&quot;,[&quot;作战至第 &quot;]=&quot;Reached round &quot;,[&quot;  /  作战至第 &quot;]=&quot; / Reached round &quot;,[&quot;第 &quot;]=&quot;Round &quot;,[&quot; · 生命 &quot;]=&quot; · HP &quot;,[&quot;血&quot;]=&quot;HP&quot;,[&quot;攻 &quot;]=&quot;ATK &quot;,[&quot; / 恢复&quot;]=&quot; / Healing&quot;,[&quot;  /  恢复&quot;]=&quot; / Healing&quot;,[&quot;   /   恢复  &quot;]=&quot; / Healing  &quot;,[&quot; / 5  存活&quot;]=&quot; / 5 alive&quot;,[&quot;你存活 &quot;]=&quot;Your survivors &quot;,[&quot; / 5  ·  剩余 &quot;]=&quot; / 5 · Remaining &quot;,[&quot; HP\n对手存活 &quot;]=&quot; HP\nOpponent survivors &quot;,[&quot; / 5\n完整回合 &quot;]=&quot; / 5\nComplete rounds &quot;,[&quot;\n阵亡最多轮：R&quot;]=&quot;\nMost eliminations: R&quot;,[&quot; 名）&quot;]=&quot; units)&quot;,[&quot;  ·  同核 &quot;]=&quot; · Core ties &quot;,[&quot; 次&quot;]=&quot; times&quot;,[&quot; 点直伤。&quot;]=&quot; direct damage.&quot;,[&quot;残影虽已阵亡，仍需选择一个存活敌人承受 &quot;]=&quot;Echo has fallen. Choose a living enemy to take &quot;,[&quot; / 5     对手：&quot;]=&quot; / 5     Opponent: &quot;,[&quot;完成 &quot;]=&quot;Complete &quot;,[&quot;指挥官 Lv.&quot;]=&quot;Commander Lv.&quot;,[&quot;已拥有&quot;]=&quot;Owned&quot;,[&quot;