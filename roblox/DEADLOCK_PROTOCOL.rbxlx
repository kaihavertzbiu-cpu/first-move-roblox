}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX705"><Properties><string name="Name">AudioController</string><ProtectedString name="Source">-- Bounded polyphony preserves contact transients and independent impact tails.
local SoundService=game:GetService(&quot;SoundService&quot;)
local TweenService=game:GetService(&quot;TweenService&quot;)
local ContentProvider=game:GetService(&quot;ContentProvider&quot;)
local Config=require(script.Parent.PresentationConfig).Audio
local Music=require(script.Parent.MusicController)
local Audio={Master=.65,SFX=.7,Counts={},Loaded={},LastSources={}}
local voices={};local sequence=0;local levelSequence=0;local hoverTime=0;local clock=0
for name,count in pairs(Config.Voices) do
    voices[name]={}
    for i=1,count do
        local sound=Instance.new(&quot;Sound&quot;);sound.Name=&quot;FirstMove&quot;..name..i;sound.Parent=SoundService
        local eq=Instance.new(&quot;EqualizerSoundEffect&quot;)
        local isInterface=name==&quot;Hover&quot; or name==&quot;Interface&quot; or name==&quot;UIBody&quot;
        local bands=isInterface and Config.InterfaceEQ or Config.EQ
        eq.LowGain=bands.Low;eq.MidGain=bands.Mid;eq.HighGain=bands.High;eq.Parent=sound
        if isInterface then
            local room=Instance.new(&quot;ReverbSoundEffect&quot;);room.Name=&quot;DarkInterfaceRoom&quot;
            room.DecayTime=Config.InterfaceRoom.Decay;room.Density=Config.InterfaceRoom.Density
            room.Diffusion=Config.InterfaceRoom.Diffusion;room.DryLevel=0;room.WetLevel=Config.InterfaceRoom.Wet;room.Parent=sound
        end
        table.insert(voices[name],{sound=sound,serial=0,started=0})
    end
end
-- A failed request cannot hold up unrelated asset readiness.
for key,source in pairs(Config.Sources) do
    local sound=Instance.new(&quot;Sound&quot;);sound.Name=&quot;FirstMovePreload_&quot;..key;sound.SoundId=source.id
    sound.Volume=0;sound.Parent=SoundService
    sound.Loaded:Connect(function() Audio.Loaded[key]=true end)
    task.spawn(function()
        pcall(function() ContentProvider:PreloadAsync({sound}) end)
        Audio.Loaded[key]=sound.IsLoaded
    end)
end
local function stop(voice)
    voice.serial+=1;if voice.fade then voice.fade:Cancel();voice.fade=nil end
    voice.sound:Stop();voice.sound.Volume=0
end
local function playLayer(cue,pitch,kind)
    local pool=voices[cue.channel];local voice=pool[1]
    for _,candidate in ipairs(pool) do
        if not candidate.sound.IsPlaying then voice=candidate;break end
        if candidate.started&lt;voice.started then voice=candidate end
    end
    stop(voice);local serial=voice.serial;clock+=1;voice.started=clock
    local source=Config.Sources[cue.asset]
    -- Stream the intended source; never substitute a UI slider for a combat hit.
    local asset=source and source.id or &quot;rbxasset://sounds/&quot;..cue.asset
    Audio.LastSources[kind]=asset
    local sound=voice.sound;sound.SoundId=asset;voice.gain=cue.gain
    sound.PlaybackSpeed=pitch or cue.speed;sound.Volume=cue.gain*Audio.Master*Audio.SFX
    sound.TimePosition=cue.offset or 0;sound:Play()
    task.delay(cue.hold,function()
        if voice.serial~=serial then return end
        voice.fade=TweenService:Create(sound,TweenInfo.new(cue.fade),{Volume=0});voice.fade:Play()
        task.delay(cue.fade,function() if voice.serial==serial then stop(voice) end end)
    end)
end
function Audio.Play(kind,pitch)
    local cue=Config.Cues[kind];if not cue or cue.gain&lt;=0 or Audio.Master*Audio.SFX==0 then return end
    if kind==&quot;hover&quot; then
        local now=os.clock();if now-hoverTime&lt;Config.HoverGap then return end;hoverTime=now
    end
    if cue.channel~=&quot;Hover&quot; and cue.channel~=&quot;Interface&quot; and cue.channel~=&quot;UIBody&quot; then Music.Duck(cue.hold+cue.fade) end
    Audio.LastCue=kind;Audio.Counts[kind]=(Audio.Counts[kind] or 0)+1
    playLayer(cue,pitch,kind)
    local ticket=sequence
    local levelTicket=levelSequence
    for _,layer in ipairs(Config.Layers[kind] or {}) do
        task.delay(layer.delay or 0,function()
            local valid=layer.channel==&quot;UIBody&quot;and levelTicket==levelSequence or layer.channel~=&quot;UIBody&quot;and ticket==sequence
            if valid and Audio.Master*Audio.SFX&gt;0 then playLayer(layer,nil,kind..&quot;:body&quot;) end
        end)
    end
end
function Audio.SetLevels(master,sfx)
    Audio.Master=math.clamp(master,0,1);Audio.SFX=math.clamp(sfx,0,1)
    sequence+=1
    levelSequence+=1
    -- Cancel old envelopes, including scheduled layers; next cue uses new levels.
    for _,pool in pairs(voices) do for _,voice in ipairs(pool) do stop(voice) end end
end
function Audio.Reset()
    sequence+=1;Music.Release()
    for name,pool in pairs(voices) do if name~=&quot;Hover&quot; and name~=&quot;Interface&quot; and name~=&quot;UIBody&quot; then
        for _,voice in ipairs(pool) do stop(voice) end
    end end
end
function Audio.Outcome(winner)
    Audio.Reset();local ticket=sequence;Audio.Play(&quot;terminal&quot;)
    task.delay(Config.OutcomeLead,function()
        if sequence~=ticket then return end
        local cue=winner==&quot;A&quot; and &quot;victory&quot; or winner==&quot;B&quot; and &quot;defeat&quot; or &quot;draw&quot;
        Audio.Play(cue)
        if winner==&quot;A&quot; then task.delay(Config.VictorySecond,function() if sequence==ticket then Audio.Play(cue,Config.VictoryPitch) end end) end
    end)
end
return Audio
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX706"><Properties><string name="Name">CameraController</string><ProtectedString name="Source">-- Deterministic impact framing; no random shake, roll, gameplay delay or private state.
local RunService=game:GetService(&quot;RunService&quot;)
local TweenService=game:GetService(&quot;TweenService&quot;)
local Config=require(script.Parent.PresentationConfig)
local Camera={Reduced=false,Counts={}}
local target=Instance.new(&quot;CFrameValue&quot;);target.Value=Config.Camera.Menu
local fov=Instance.new(&quot;NumberValue&quot;);fov.Value=Config.Camera.Fov
local impact=Instance.new(&quot;NumberValue&quot;)
local tween,fovTween,impactTween;local serial=0;local focusX=0
function Camera.CancelResolve()
    serial+=1;if impactTween then impactTween:Cancel() end;impact.Value=0;focusX=0
end
function Camera.Set(screen,winner)
    if tween then tween:Cancel() end
    Camera.Screen=screen;Camera.CancelResolve()
    local destination=Camera.Reduced and screen==&quot;Result&quot; and Config.Camera.Battle or Config.Camera[screen] or Config.Camera.Menu
    local duration=Camera.Reduced and 0 or screen==&quot;Result&quot; and Config.Camera.ResultTime or Config.CameraTime
    local nextFov=screen==&quot;Menu&quot; and Config.Camera.MenuFov or Config.Camera.Fov
    if screen==&quot;Result&quot; and not Camera.Reduced then nextFov=winner==&quot;B&quot; and Config.Camera.DefeatFov or Config.Camera.ResultFov end
    if fovTween then fovTween:Cancel() end
    fovTween=TweenService:Create(fov,TweenInfo.new(duration,Enum.EasingStyle.Sine),{Value=nextFov});fovTween:Play()
    tween=TweenService:Create(target,TweenInfo.new(duration,Enum.EasingStyle.Sine),{Value=destination});tween:Play()
end
function Camera.Resolve(event,position,hold)
    if Camera.Reduced or Camera.Screen~=&quot;Battle&quot; then return end
    local kind=event and event.kind or &quot;Death&quot;
    local weight=Config.Camera.ImpactWeights[kind]
    if event and event.impactTier then weight=Config.HitFeedback.Weights[event.impactTier] end
    if not weight then return end
    if event and event.damageType==&quot;Bleeding&quot; then return end
    serial+=1;local ticket=serial
    if impactTween then impactTween:Cancel() end
    focusX=position and math.clamp(position.X/6,-1,1) or 0
    Camera.Counts[kind]=(Camera.Counts[kind] or 0)+1
    local attack=math.min(Config.Camera.ResolveIn,(hold or .3)*.3)
    impactTween=TweenService:Create(impact,TweenInfo.new(attack,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Value=weight});impactTween:Play()
    task.delay(attack,function()
        if serial~=ticket then return end
        local release=math.min(Config.Camera.ResolveOut,math.max(.08,(hold or .3)-attack))
        impactTween=TweenService:Create(impact,TweenInfo.new(release,Enum.EasingStyle.Sine),{Value=0});impactTween:Play()
    end)
end
RunService:BindToRenderStep(&quot;DeadlockCamera&quot;,Enum.RenderPriority.Camera.Value+1,function()
    local cam=workspace.CurrentCamera;if not cam then return end
    cam.CameraType=Enum.CameraType.Scriptable
    local amount=Camera.Reduced and 0 or impact.Value
    cam.FieldOfView=fov.Value-amount*Config.Camera.ResolveFov
    local drift=not Camera.Reduced and Camera.Screen~=&quot;Battle&quot; and Camera.Screen~=&quot;Result&quot; and math.sin(os.clock()*.16)*.13 or 0
    cam.CFrame=target.Value*CFrame.new(drift+focusX*Config.Camera.ResolvePan*amount,0,-Config.Camera.ResolvePush*amount)*CFrame.Angles(0,-focusX*math.rad(Config.Camera.ResolveFocus)*amount,0)
    cam.Focus=CFrame.new(0,4.8,0)
end)
return Camera
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX707"><Properties><string name="Name">TableController</string><ProtectedString name="Source">-- Presentation only. These animations do not imply unseen gameplay information.
local RunService = game:GetService(&quot;RunService&quot;)
local Presentation = require(script.Parent.PresentationConfig)
local Feedback = Presentation.TableFeedback
local world = workspace:WaitForChild(&quot;DeadlockWorld&quot;)
local tableModel = world.CommandRoom:WaitForChild(&quot;StrategicTable&quot;)
local Table = {Reduced = false}
local contacts, byId, sessionId, eventCount = {}, {}, nil, 0
local recordsById={}
local effects=require(script.Parent.ResolutionEffects).new(tableModel)
for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do
    contacts[side]={}
    for i=1,5 do
        local p=tableModel:WaitForChild(&quot;Unit hologram &quot;..side..&quot; &quot;..i)
        contacts[side][i]={Part=p,Size=p.Size,CFrame=p.CFrame,Color=p.Color}
    end
end
function Table.reset()
    byId={};recordsById={};sessionId=nil;eventCount=0;effects.reset()
    for _,list in pairs(contacts) do for _,record in ipairs(list) do
        record.Part.Size=record.Size;record.Part.CFrame=record.CFrame
        record.Part.Color=record.Color;record.Part.Transparency=.15
        record.Id=nil;record.Alive=nil;record.PresentedAlive=nil;record.PendingDeath=false
    end end
end
-- Receives the same public projection as the HUD. Never reads private match state.
function Table.present(event,hold)
    if event.kind==&quot;Death&quot; then
        local record=recordsById[event.target]
        if record then record.PresentedAlive=false;record.PendingDeath=false;record.Part.Transparency=Feedback.DeadTransparency end
    end
    effects.present(event,byId[event.source],byId[event.target],hold,Table.Reduced)
end
function Table.approach(event,hold)
    effects.approach(event,byId[event.source],byId[event.target],hold,Table.Reduced)
end
function Table.focus(event)
    local p=byId[event.target] or byId[event.source]
    return p and p.Position
end
function Table.outcome(winner,hold)
    effects.outcome(winner,hold,Table.Reduced)
end
function Table.cancelPresentation()
    effects.reset()
    for _,record in pairs(recordsById) do
        record.PendingDeath=false;record.PresentedAlive=record.Alive
        record.Part.Transparency=record.Alive and Feedback.ContactTransparency or Feedback.DeadTransparency
    end
end
function Table.update(view,selection)
    if sessionId~=view.sessionId or #view.events&lt;eventCount then Table.reset();sessionId=view.sessionId end
    local deaths={};for i=eventCount+1,#view.events do local e=view.events[i];if e.kind==&quot;Death&quot; then deaths[e.target]=true end end
    eventCount=#view.events;byId={};recordsById={}
    for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do for i,record in ipairs(contacts[side]) do
        local h=view.rosters[side][i];local p=record.Part
        if h then
            byId[h.id]=p
            recordsById[h.id]=record
            if record.Id~=h.id then record.PresentedAlive=h.alive;record.PendingDeath=false
            elseif h.alive then record.PresentedAlive=true;record.PendingDeath=false
            elseif deaths[h.id] and record.PresentedAlive then record.PendingDeath=true
            elseif not record.PendingDeath then record.PresentedAlive=false end
            record.Id=h.id;record.Alive=h.alive
            -- The table stays spatial and quiet. Identity, HP and order live in the HUD.
            p.Size=record.Size;p.CFrame=record.CFrame
            local picked=selection.ally==h.id or selection.target==h.id or selection.second==h.id
            local color=picked and Presentation.Colors.Paper or record.Color
            p.Color=color;p.Transparency=record.PresentedAlive and Feedback.ContactTransparency or Feedback.DeadTransparency
        else p.Transparency=.9 end
    end end
end
local coreParts = {}
local pivot = CFrame.new(0, 5.55, 0)
for _,p in ipairs(tableModel:GetDescendants()) do
    if p:IsA(&quot;BasePart&quot;) and (p.Name == &quot;Core lattice&quot; or p.Name == &quot;Core equator&quot; or p.Name == &quot;Axiom nucleus&quot;) then
        table.insert(coreParts, {Part = p, Offset = pivot:ToObjectSpace(p.CFrame)})
    end
end
local sweep = Instance.new(&quot;Part&quot;)
sweep.Name = &quot;LocalScanSweep&quot;
sweep.Anchored = true
sweep.CanCollide = false
sweep.CanQuery = false
sweep.CanTouch = false
sweep.Material = Enum.Material.Neon
sweep.Color = Color3.fromRGB(75, 141, 147)
sweep.Transparency = 0.65
sweep.Size = Vector3.new(7.3, 0.02, 0.045)
sweep.Parent = tableModel
function Table.SetReduced(value)
    value=value and true or false
    if Table.Reduced==value then return end
    Table.Reduced=value
    Table.cancelPresentation()
    sweep.Transparency=Table.Reduced and 1 or .65
end
local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
    elapsed += dt
    if Table.Reduced then return end
    local rotation = pivot * CFrame.Angles(0, elapsed * 0.08, 0)
    for _,record in ipairs(coreParts) do
        record.Part.CFrame = rotation * record.Offset
    end
    sweep.CFrame = CFrame.new(0, 4.095, 0) * CFrame.Angles(0, elapsed * 0.14, 0)
end)
return Table
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX708"><Properties><string name="Name">UnitPresentation</string><ProtectedString name="Source">-- Original vector contact marks. No downloaded textures or gameplay authority.
local Colors=require(script.Parent.PresentationConfig).Colors
local Identity=require(script.Parent.UnitIdentity)
local Locale=require(script.Parent.LocaleController)
local Portrait=require(script.Parent.UnitPortrait)
local Unit={}
local shortRoles={ting_sun=&quot;Execution&quot;,lan_dun=&quot;Defense&quot;,ye_ban=&quot;Lifeline&quot;,yan_wei=&quot;Deathrattle&quot;,bai_ji=&quot;Healing&quot;,shuang_xing=&quot;Split strike&quot;,chi_guang=&quot;Ability lock&quot;,zhe_jing=&quot;Retaliation&quot;,beng_yue=&quot;Double strike&quot;,huan_shi=&quot;Unblockable&quot;,zhui_lie=&quot;Pursuit&quot;,xuan_bao=&quot;Bleeding&quot;}
local TweenService=game:GetService(&quot;TweenService&quot;)
local Reaction=require(script.Parent.PresentationConfig).CardReaction
local Card=require(script.Parent.PresentationConfig).BattleCard
function Unit.portrait(ui,parent,id,position,size,alive,framing) return Portrait.render(parent,id,position,size,alive,framing) end
function Unit.glyph(ui,parent,id,size,color,position)
    local f=ui.make(&quot;Frame&quot;,{Name=&quot;ContactMark&quot;,BackgroundTransparency=1,Position=position or UDim2.fromScale(.075,.15),Size=UDim2.fromOffset(size,size)},parent)
    f:SetAttribute(&quot;UnitId&quot;,id)
    for _,path in ipairs(Identity.byId[id].paths) do for i=1,#path-1 do
        local a,b=path[i],path[i+1];local dx,dy=(b[1]-a[1])*size,(b[2]-a[2])*size
        ui.make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=color,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset((a[1]+b[1])*size/2,(a[2]+b[2])*size/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy)+.7,2),Rotation=math.deg(math.atan2(dy,dx))},f)
    end end
    return f
end
local function clearLabel(button)
    for _,child in ipairs(button:GetChildren()) do if child:IsA(&quot;TextLabel&quot;) or child:IsA(&quot;UIPadding&quot;) then child:Destroy() end end
end
function Unit.roster(ui,button,h,def,owner,marker,picked)
    clearLabel(button)
    button:SetAttribute(&quot;ControlId&quot;,&quot;Hero:&quot;..owner..&quot;:&quot;..h.id)
    button.Selectable=h.alive
    button:SetAttribute(&quot;Disabled&quot;,not h.alive)
    local color=owner==&quot;A&quot; and Colors.Cyan or Colors.Amber
    local order=marker==&quot;①② &quot; and &quot;×2&quot; or (marker or &quot;&quot;):gsub(&quot;%s&quot;,&quot;&quot;)
    -- Battle contacts have their own frame; menu rails never divide the portraits.
    for _,name in ipairs({&quot;CommandRail&quot;,&quot;UpperBevel&quot;})do local o=button:FindFirstChild(name);if o then o.Visible=false end end
    local surface=picked and Card.SelectedSurface or Card.Surface
    button.BackgroundColor3=surface;button.BackgroundTransparency=0
    button:SetAttribute(&quot;RestColor&quot;,surface);button:SetAttribute(&quot;HoverColor&quot;,Card.HoverSurface)
    button:SetAttribute(&quot;Selected&quot;,picked);button:SetAttribute(&quot;BattleCard&quot;,true)
    local edge=button:FindFirstChild(&quot;ButtonEdge&quot;)
    if edge then edge.Color=picked and Card.Highlight or Card.Edge;edge.Thickness=1;edge.Transparency=picked and .08 or .57 end
    local material=button:FindFirstChild(&quot;MachinedSurface&quot;)
    if material then material.Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(183,185,189)) end
    local function metal(name,position,size,tint,alpha)
        return ui.make(&quot;Frame&quot;,{Name=name,BorderSizePixel=0,BackgroundColor3=tint,BackgroundTransparency=alpha or 0,
            Position=position,Size=size,ZIndex=4},button)
    end
    metal(&quot;FrameHighlight&quot;,UDim2.fromOffset(1,1),UDim2.new(1,-2,0,1),Card.Highlight,.72)
    metal(&quot;FrameShadow&quot;,UDim2.new(0,1,1,-1),UDim2.new(1,-2,0,1),Color3.new(0,0,0),.12)
    local inset=Card.Inset
    local portrait=button.AbsoluteSize.Y&gt;=Card.CompactHeight and button.AbsoluteSize.X&gt;=86
    if portrait then
        local art=Portrait.render(button,h.id,UDim2.fromOffset(inset,inset),UDim2.new(1,-inset*2,1,-Card.FooterHeight-inset),h.alive)
        art.ZIndex=2
        local shade=ui.make(&quot;Frame&quot;,{Name=&quot;PortraitVignette&quot;,BorderSizePixel=0,BackgroundColor3=Card.Surface,
            Position=UDim2.new(0,inset,1,-Card.FooterHeight-16),Size=UDim2.new(1,-inset*2,0,16),ZIndex=3},button)
        ui.make(&quot;UIGradient&quot;,{Rotation=90,Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,.05)})},shade)
    end
    local title=ui.text(button,def.name,0,0,1,0,15,h.alive and Colors.Paper or Colors.Muted,Enum.Font.GothamBold)
    title.Name=&quot;UnitName&quot;;title.ZIndex=5;title.TextWrapped=false
    title.Position=portrait and UDim2.new(0,7,1,-Card.FooterHeight+2) or UDim2.fromOffset(7,3)
    title.Size=UDim2.new(1,-14,0,24)
    button:SetAttribute(&quot;TargetOrder&quot;,order~=&quot;&quot; and order or nil)
    if order~=&quot;&quot; then
        local t=ui.text(button,order,0,0,0,0,12,color);t.Name=&quot;TargetOrder&quot;
        t.Position=UDim2.new(1,-24,0,5);t.Size=UDim2.fromOffset(19,20);t.TextWrapped=false;t.ZIndex=6
        t.TextXAlignment=Enum.TextXAlignment.Center;t.BackgroundColor3=Card.Surface;t.BackgroundTransparency=.08
        ui.make(&quot;UIStroke&quot;,{Color=color,Thickness=1,Transparency=.3},t)
    end
    local health=ui.text(button,h.alive and h.hp..&quot;/&quot;..h.maxHp or Locale.isEnglish()and&quot;KO&quot;or&quot;阵亡&quot;,0,0,1,0,13,h.alive and Colors.Paper or Colors.Muted)
    health.Name=&quot;HealthValue&quot;;button:SetAttribute(&quot;MaxHp&quot;,h.maxHp)
    health.Position=UDim2.new(.40,0,1,-26);health.Size=UDim2.new(.60,-7,0,20);health.TextWrapped=false
    health.TextXAlignment=Enum.TextXAlignment.Right;health.ZIndex=5
    local attack=ui.text(button,&quot;ATK &quot;..h.atk,0,0,1,0,10,h.alive and Colors.Muted or Card.Edge)
    attack.Position=UDim2.new(0,7,1,-26);attack.Size=UDim2.new(.45,-7,0,20);attack.Name=&quot;AttackValue&quot;;attack.TextWrapped=false;attack.ZIndex=5
    local track=ui.make(&quot;Frame&quot;,{Name=&quot;HealthTrack&quot;,BorderSizePixel=0,BackgroundColor3=Card.Track,
        Position=UDim2.new(0,7,1,-5),Size=UDim2.new(1,-14,0,2),ZIndex=5},button)
    ui.make(&quot;Frame&quot;,{Name=&quot;HealthFill&quot;,BorderSizePixel=0,BackgroundColor3=h.hp/h.maxHp&lt;=.3 and Card.LowHealth or Card.Health,Size=UDim2.fromScale(h.hp/h.maxHp,1),ZIndex=5},track)
    local accent=picked and Card.Highlight or color
    metal(&quot;ContactCorner&quot;,UDim2.fromOffset(1,1),UDim2.fromOffset(picked and 21 or 9,2),accent,picked and 0 or .35)
    if picked then metal(&quot;SelectedCorner&quot;,UDim2.new(1,-17,1,-2),UDim2.fromOffset(16,2),Card.Highlight,0) end
end
function Unit.react(button,event,hold,reduced)
    local old=button:FindFirstChild(&quot;CardReaction&quot;);if old then old:Destroy() end
    local health=button:FindFirstChild(&quot;HealthValue&quot;)
    if health and event.presentedHp~=nil then
        health.Text=event.presentedAlive==false and (Locale.isEnglish()and&quot;KO&quot;or&quot;阵亡&quot;) or event.presentedHp..&quot;/&quot;..button:GetAttribute(&quot;MaxHp&quot;)
    end
    local track=button:FindFirstChild(&quot;HealthTrack&quot;);local fill=track and track:FindFirstChild(&quot;HealthFill&quot;)
    local layer=Instance.new(&quot;Frame&quot;);layer.Name=&quot;CardReaction&quot;;layer.BackgroundTransparency=1;layer.Size=UDim2.fromScale(1,1)
    layer.ZIndex=15;layer.Active=false;layer.Parent=button
    local tweens={}
    local function animate(object,time,goal)
        local t=TweenService:Create(object,TweenInfo.new(time,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goal)
        table.insert(tweens,t);t:Play()
    end
    local portrait=button:FindFirstChild(&quot;UnitPortrait&quot;)
    local position=portrait and portrait.Position
    local dead=event.kind==&quot;Death&quot;
    layer.Destroying:Connect(function()
        for _,t in ipairs(tweens)do t:Cancel()end
        if portrait and portrait.Parent then
            portrait.Position=position;portrait.Visible=true
            local art=portrait:FindFirstChild(&quot;Artwork&quot;)
            if art then art.ImageColor3=dead and Colors.Muted or Color3.new(1,1,1);art.ImageTransparency=dead and .55 or 0 end
        end
    end)
    if fill and event.presentedHp~=nil then
        fill.BackgroundColor3=event.presentedHp/math.max(1,button:GetAttribute(&quot;MaxHp&quot;))&lt;=.3 and Card.LowHealth or Card.Health
        local goal=UDim2.fromScale(event.presentedHp/math.max(1,button:GetAttribute(&quot;MaxHp&quot;)),1)
        if reduced then fill.Size=goal else animate(fill,Reaction.HealthTime,{Size=goal}) end
    end
    if dead then
        button:SetAttribute(&quot;Disabled&quot;,true);button.Selectable=false
        if portrait and not reduced then
            -- Six clipped pieces retain the authored face crop; no placeholder symbol.
            for row=0,1 do for col=0,2 do
                local piece=Instance.new(&quot;Frame&quot;);piece.Name=&quot;PortraitShard&quot;;piece.ClipsDescendants=true
                piece.BackgroundTransparency=1;piece.Size=UDim2.fromOffset(portrait.AbsoluteSize.X/3,portrait.AbsoluteSize.Y/2)
                local origin=portrait.AbsolutePosition-button.AbsolutePosition
                piece.Position=UDim2.fromOffset(origin.X+col*piece.Size.X.Offset,origin.Y+row*piece.Size.Y.Offset)
                piece.ZIndex=16;piece.Parent=layer
                local image=portrait:Clone();image.Name=&quot;ShardArtwork&quot;;image.Visible=true;image.Position=UDim2.fromScale(-col,-row)
                image.Size=UDim2.fromScale(3,2);image.ZIndex=16;image.Parent=piece
                for _,child in ipairs(image:GetDescendants())do if child:IsA(&quot;GuiObject&quot;)then child.ZIndex=16 end end
                local art=image:FindFirstChild(&quot;Artwork&quot;)
                if art then art.ImageColor3=Color3.new(1,1,1);art.ImageTransparency=0;animate(art,hold,{ImageTransparency=1}) end
                animate(piece,hold,{Position=piece.Position+UDim2.fromOffset((col-1)*Reaction.ShardTravel,(row==0 and -1 or 1)*Reaction.ShardTravel),Rotation=(col-1)*Reaction.ShardAngle})
            end end
            portrait.Visible=false
        end
    elseif event.kind==&quot;Damage&quot; and portrait and not reduced then
        local tier=event.impactTier or 1
        local art=portrait:FindFirstChild(&quot;Artwork&quot;)
        if art then art.ImageColor3=Reaction.ContactTint;animate(art,Reaction.Recover,{ImageColor3=Color3.new(1,1,1)}) end
        portrait.Position=position+UDim2.fromOffset(Reaction.Recoil[tier],0)
        animate(portrait,math.min(hold,Reaction.Recover),{Position=position})
    end
    task.delay(math.max(hold,Reaction.HealthTime),function()if layer.Parent then layer:Destroy()end end)
end
function Unit.draft(ui,button,def,taken,picked)
    clearLabel(button)
    button:SetAttribute(&quot;ControlId&quot;,&quot;Draft:&quot;..def.id)
    button.Selectable=not taken
    button:SetAttribute(&quot;Disabled&quot;,taken and true or false)
    local brief=button.AbsoluteSize.Y&lt;62
    local compact=button.AbsoluteSize.X&lt;120 or brief
    local x=compact and .08 or .29
    local portrait=button.AbsoluteSize.X&gt;=126 and button.AbsoluteSize.Y&gt;=44
    if portrait then
        x=brief and .31 or .38
        Portrait.render(button,def.id,UDim2.new(.01,0,0,2),UDim2.new(brief and .28 or .36,0,0,button.AbsoluteSize.Y-4),not taken)
    elseif not compact then Unit.glyph(ui,button,def.id,30,taken and Colors.Muted or Colors.Cyan) end
    local title=ui.text(button,def.name,x,0,1-x-.04,0,17,taken and Colors.Muted or Colors.Paper,Enum.Font.GothamMedium)
    title.Position=UDim2.new(x,0,0,2);title.Size=UDim2.new(1-x-.04,0,0,24);title.TextWrapped=false
    if not brief then local role=ui.text(button,Locale.isEnglish()and shortRoles[def.id]or def.role,x,0,1-x-.04,0,12,Colors.Muted);role.Position=UDim2.new(x,0,0,28);role.Size=UDim2.new(1-x-.04,0,0,20) end
    local detail=taken and (taken==&quot;A&quot; and &quot;己方已选&quot; or &quot;对手已选&quot;) or brief and def.role or portrait and def.atk..&quot;攻 &quot;..def.maxHp..&quot;血&quot; or def.atk..&quot; ATK · &quot;..def.maxHp..&quot; HP&quot;
    if Locale.isEnglish()and not taken then detail=def.atk..&quot; ATK · &quot;..def.maxHp..&quot; HP&quot;end
    local sub=ui.text(button,detail,x,0,1-x-.04,0,13,Colors.Muted)
    sub.Position=UDim2.new(x,0,1,-24);sub.Size=UDim2.new(1-x-.04,0,0,22);sub.TextWrapped=false
    if picked then ui.make(&quot;UIStroke&quot;,{Color=Colors.Cyan,Thickness=1},button) end
end
return Unit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX709"><Properties><string name="Name">TutorialController</string><ProtectedString name="Source">-- A dismissible field guide driven only by the same public view as the HUD.
-- It never sends actions, pauses the server or changes the rules.
local Legacy=require(game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;DeadlockShared&quot;).LegacyConfig)
local C=require(script.Parent.PresentationConfig).Colors
local defs=require(script.Parent.UnitIdentity).byId
local Tutorial={Enabled=true}
local function hero(view,id)
    for _,h in ipairs(view.rosters.A) do if h.id==id then return h end end
end
function Tutorial.model(view,s)
    if view.training then
        local t=view.training
        local body=t.complete and &quot;正式对手不会公开它准备攻击谁。训练提示不会出现在正式对局中。&quot; or t.feedback==&quot;miss&quot; and &quot;格挡不会替队友承伤。选择哪一名，就保护哪一名。&quot; or t.feedback==&quot;success&quot; and &quot;格挡成功不造成伤害。接下来恢复前一回合受伤的哨卫。&quot; or t.step==2 and &quot;释放后进入冷却，但不会消耗普攻机会。选择复苏，观察哨卫的生命恢复。&quot; or t.step==3 and &quot;先进入攻击阶段，再选择进攻单位。攻击技能需要独立启用；普攻不会自动消耗它。&quot; or &quot;先观察角色用途。复苏负责恢复，是这次教学场景要保护的支援单位。&quot;
        return {title=&quot;记住这一点&quot;,body=body,checks={},tip=&quot;&quot;}
    end
    local phase=view.phase;local mine=view.actor==&quot;A&quot;
    local m={title=&quot;观察对手&quot;,body=&quot;对手正在行动。留意生命和冷却变化。&quot;,checks={},tip=&quot;&quot;}
    local function check(label,done) table.insert(m.checks,{label=label,done=done and true or false}) end
    if phase==&quot;Draft&quot; then
        m.title=&quot;01 / 建立阵容&quot;
        m.body=mine and &quot;先点单位查看能力，再确认入队。当前还可选 &quot;..view.picksRemaining..&quot; 名；双方不能重复选择同一单位。&quot; or &quot;对手正在选人。观察它的阵容，准备下一次选择。&quot;
        check(&quot;查看一名单位的能力&quot;,s.hero~=nil)
        check(&quot;己方已入队 &quot;..#view.rosters.A..&quot; / 5&quot;,#view.rosters.A==5)
        m.tip=&quot;蛇形选人：首选方先选 1 名，之后双方轮流选 2 名，最后另一方选 1 名。&quot;
    elseif phase==&quot;LinkSetup&quot; then
        m.title=&quot;02 / 隐藏命线&quot;
        m.body=mine and &quot;先选己方其他单位，再选敌方单位。己方绑定单位阵亡时，敌方绑定单位也会阵亡。&quot; or &quot;对手正在布置命线。敌方绑定目标不会向你揭示。&quot;
        check(&quot;选择己方单位（不能是缚命）&quot;,s.ally and s.ally~=&quot;ye_ban&quot;)
        check(&quot;选择敌方绑定目标&quot;,s.target~=nil)
        m.tip=&quot;命线触发条件是绑定单位阵亡；不是每次受伤。&quot;
    elseif phase==&quot;CoreSelection&quot; then
        m.title=&quot;03 / 争夺先攻&quot;
        m.body=&quot;秩序克新月，新月克荒芜，荒芜克秩序。锁定前只能看到自己的选择。&quot;
        check(&quot;选择一种能核&quot;,s.core~=nil or view.coreLocked.A)
        check(&quot;锁定后等待双方揭示&quot;,view.coreLocked.A)
        m.tip=&quot;同核会重新暗选。后攻方仍有一次行动，先攻不等于多一次攻击。&quot;
    elseif phase==&quot;SkillPhase&quot; then
        m.title=&quot;04 / 技能窗口&quot;
        m.body=mine and &quot;技能与普攻分开：可先使用当前可用的技能，也可直接进入攻击阶段。&quot; or &quot;对手在使用技能。先观察已经揭示的效果，再准备格挡。&quot;
        local h=hero(view,s.ally);local def=h and defs[h.id]
        check(&quot;选择己方单位，查看技能&quot;,h~=nil)
        if def then
            if h.used then m.tip=def.name..&quot;的限定技已耗尽，本局不能再次使用。&quot;
            elseif h.cooldown&gt;0 then m.tip=def.name..&quot;还需冷却 &quot;..h.cooldown..&quot; 回合；每完整回合结束后递减。&quot;
            elseif h.statuses.blocked then m.tip=&quot;该单位的技能窗口被封锁；普通攻击仍可选择它。&quot;
            elseif def.skill.type==&quot;active_attack_phase&quot; then m.tip=&quot;该技能在攻击阶段启用。先进入攻击，再选择是否使用。&quot;
            elseif def.skill.isPassive then m.tip=&quot;被动能力自动触发，无需手动释放。&quot;
            elseif h.id==&quot;zhui_lie&quot; then m.tip=&quot;先选①目标，再选不同的②目标。①被击杀后才会续算②；仅剩一个敌人时不需②。&quot;
            elseif h.id==&quot;yan_wei&quot; then m.tip=&quot;自毁会让残影立即阵亡并触发亡语；这不是普通伤害技能。&quot;
            else m.tip=def.skill.description end
        else m.tip=&quot;看清技能的触发阶段、冷却或限定次数，再决定是否使用。&quot; end
    elseif phase==&quot;AttackSelect&quot; then
        m.title=&quot;05 / 承诺进攻&quot;
        m.body=mine and &quot;先选己方进攻单位，再选敌方目标。承诺后，对手会暗选格挡，随后才揭示攻击。&quot; or &quot;对手正在选择攻击；它的单位与目标尚未揭示。&quot;
        check(&quot;选择进攻单位&quot;,s.ally~=nil);check(&quot;选择①目标&quot;,s.target~=nil)
        local double=s.useSkill and (s.ally==&quot;beng_yue&quot; or s.ally==&quot;shuang_xing&quot;)
        if double then
            check(&quot;选择②目标&quot;,s.second~=nil)
            m.tip=s.ally==&quot;beng_yue&quot; and &quot;重锤可双击同一目标：再次点①即可标为①②；也可选另一个目标。&quot; or &quot;双轨攻击两名不同敌人，对方只能保护其中一名。仅剩一名敌人时不能启用。&quot;
        else m.tip=&quot;攻击技能有独立开关。普通攻击不会自动消耗攻击技能的冷却。&quot; end
    elseif phase==&quot;BlockSelect&quot; then
        m.title=&quot;06 / 预判格挡&quot;
        m.body=mine and &quot;攻击已承诺，目标仍未知。让一名己方单位保护自己，或选择放弃格挡。&quot; or &quot;你的攻击已承诺。等待对手暗选格挡后一起揭示。&quot;
        check(&quot;选择一名己方格挡单位&quot;,s.ally~=nil)
        m.tip=&quot;格挡只保护所选单位；低语普攻无法格挡。防守方仅剩一名单位时，跳过格挡阶段。&quot;
    elseif phase==&quot;DeathRattleChoice&quot; then
        m.title=&quot;07 / 亡语续算&quot;
        m.body=mine and &quot;残影虽已阵亡，仍需选择一个存活敌人承受 &quot;..Legacy.damage.deathRattle..&quot; 点直伤。&quot; or &quot;对手正在选择亡语目标。选择后会继续尚未结束的结算。&quot;
        check(&quot;选择亡语目标&quot;,s.target~=nil)
        m.tip=&quot;亡语不可格挡。剩余攻击、命线与连锁结算仍会继续，直到队列处理完毕。&quot;
    end
    if not mine and phase~=&quot;CoreSelection&quot; then m.checks={} end
    return m
end
function Tutorial.render(ui,parent,view,selection)
    local m=Tutorial.model(view,selection)
    local list=ui.make(&quot;ScrollingFrame&quot;,{Name=&quot;FieldGuide&quot;,BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromScale(.09,.24),Size=UDim2.fromScale(.84,.38),AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.fromOffset(0,0),ScrollBarThickness=3,ScrollBarImageColor3=C.Cyan},parent)
    ui.make(&quot;UIListLayout&quot;,{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,8)},list)
    local order=0
    local function row(value,size,color)
        local t=ui.text(list,value,0,0,1,0,size,color)
        order+=1;t.LayoutOrder=order;t.Size=UDim2.new(1,-7,0,0);t.AutomaticSize=Enum.AutomaticSize.Y;t.TextYAlignment=Enum.TextYAlignment.Top
    end
    row(m.title,16,C.Paper)
    row(m.body,14,C.Muted)
    for _,item in ipairs(m.checks) do row((item.done and &quot;✓  &quot; or &quot;·  &quot;)..item.label,14,item.done and C.Cyan or C.Paper) end
    if m.tip~=&quot;&quot; then row(m.tip,14,C.Muted) end
end
return Tutorial
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX710"><Properties><string name="Name">ReportController</string><ProtectedString name="Source">local Colors=require(script.Parent.PresentationConfig).Colors
local Shared=game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;DeadlockShared&quot;)
local Config=require(script.Parent.UnitIdentity)
local names={};for _,h in ipairs(Config.heroes) do names[h.id]=h.name end
local Camera=require(script.Parent.CameraController)
local Timing=require(script.Parent.PresentationConfig).Report
local TweenService=game:GetService(&quot;TweenService&quot;)
local Story=require(script.Parent.ReportStory)
local Locale=require(script.Parent.LocaleController)
local Units=require(script.Parent.UnitPresentation)
local Report={}
local lastSession
local reading
function Report.capture()
    if not reading then return end
    if reading.list and reading.list.Parent then
        reading.scrolls[reading.mode..&quot;:&quot;..tostring(reading.round or &quot;all&quot;)]=reading.list.CanvasPosition.Y
    end
    if reading.body and reading.body.Parent then reading.bodyY=reading.body.CanvasPosition.Y end
    reading.frozen=true
end
function Report.render(ui,view,quit,actions)
    local key=view.sessionId or view
    if not reading or reading.key~=key then reading={key=key,mode=&quot;Highlights&quot;,scrolls={},bodyY=0,step=1} end
    local memory=reading
    memory.frozen=false
    local compact=ui.root.AbsoluteSize.X&lt;760 and ui.root.AbsoluteSize.X/math.max(ui.root.AbsoluteSize.Y,1)&lt;1.5
    local short=not compact and ui.root.AbsoluteSize.Y&lt;540
    local shallow=short and ui.root.AbsoluteSize.Y&lt;380
    local report=view.report
    local animate=lastSession~=view.sessionId and not Camera.Reduced
    lastSession=view.sessionId
    local function reveal(panel,delay,duration)
        if not animate then return end
        panel.GroupTransparency=1
        task.delay(delay,function() if panel.Parent then TweenService:Create(panel,TweenInfo.new(duration,Enum.EasingStyle.Quad),{GroupTransparency=0}):Play() end end)
    end
    local function count(label,final,delay)
        label:SetAttribute(&quot;FinalStat&quot;,final)
        if not animate then return end
        label.Text=&quot;0&quot;
        task.delay(delay,function()
            if not label.Parent then return end
            local value=Instance.new(&quot;NumberValue&quot;)
            local connection=value.Changed:Connect(function(n) if label.Parent then label.Text=tostring(math.floor(n+.5)) end end)
            TweenService:Create(value,TweenInfo.new(Timing.CountTime,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Value=final}):Play()
            task.delay(Timing.CountTime,function() if label.Parent then label.Text=tostring(final) end;connection:Disconnect();value:Destroy() end)
        end)
    end
    local story=Story.build(view)
    local title=story.title
    local banner=ui.panel(ui.root,.035,.10,.93,compact and .23 or short and .25 or .23,.02)
    banner.Name=&quot;ReportBanner&quot;
    if shallow then banner.Size=UDim2.new(.93,0,0,100) end
