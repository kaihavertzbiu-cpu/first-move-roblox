            reflect={channel=&quot;Tactical&quot;,asset=&quot;click&quot;,fallback=&quot;volume_slider.ogg&quot;,speed=1.65,gain=.11,hold=.08,fade=.12},
            bleed={channel=&quot;Tactical&quot;,asset=&quot;action_jump_land.mp3&quot;,speed=.82,gain=.09,hold=.045,fade=.12},
