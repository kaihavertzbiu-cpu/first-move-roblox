            subtitle.Text=(not rematch or not rematch.available) and &quot;对手已离开 · 可重新匹配&quot; or rematch.requested and &quot;已邀请对手 · 双方同意后再战&quot; or rematch.opponentRequested and &quot;对手邀请再战 · 可接受或返回&quot; or &quot;双方同意后再战 · 下局交换选人侧&quot;
        end
