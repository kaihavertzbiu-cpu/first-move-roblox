end
return Report
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX711"><Properties><string name="Name">BattleController</string><ProtectedString name="Source">local Shared=game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;DeadlockShared&quot;)
local Config=require(script.Parent.UnitIdentity)
