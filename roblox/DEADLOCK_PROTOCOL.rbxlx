    whoosh={id=&quot;rbxassetid://9125648149&quot;,name=&quot;Magic Zoom Up Sharp Tubular Whoosh Fast Hiss 8&quot;,creator=&quot;ProSoundEffects&quot;,url=&quot;https://create.roblox.com/store/asset/9125648149&quot;,license=&quot;Roblox Creator Store / platform use&quot;,licenseUrl=&quot;https://create.roblox.com/docs/audio/assets&quot;},
    metal={id=&quot;rbxassetid://9125672726&quot;,name=&quot;Metal Impact Sledge Hammer Hits On 5 Ft I-Beam 13&quot;,creator=&quot;ProSoundEffects&quot;,url=&quot;https://create.roblox.com/store/asset/9125672726&quot;,license=&quot;Roblox Creator Store / platform use&quot;,licenseUrl=&quot;https://create.roblox.com/docs/audio/assets&quot;},
    impact={id=&quot;rbxassetid://9125819216&quot;,name=&quot;Robot Impact Miscellaneous Metal Clangs Clunks 4&quot;,creator=&quot;ProSoundEffects&quot;,url=&quot;https://create.roblox.com/store/asset/9125819216&quot;,license=&quot;Roblox Creator Store / platform use&quot;,licenseUrl=&quot;https://create.roblox.com/docs/audio/assets&quot;},
    click={id=&quot;rbxassetid://2789465276&quot;,name=&quot;Button 8 | Sci-fi Interface GUI&quot;,creator=&quot;AgentAST&quot;,url=&quot;https://create.roblox.com/store/asset/2789465276&quot;,license=&quot;CC BY 3.0&quot;,licenseUrl=&quot;https://creativecommons.org/licenses/by/3.0/&quot;},
    select={id=&quot;rbxassetid://2789458365&quot;,name=&quot;Button 4 | Sci-fi Interface GUI&quot;,creator=&quot;AgentAST&quot;,url=&quot;https://create.roblox.com/store/asset/2789458365&quot;,license=&quot;CC BY 3.0&quot;,licenseUrl=&quot;https://creativecommons.org/licenses/by/3.0/&quot;},
    acknowledge={id=&quot;rbxassetid://2789469408&quot;,name=&quot;Acknowledgment 2 | Sci-fi Interface GUI&quot;,creator=&quot;AgentAST&quot;,url=&quot;https://create.roblox.com/store/asset/2789469408&quot;,license=&quot;CC BY 3.0&quot;,licenseUrl=&quot;https://creativecommons.org/licenses/by/3.0/&quot;},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX702"><Properties><string name="Name">UnitIdentity</string><ProtectedString name="Source">-- Product names and original vector insignia. Stable legacy IDs and rules stay intact.
local Legacy=require(game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;DeadlockShared&quot;).LegacyConfig)
local Identity={heroes={},byId={}}
local entries={
    ting_sun={name=&quot;夺魄&quot;,english=&quot;REAPER&quot;,role=&quot;命中处决&quot;,paths={{{.18,.12},{.78,.12},{.78,.3},{.53,.53},{.53,.88}},{{.2,.3},{.42,.52},{.42,.88}},{{.3,.7},{.66,.7}}}},
    lan_dun={name=&quot;哨卫&quot;,english=&quot;WARDEN&quot;,role=&quot;普攻减伤&quot;,paths={{{.18,.17},{.5,.07},{.82,.17},{.78,.62},{.5,.92},{.22,.62},{.18,.17}},{{.5,.26},{.5,.72}},{{.34,.45},{.66,.45}}}},
    ye_ban={name=&quot;缚命&quot;,english=&quot;TETHER&quot;,role=&quot;命线连锁&quot;,paths={{{.08,.35},{.3,.13},{.55,.38},{.33,.62},{.08,.35}},{{.45,.62},{.68,.38},{.92,.65},{.7,.87},{.45,.62}},{{.3,.36},{.7,.64}}}},
    yan_wei={name=&quot;残影&quot;,english=&quot;ECHO&quot;,role=&quot;自毁亡语&quot;,paths={{{.5,.07},{.5,.31}},{{.5,.69},{.5,.93}},{{.07,.5},{.31,.5}},{{.69,.5},{.93,.5}},{{.2,.2},{.34,.34}},{{.66,.66},{.8,.8}},{{.2,.8},{.34,.66}},{{.66,.34},{.8,.2}},{{.5,.34},{.66,.5},{.5,.66},{.34,.5},{.5,.34}}}},
    bai_ji={name=&quot;复苏&quot;,english=&quot;MENDER&quot;,role=&quot;全队恢复&quot;,paths={{{.35,.1},{.65,.1},{.65,.35},{.9,.35},{.9,.65},{.65,.65},{.65,.9},{.35,.9},{.35,.65},{.1,.65},{.1,.35},{.35,.35},{.35,.1}}}},
    shuang_xing={name=&quot;双轨&quot;,english=&quot;TWINRAIL&quot;,role=&quot;异目标双击&quot;,paths={{{.2,.85},{.2,.15},{.36,.3}},{{.7,.85},{.7,.15},{.86,.3}},{{.1,.6},{.32,.6}},{{.6,.6},{.82,.6}}}},
    chi_guang={name=&quot;静锁&quot;,english=&quot;LOCKOUT&quot;,role=&quot;技能封锁&quot;,paths={{{.2,.42},{.8,.42},{.8,.85},{.2,.85},{.2,.42}},{{.32,.42},{.32,.15},{.68,.15},{.68,.42}},{{.5,.57},{.5,.72}}}},
    zhe_jing={name=&quot;棱镜&quot;,english=&quot;PRISM&quot;,role=&quot;受击反伤&quot;,paths={{{.5,.07},{.89,.5},{.5,.93},{.11,.5},{.5,.07}},{{.39,.29},{.23,.5},{.39,.71}},{{.61,.29},{.77,.5},{.61,.71}}}},
    beng_yue={name=&quot;重锤&quot;,english=&quot;MAUL&quot;,role=&quot;自由双击&quot;,paths={{{.12,.12},{.88,.12},{.88,.4},{.12,.4},{.12,.12}},{{.41,.4},{.41,.88},{.59,.88},{.59,.4}},{{.26,.25},{.74,.25}}}},
    huan_shi={name=&quot;低语&quot;,english=&quot;WHISPER&quot;,role=&quot;无法格挡&quot;,paths={{{.08,.5},{.89,.5}},{{.67,.27},{.9,.5},{.67,.73}},{{.24,.15},{.38,.15},{.38,.34}},{{.38,.66},{.38,.85},{.24,.85}}}},
    zhui_lie={name=&quot;荒行&quot;,english=&quot;OUTRIDER&quot;,role=&quot;限定追杀&quot;,paths={{{.08,.62},{.31,.39},{.53,.62}},{{.42,.62},{.65,.39},{.88,.62}},{{.31,.39},{.31,.13},{.52,.13}},{{.65,.62},{.65,.87},{.85,.87}}}},
    xuan_bao={name=&quot;蚀痕&quot;,english=&quot;CORRODE&quot;,role=&quot;命中流血&quot;,paths={{{.5,.08},{.19,.52},{.19,.73},{.36,.9},{.64,.9},{.81,.73},{.81,.52},{.5,.08}},{{.5,.4},{.5,.61}},{{.5,.75},{.5,.8}}}},
}
for _,source in ipairs(Legacy.heroes) do
    local item=table.clone(source);local entry=assert(entries[source.id],&quot;Missing unit identity&quot;)
    item.name=entry.name;item.english=entry.english;item.role=entry.role;item.paths=entry.paths
    item.legacyName=source.name;item.skill=table.clone(source.skill)
    Identity.byId[item.id]=item;table.insert(Identity.heroes,item)
end
-- Descriptions use the same display names everywhere, including passive exceptions.
for _,item in ipairs(Identity.heroes) do
    local description=item.skill.description
    for _,source in ipairs(Legacy.heroes) do description=description:gsub(source.name,Identity.byId[source.id].name) end
    item.skill.description=description
end
Identity.byId.yan_wei.skill.name=&quot;终响&quot;
Identity.byId.bai_ji.skill.name=&quot;修复脉冲&quot;
Identity.byId.shuang_xing.skill.description=&quot;攻击阶段：分别攻击两名不同的存活敌人。对方只能选择一名角色格挡，无法同时挡住两次攻击。敌方仅剩一人时无法启用此技能，仍可普通攻击。&quot;
Identity.byId.xuan_bao.skill.description=&quot;普攻命中使目标持续流血，无回合数限制。在蚀痕所属方每回合行动开始前，目标受到 3 点不可格挡伤害；持续至目标或蚀痕阵亡。重复命中不叠加流血层数。&quot;
function Identity.name(id) return Identity.byId[id] and Identity.byId[id].name or &quot;未选择&quot; end
Identity.factions={survivor=&quot;秩序 · 穹城议会&quot;,anomaly=&quot;新月 · 共鸣体&quot;,wasteland=&quot;荒芜 · 断链者&quot;}
Identity.world=&quot;天穹熄灭后，三方争夺维持城市的能核。秩序握有新月的约束密钥；新月的共鸣能侵入荒芜的改造躯体；荒芜携带的断链噪声能击穿秩序网络。因此秩序克新月、新月克荒芜、荒芜克秩序。新月以自由为筹码拉拢荒芜，却试图唤醒地下的母体『无冕者』。能核是指挥官每回合选择的技术，并不限制角色组队。&quot;
local stories={
ting_sun=&quot;无冕者的追索器。面具里没有面孔，只有一份不断更新的失联名单。它把命中称为回收。&quot;,
lan_dun=&quot;曾守卫穹城最后一道闸门。议会要求他保护能核，他却将撤离的人群挡在盾后。如今他仍在偿还那次抗命的代价。&quot;,
ye_ban=&quot;共鸣网络中逃出的连接节点。它无法理解生死，只能把两个生命视为同一个信号。母体正沿着它留下的命线寻找出口。&quot;,
yan_wei=&quot;一次失败的剥离实验留下的余响。她记得自己有一个名字，却只听见爆裂后的回声。每次主动过载，都是一次拒绝被回收的声明。&quot;,
bai_ji=&quot;穹城地下诊所的工程医师。她的修复脉冲最初用于救助断链者，也因此失去了议会执照。她医治伤者，从不问能核的颜色。&quot;,
shuang_xing=&quot;荒芜车队的双轨枪手。两支发射器来自互为仇敌的工坊，她坚持让它们瞄准不同目标：活下去的人，才有机会继续谈判。&quot;,
chi_guang=&quot;掌管约束密钥的前审查官。发现封锁名单包含平民后，她带走一枚密钥离开穹城。她能关闭异常能力，也知道谁下达了第一道封锁令。&quot;,
zhe_jing=&quot;坠落实验室里醒来的反射体。镜面中保存着创造者最后的攻击轨迹。它没有报复的概念，只会把伤害送回原处。&quot;,
beng_yue=&quot;荒芜矿坑的重载实验幸存者。液压锤曾用来开山，如今砸向奴役工人的闸门。断链噪声让他自由，也让他的力量愈发难以控制。&quot;,
huan_shi=&quot;曾替议会传递秘密命令的相位信使。她的武器与声音一样穿过防线。她正在追查那道让自己故乡陷入沉默的命令。&quot;,
zhui_lie=&quot;荒芜边境的猎路人。他不为议会或母体效忠，只为仍在迁徙的车队清除追兵。每次追杀都预留第二条路线。&quot;,
xuan_bao=&quot;被遗弃的能核净化器。腐蚀液曾用于清除污染，如今它把所有独立生命都判作污染。它仍在执行无冕者留下的最后一条指令。&quot;,
}
for id,story in pairs(stories) do Identity.byId[id].story=story end
return Identity
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX703"><Properties><string name="Name">PresentationDirector</string><ProtectedString name="Source">-- Consume only revealed public events in server order; presentation never delays the server.
local Audio=require(script.Parent.AudioController)
local Camera=require(script.Parent.CameraController)
local Table=require(script.Parent.TableController)
local Music=require(script.Parent.MusicController)
local Impact=require(script.Parent.ImpactPresentation)
local Timing=require(script.Parent.PresentationConfig).Resolution
local SoundConfig=require(script.Parent.PresentationConfig).Audio
local HitFeedback=require(script.Parent.PresentationConfig).HitFeedback
local Director={}
local sessionId,eventCount,terminal=nil,0,false
local queue={};local running=false;local serial=0;local terminalView;local onChanged,onEvent
local signatures={};local previous
local displayed={};local latestRosters
local function syncHeroes(rosters)
    for _,team in pairs(rosters or {}) do for _,h in ipairs(team) do displayed[h.id]={hp=h.hp,alive=h.alive,maxHp=h.maxHp} end end
end
function Director.hero(h)
    local shown=displayed[h.id]
    if not shown or not running then return h end
    local copy=table.clone(h);copy.hp=shown.hp;copy.alive=shown.alive;return copy
end
local function applyContact(e)
    local h=displayed[e.target];if not h then return end
    if e.kind==&quot;Damage&quot; then h.hp=math.max(0,h.hp-(e.effective or e.amount or 0))
    elseif e.kind==&quot;Heal&quot; then h.hp=math.min(h.maxHp,h.hp+(e.effective or e.amount or 0))
    elseif e.kind==&quot;Execute&quot; or e.kind==&quot;LinkTrigger&quot; then h.hp=0
    elseif e.kind==&quot;Death&quot; then h.hp=0;h.alive=false end
    e.presentedHp=h.hp;e.presentedAlive=h.alive
end
local deaths={A=0,B=0}
local function noteDeath(event)
    if event.kind==&quot;ActionStart&quot; or event.kind==&quot;RoundEnd&quot; then deaths={A=0,B=0} end
    if event.kind==&quot;Death&quot; and deaths[event.owner]~=nil then
        deaths[event.owner]=math.min(Timing.MaxActionDeaths,deaths[event.owner]+1)
        return deaths[event.owner]
    end
end
local cues={CoreReveal=&quot;reveal&quot;,CoreTie=&quot;reveal&quot;,Damage=&quot;hit&quot;,Heal=&quot;heal&quot;,Block=&quot;block&quot;,Death=&quot;death&quot;,LinkTrigger=&quot;link&quot;,Execute=&quot;execute&quot;,Skill=&quot;skill&quot;,Lock=&quot;lock&quot;}
local function cue(event)
    if event.kind==&quot;Damage&quot; then return event.damageType==&quot;Reflection&quot; and &quot;reflect&quot; or event.damageType==&quot;Bleeding&quot; and &quot;bleed&quot; or (event.impactTier==3 and &quot;hit_crushing&quot; or event.impactTier==2 and &quot;hit_heavy&quot; or &quot;hit&quot;) end
    if event.kind==&quot;Skill&quot; then return SoundConfig.SkillCues[event.code] or &quot;skill&quot; end
    if event.kind==&quot;Death&quot; and event.owner==&quot;B&quot; and (event.actionDeaths or 0)&gt;1 then
        return &quot;chain&quot;,math.min(SoundConfig.ChainPitchMaximum,SoundConfig.Cues.chain.speed+(event.actionDeaths-2)*SoundConfig.ChainPitchStep)
    end
    return cues[event.kind]
end
function Director.bind(root) Impact.bind(root) end
function Director.reset()
    serial+=1;sessionId=nil;eventCount=0;terminal=false;terminalView=nil;queue={};running=false;onChanged=nil;onEvent=nil;signatures={};previous=nil
    deaths={A=0,B=0};Audio.Reset();Impact.reset()
    displayed={};latestRosters=nil
    if Camera.CancelResolve then Camera.CancelResolve() end
    if Table.cancelPresentation then Table.cancelPresentation() end
end
function Director.resolving() return running or #queue&gt;0 end
local function duration(event)
    if Camera.Reduced then return (event.kind==&quot;Skill&quot; or event.kind==&quot;Death&quot;) and Timing.MajorMinimum or Timing.MinimumStep end
    if event.kind==&quot;Damage&quot; and (event.damageType==&quot;Reflection&quot; or event.damageType==&quot;Bleeding&quot; or event.damageType==&quot;Normal&quot; and (event.source==&quot;huan_shi&quot; or event.target==&quot;lan_dun&quot;)) then return Timing.Passive end
    if event.kind==&quot;Damage&quot; and event.impactTier then return HitFeedback.Holds[event.impactTier] end
    return event.kind==&quot;CoreReveal&quot; and Timing.Core or event.kind==&quot;Skill&quot; and Timing.Skill or event.kind==&quot;Block&quot; and Timing.Block or event.kind==&quot;Execute&quot; and Timing.Execute or event.kind==&quot;LinkTrigger&quot; and Timing.Link or event.kind==&quot;Heal&quot; and Timing.Heal or event.kind==&quot;Death&quot; and ((event.actionDeaths or 0)&gt;1 and Timing.CompactChainDeath or Timing.Death) or event.damageType==&quot;DeathRattle&quot; and Timing.Skill or Timing.Step
end
local function completed(ticket)
    if ticket~=serial then return end
    running=false
    syncHeroes(latestRosters)
    if onChanged then onChanged() end
end
local function finish(ticket)
    if ticket~=serial then return end
    if terminalView and not terminal then
        terminal=true
        local hold=Camera.Reduced and Timing.MajorMinimum or Timing.Outcome
        Camera.Set(&quot;Result&quot;,terminalView.winner);Music.Result();Audio.Outcome(terminalView.winner)
        if Table.outcome then Table.outcome(terminalView.winner,hold) end
        Impact.outcome(terminalView.winner,terminalView.round or 0,hold,Camera.Reduced)
        task.delay(hold,function() completed(ticket) end)
    else completed(ticket) end
end
local function step(ticket)
    if ticket~=serial then return end
    local item=table.remove(queue,1)
    if not item then
        if terminalView and not terminal then task.delay(Camera.Reduced and 0 or Timing.TerminalPause,function() finish(ticket) end)
        else finish(ticket) end
        return
    end
    local hold=Camera.Reduced and duration(item.event) or item.duration
    local e=item.event
    local attack=not Camera.Reduced and e.source and e.target and e.source~=e.target
        and (e.kind==&quot;Block&quot; or e.kind==&quot;Execute&quot; or e.kind==&quot;Damage&quot; and e.damageType~=&quot;Bleeding&quot; and e.damageType~=&quot;Reflection&quot;)
    local lead=attack and math.min(Timing.ContactLead,hold*.32) or 0
    if lead&gt;0 and Table.approach then Table.approach(e,lead) end
    local function contact()
        if serial~=ticket then return end
        applyContact(e)
        e.approached=lead&gt;0
        if Impact.contact and (e.kind==&quot;Damage&quot; or e.kind==&quot;Block&quot; or e.kind==&quot;Execute&quot; or e.kind==&quot;Heal&quot; or e.kind==&quot;Lock&quot;) then Impact.contact(e,Camera.Reduced) end
        Audio.Play(cue(e));Table.present(e,hold-lead);Impact.present(e,hold-lead,Camera.Reduced)
        if onEvent then onEvent(e,hold-lead,item.index) end
        Camera.Resolve(e,Table.focus and Table.focus(e),hold-lead)
    end
    if lead&gt;0 then task.delay(lead,contact) else contact() end
    task.delay(hold,function() step(ticket) end)
end
function Director.update(view,changed,revealed)
    if view.sessionId~=sessionId or #view.events&lt;eventCount then
        Director.reset();sessionId=view.sessionId;eventCount=#view.events;Camera.Set(&quot;Battle&quot;)
        syncHeroes(view.rosters)
        for _,event in ipairs(view.events) do noteDeath(event) end
        previous=view.events[#view.events]
    end
    latestRosters=view.rosters
    for _,team in pairs(view.rosters or {}) do for _,h in ipairs(team) do if not displayed[h.id] then displayed[h.id]={hp=h.hp,alive=h.alive,maxHp=h.maxHp} end end end
    onChanged=changed;onEvent=revealed;Music.Update(view)
    local batch={};local total=0
    for i=eventCount+1,#view.events do
        local public=view.events[i]
        if public.kind==&quot;ActionStart&quot; or public.kind==&quot;RoundEnd&quot; or public.kind==&quot;AttackCommitted&quot; then signatures={} end
        local event=table.clone(public)
        if event.kind==&quot;Damage&quot; and event.damageType~=&quot;Bleeding&quot; and event.damageType~=&quot;Reflection&quot; then
            local damage=event.effective or event.amount or 0
            event.impactTier=damage&gt;=HitFeedback.Crushing and 3 or damage&gt;=HitFeedback.Heavy and 2 or 1
        end
        event.actionDeaths=noteDeath(public)
        if event.kind==&quot;Skill&quot; then signatures[event.source]=event.code end
        if event.kind==&quot;Damage&quot; and event.damageType==&quot;Normal&quot; then event.skillCode=signatures[event.source] end
        if event.kind==&quot;Death&quot; and previous and previous.target==event.target then
            event.cause=(previous.kind==&quot;Execute&quot; or previous.kind==&quot;LinkTrigger&quot;) and previous.kind or nil
        end
        if cues[event.kind] then local hold=duration(event);table.insert(batch,{event=event,duration=hold,index=i});total+=hold end
        previous=public
    end
    eventCount=#view.events
    local factor=total&gt;Timing.BatchBudget and Timing.BatchBudget/total or 1
    for _,item in ipairs(batch) do
        local minimum=(item.event.kind==&quot;Skill&quot; or item.event.kind==&quot;Death&quot; or item.event.kind==&quot;Execute&quot;) and Timing.MajorMinimum or Timing.MinimumStep
        item.duration=math.max(minimum,item.duration*factor);table.insert(queue,item)
    end
    if view.phase==&quot;GameOver&quot; then terminalView=view end
    if not running and (#queue&gt;0 or terminalView and not terminal) then running=true;local ticket=serial;task.defer(function() step(ticket) end) end
end
return Director
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX704"><Properties><string name="Name">PresentationConfig</string><ProtectedString name="Source">return {
    Colors = {
        Paper = Color3.fromRGB(240, 234, 218),
        Muted = Color3.fromRGB(185, 201, 209),
        Ink = Color3.fromRGB(17, 27, 34),
        Panel = Color3.fromRGB(30, 44, 53),
        Line = Color3.fromRGB(65, 83, 90),
        Cyan = Color3.fromRGB(103, 207, 216),
        Amber = Color3.fromRGB(219, 177, 100),
    },
    HoverTime = 0.12, PanelTime = 0.22, CameraTime = 0.75,
    Typography = {BodyMinimum=18,MetaMinimum=14,OpticalScale=1.08,ReferenceHeight=900,MaximumScale=1.12},
    DossierTypography={Family=&quot;rbxasset://fonts/families/SourceSansPro.json&quot;,CodeFamily=&quot;rbxasset://fonts/families/RobotoCondensed.json&quot;,
        Title=38,Code=18,Heading=22,Body=22,Story=21,LineHeight=1.24,
        BodyColor=Color3.fromRGB(228,235,240),StoryColor=Color3.fromRGB(208,219,227)},
    TableFeedback = {
        LineWidth=.035, ContactTransparency=.20, DeadTransparency=.85,
        MaximumParts=48, MinimumTime=.12, MaximumTime=1.4, ReducedTime=.16,
        Radius=.40, SurfaceY=4.18, Segments=10, TravelFraction=.40,
        Tail=.08, LinkColor=Color3.fromRGB(174,164,206), BleedColor=Color3.fromRGB(202,144,105),
        ShockRadius=1.05, ShardCount=8, ShardTravel=.85, ShardHeight=.65,
        SkillRadius=.68, OutcomeRadius=3.5, OutcomeSegments=18,
    },
    Camera = {
        Menu = CFrame.lookAt(Vector3.new(11.8, 10.8, 22.8), Vector3.new(1.8, 4.6, -1)),
        Setup = CFrame.lookAt(Vector3.new(5.5, 12.8, 22), Vector3.new(0, 4.7, 0)),
        Archive = CFrame.lookAt(Vector3.new(-1, 13, 22), Vector3.new(0, 4.8, -0.5)),
        Battle = CFrame.lookAt(Vector3.new(0.8, 12.8, 21), Vector3.new(0, 4.8, -0.5)),
        Result = CFrame.lookAt(Vector3.new(-3.5, 10.6, 18.8), Vector3.new(0, 4.8, -.5)),
        Fov = 46, MenuFov=43, ResultFov = 42, DefeatFov=47.5, ResultTime = 1.1,
        ResolvePush = .85, ResolveIn = .10, ResolveOut = .38,
        ResolveFov=1.5, ResolveFocus=.25, ResolvePan=.18,
        ImpactWeights={Damage=.38,Block=.32,Skill=.45,Execute=1,Death=.80,LinkTrigger=.65},
    },
    CardReaction={HealthTime=.16,Recover=.18,Recoil={3,6,9},ShardTravel=14,ShardAngle=12,ContactTint=Color3.fromRGB(255,182,139)},
    BattleCard={MinimumHeight=104,CompactHeight=86,FooterHeight=51,Inset=4,
        Surface=Color3.fromRGB(19,25,31),SelectedSurface=Color3.fromRGB(31,37,43),HoverSurface=Color3.fromRGB(39,45,51),
        Edge=Color3.fromRGB(119,126,132),Highlight=Color3.fromRGB(206,208,202),Track=Color3.fromRGB(51,57,61),
        Health=Color3.fromRGB(171,190,176),LowHealth=Color3.fromRGB(215,151,119)},
    HitFeedback={Heavy=8,Crushing=12,Weights={.28,.58,.90},Holds={.24,.34,.44},Radii={.55,.90,1.25},NumberSizes={26,32,38}},
    Audio = {
        Sources = require(script.Parent.AudioSources), HoverGap = .16,
        EQ = {Low=1,Mid=0,High=-1}, InterfaceEQ={Low=3,Mid=-4,High=-10},
        InterfaceRoom={Decay=.60,Density=.25,Diffusion=.35,Wet=-18},
        Voices={Hover=1,Interface=2,UIBody=2,Tactical=4,Skill=2,Accent=3,Outcome=2,Body=4},
        OutcomeLead=.3, VictorySecond=.32, VictoryPitch=1.5,
        SkillCues={group_heal=&quot;cast_heal&quot;,stasis_lock=&quot;cast_lock&quot;,thunder_judgment=&quot;cast_execute&quot;,
            rail_shot=&quot;cast_rail&quot;,fury_press=&quot;cast_maul&quot;,final_barrage=&quot;barrage&quot;,overload_explode=&quot;cast_overload&quot;},
        ChainPitchStep=.07,ChainPitchMaximum=1.10,
        Layers = {
            select={{channel=&quot;UIBody&quot;,asset=&quot;impact&quot;,speed=.64,gain=.070,hold=.18,fade=.40,delay=.012}},
            back={{channel=&quot;UIBody&quot;,asset=&quot;whoosh&quot;,speed=.72,gain=.040,hold=.20,fade=.42,delay=.02}},
            confirm={{channel=&quot;UIBody&quot;,asset=&quot;whoosh&quot;,speed=.82,gain=.050,hold=.24,fade=.46,delay=.016}},
            commit={{channel=&quot;UIBody&quot;,asset=&quot;metal&quot;,speed=.72,gain=.090,hold=.26,fade=.46,delay=.015}},
            hit_heavy={{channel=&quot;Body&quot;,asset=&quot;metal&quot;,speed=.64,gain=.20,hold=.35,fade=.40,delay=.025}},
            hit_crushing={{channel=&quot;Body&quot;,asset=&quot;metal&quot;,speed=.58,gain=.25,hold=.48,fade=.50,delay=.035}},
            hit={{channel=&quot;Body&quot;,asset=&quot;metal&quot;,speed=.72,gain=.14,hold=.26,fade=.32,delay=.025}},
            block={{channel=&quot;Body&quot;,asset=&quot;impact&quot;,speed=1.45,gain=.12,hold=.12,fade=.16}},
            death={{channel=&quot;Body&quot;,asset=&quot;impact&quot;,speed=.64,gain=.23,hold=.50,fade=.55,delay=.035}},
            execute={{channel=&quot;Body&quot;,asset=&quot;impact&quot;,speed=.62,gain=.22,hold=.40,fade=.45,delay=.025}},
