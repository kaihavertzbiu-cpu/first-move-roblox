local function economy()return Profile.Value and Profile.Value.economy or {credits=0,xp=0,rating=0,owned={},equipped=&quot;default&quot;}end
local hubSelected=&quot;signal_cyan&quot;
local function badge(parent,x,y,size,tier,color,symbol)
    local f=make(&quot;Frame&quot;,{Name=&quot;RankInsignia&quot;,BackgroundTransparency=1,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(size,size)},parent)
    local function stroke(ax,ay,bx,by,tint,width)
        local dx,dy=(bx-ax)*size,(by-ay)*size
        make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=tint,AnchorPoint=Vector2.new(.5,.5),
            Position=UDim2.fromOffset((ax+bx)*size/2,(ay+by)*size/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),width or 2),
            Rotation=math.deg(math.atan2(dy,dx))},f)
    end
    local plate=make(&quot;Frame&quot;,{Name=&quot;MetalFace&quot;,BorderSizePixel=0,BackgroundColor3=C.Panel,AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.fromScale(.5,.47),Size=UDim2.fromScale(.48,.48),Rotation=45},f)
    make(&quot;UIStroke&quot;,{Color=color,Thickness=2,Transparency=.15},plate)
    make(&quot;UIGradient&quot;,{Rotation=90,Color=ColorSequence.new(Color3.fromRGB(80,94,100),C.Ink)},plate)
    if symbol then
        plate.Size=UDim2.fromScale(.56,.56)
        if symbol==&quot;signal_cyan&quot; then
            -- Broken orbit: the Crescent's signal remains open at the east.
            for i=0,9 do
                local a=math.rad(55+i*25);local b=a+math.rad(22)
                stroke(.5+math.cos(a)*.23,.47+math.sin(a)*.23,.5+math.cos(b)*.23,.47+math.sin(b)*.23,color,3)
            end
            stroke(.50,.28,.67,.47,C.Paper,3);stroke(.67,.47,.50,.66,C.Paper,3)
        elseif symbol==&quot;signal_amber&quot; then
            stroke(.36,.29,.36,.63,C.Paper,3);stroke(.64,.29,.64,.63,C.Paper,3)
            stroke(.28,.39,.72,.39,color,3);stroke(.28,.55,.72,.55,color,3)
            stroke(.50,.23,.50,.71,color,2)
        elseif symbol==&quot;signal_violet&quot; then
            stroke(.28,.58,.44,.32,C.Paper,3);stroke(.44,.32,.51,.60,color,3)
            stroke(.51,.60,.61,.39,C.Paper,3);stroke(.61,.39,.74,.58,color,3)
            stroke(.27,.68,.43,.68,color,2);stroke(.59,.68,.74,.68,color,2)
        elseif symbol==&quot;achievement&quot; then
            if tier==1 then
                stroke(.5,.23,.72,.47,color,2);stroke(.72,.47,.5,.71,color,2)
                stroke(.5,.71,.28,.47,color,2);stroke(.28,.47,.5,.23,color,2)
                stroke(.36,.47,.64,.47,C.Paper,2);stroke(.5,.33,.5,.61,C.Paper,2)
            elseif tier==2 then
                stroke(.29,.30,.5,.47,C.Paper,2);stroke(.5,.47,.71,.30,C.Paper,2)
                stroke(.29,.48,.5,.65,color,2);stroke(.5,.65,.71,.48,color,2)
                stroke(.30,.73,.70,.73,color,2)
            else
                stroke(.23,.47,.5,.29,color,2);stroke(.5,.29,.77,.47,color,2)
                stroke(.77,.47,.5,.65,color,2);stroke(.5,.65,.23,.47,color,2)
                stroke(.5,.37,.59,.47,C.Paper,2);stroke(.59,.47,.5,.57,C.Paper,2)
                stroke(.5,.57,.41,.47,C.Paper,2);stroke(.41,.47,.5,.37,C.Paper,2)
            end
        else
            stroke(.5,.28,.5,.66,C.Paper,3);stroke(.35,.47,.65,.47,color,3)
        end
        return f
    end
    stroke(.5,.19,.5,.70,color,3);stroke(.34,.43,.5,.28,C.Paper,2);stroke(.5,.28,.66,.43,C.Paper,2)
    for i=1,math.min(4,tier)do
        local yy=.43+i*.075
        stroke(.13,yy-.11,.30,yy,color,2);stroke(.70,yy,.87,yy-.11,color,2)
        stroke(.13,yy-.11,.13,yy-.04,C.Muted,2);stroke(.87,yy-.11,.87,yy-.04,C.Muted,2)
    end
    if tier&gt;=3 then
        stroke(.29,.23,.35,.14,color,2);stroke(.35,.14,.43,.23,color,2)
        stroke(.57,.23,.65,.14,color,2);stroke(.65,.14,.71,.23,color,2)
    end
    if tier&gt;=5 then
        stroke(.43,.23,.5,.08,C.Paper,3);stroke(.5,.08,.57,.23,C.Paper,3)
    end
    for i=1,tier do
        local pip=make(&quot;Frame&quot;,{BackgroundColor3=color,BorderSizePixel=0,Rotation=45,Size=UDim2.fromOffset(4,4),
            Position=UDim2.new(.5,(i-(tier+1)/2)*10,.88,0)},f)
    end
    if RankAssets[tier] then
        local fallback=make(&quot;Frame&quot;,{Name=&quot;VectorFallback&quot;,BackgroundTransparency=1,Size=UDim2.fromScale(1,1)},f)
        for _,child in ipairs(f:GetChildren())do if child~=fallback then child.Parent=fallback end end
        local art=make(&quot;ImageLabel&quot;,{Name=&quot;RankArtwork&quot;,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),
            Image=RankAssets[tier],ScaleType=Enum.ScaleType.Fit,Visible=true},f)
        local connection
        local function ready()
            if art.Parent and (art.IsLoaded or game:GetService(&quot;ContentProvider&quot;):GetAssetFetchStatus(art.Image)==Enum.AssetFetchStatus.Success) then
                art.Visible=true;fallback.Visible=false;f:SetAttribute(&quot;ArtworkLoaded&quot;,true)
                if connection then connection:Disconnect();connection=nil end
            end
        end
        connection=art:GetPropertyChangedSignal(&quot;IsLoaded&quot;):Connect(ready)
        f.Destroying:Connect(function()if connection then connection:Disconnect();connection=nil end end)
        task.spawn(function()
            pcall(function()game:GetService(&quot;ContentProvider&quot;):PreloadAsync({art})end)
            ready()
        end)
        ready()
    end
    return f
end
local function hub(kind)
    local function transact(command,id)
        if hubBusy then return end
        hubBusy=true;hubNotice=&quot;正在同步…&quot;;route(kind)
        Profile.action(command,id,function(message)
            hubBusy=false
            hubNotice=message==&quot;已更新&quot; and (command==&quot;Equip&quot; and &quot;印记已装备&quot; or &quot;已加入收藏&quot;) or message
            if screen==kind then route(kind)end
        end)
    end
    Hub.render({root=root,colors=C,progression=Progression,economy=economy,
        stats=function()return Profile.Value and Profile.Value.stats or {}end,
        badge=badge,players=Players,selected=function()return hubSelected end,
        scroll=function()return hubScrolls[kind]or 0 end,
        busy=function()return hubBusy end,notice=function()return hubNotice end,
        navigate=function(nextKind)hubNotice=&quot;&quot;;route(nextKind,true)end,
        select=function(id,nextKind)hubSelected=id;route(nextKind,true)end,
        transact=transact,back=function()hubNotice=&quot;&quot;;route(&quot;Menu&quot;)end,
        startPVP=function()matchMode=&quot;PvP&quot;;route(&quot;Setup&quot;)end,
        invite=function()task.spawn(function()
            local social=game:GetService(&quot;SocialService&quot;)
            local ok,allowed=pcall(function()return social:CanSendGameInviteAsync(Players.LocalPlayer)end)
            if ok and allowed then local sent=pcall(function()social:PromptGameInvite(Players.LocalPlayer)end);hubNotice=sent and &quot;邀请窗口已打开&quot;or&quot;邀请暂不可用&quot;
            else hubNotice=&quot;邀请暂不可用&quot;end
            if screen==&quot;Friends&quot;then route(&quot;Friends&quot;)end
        end)end},kind)
end
local function menu()
    local width,height=root.AbsoluteSize.X,root.AbsoluteSize.Y
    local portrait=width&lt;540
    local short=height&lt;380
    local compact=height&lt;540
    local displayLarge=not compact and not portrait and width&gt;=900
    local leftWidth=portrait and .57 or compact and .38 or .31
    local left=panel(root,.035,.10,leftWidth,.82,.035);left.Name=&quot;CommandMenu&quot;
    left.BackgroundTransparency=1;left.SurfaceEdge.Transparency=1;left.MachinedCorner.Visible=false;left.LowerSeam.Visible=false;left.GraphiteSurface.Enabled=false
    local title=text(left,Product.Name,.075,0,.67,0,Locale.isEnglish()and(short and 22 or portrait and 28 or compact and 30 or 42)or(short and 32 or portrait and 48 or width&lt;900 and 44 or compact and 44 or 64),C.Paper,Enum.Font.GothamBold)
    title.Position=UDim2.new(.075,0,0,short and 5 or 12);title.Size=UDim2.new(.67,0,0,short and 40 or displayLarge and 84 or 62)
    if not short then
        local brand=text(left,Locale.isEnglish()and&quot;TACTICAL DUEL&quot;or Product.EnglishName,.08,0,.84,0,15,C.Cyan,Enum.Font.GothamMedium)
        brand.Position=UDim2.new(.08,0,0,displayLarge and 108 or 76);brand.Size=UDim2.new(.84,0,0,24)
    end
    local gear=button(left,&quot;设置&quot;,0,0,0,0,function()route(&quot;Settings&quot;)end)
    gear:SetAttribute(&quot;ControlId&quot;,&quot;Settings&quot;);gear.Position=UDim2.new(1,-56,0,short and 4 or 16);gear.Size=UDim2.fromOffset(44,44)
    gear.BackgroundTransparency=1;gear.ButtonEdge.Transparency=.85
    gear.UIPadding.PaddingLeft=UDim.new(0,0);gear.UIPadding.PaddingRight=UDim.new(0,0)
    for _,child in ipairs(gear:GetChildren())do if child:IsA(&quot;TextLabel&quot;)then child:Destroy()end end
    local gearRing=make(&quot;Frame&quot;,{Name=&quot;GearRing&quot;,BackgroundTransparency=1,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(18,18)},gear)
    make(&quot;UICorner&quot;,{CornerRadius=UDim.new(1,0)},gearRing);make(&quot;UIStroke&quot;,{Color=C.Muted,Thickness=1.5},gearRing)
    for i=0,7 do local angle=math.rad(i*45)
        make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=C.Muted,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(.5,math.cos(angle)*11,.5,math.sin(angle)*11),Size=UDim2.fromOffset(4,4),Rotation=i*45},gear)
    end
    local core=make(&quot;Frame&quot;,{BackgroundTransparency=1,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(6,6)},gear)
    make(&quot;UICorner&quot;,{CornerRadius=UDim.new(1,0)},core);make(&quot;UIStroke&quot;,{Color=C.Muted,Thickness=1.5},core)
    local buttonHeight=compact and 44 or 50
    local gap=short and 4 or compact and 8 or 12
    local navTop=short and 52 or math.min(displayLarge and 148 or 114,height*.82-buttonHeight*4-gap*3-8)
    local nav=make(&quot;Frame&quot;,{Name=&quot;CommandNavigation&quot;,BackgroundTransparency=1,
        Position=UDim2.fromOffset(0,navTop),Size=UDim2.new(1,0,0,buttonHeight*4+gap*3)},left)
    local trained=Profile.Value and Profile.Value.tutorialComplete
    local entries=trained and {{&quot;开始对局&quot;,&quot;Setup&quot;},{&quot;攻防训练&quot;,&quot;Training&quot;},{&quot;行动档案&quot;,&quot;Record&quot;},{&quot;战术档案&quot;,&quot;Archive&quot;}}or
        {{&quot;开始训练&quot;,&quot;Training&quot;},{&quot;开始对局&quot;,&quot;Setup&quot;},{&quot;行动档案&quot;,&quot;Record&quot;},{&quot;战术档案&quot;,&quot;Archive&quot;}}
    for i,row in ipairs(entries)do
        local b=button(nav,row[1],.08,0,.84,0,function()route(row[2])end)
        b.Position=UDim2.new(.08,0,0,(i-1)*(buttonHeight+gap));b.Size=UDim2.new(.84,0,0,buttonHeight)
        b:SetAttribute(&quot;ControlId&quot;,row[2]==&quot;Training&quot;and &quot;StartTraining&quot;or row[2]==&quot;Setup&quot;and &quot;StartMatch&quot;or row[2])
        b.BackgroundColor3=i&lt;=2 and Color3.fromRGB(21,43,55)or C.Ink;b:SetAttribute(&quot;RestColor&quot;,b.BackgroundColor3)
        b.BackgroundTransparency=i&lt;=2 and .18 or .65
        b.ButtonEdge.Color=i==1 and C.Cyan or Color3.fromRGB(83,117,131);b.ButtonEdge.Transparency=i==1 and .45 or 1; b.UpperBevel.Visible=false
        b.MachinedSurface.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(199,220,228)),ColorSequenceKeypoint.new(.20,Color3.fromRGB(255,255,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(132,159,172))})
        b.CommandRail.BackgroundColor3=i==1 and C.Cyan or C.Muted
        local caption=b:FindFirstChild(&quot;ButtonCaption&quot;)
        if caption then caption.TextSize=i&lt;=2 and 22 or 19;caption.Font=Enum.Font.GothamBold;caption.TextColor3=C.Paper end
    end
    local e=economy()
    local identity=Progression.ById[e.equipped]
    local identityColor=identity and Color3.fromRGB(table.unpack(identity.color))or C.Paper
    local profile=text(root,Players.LocalPlayer.DisplayName..&quot;  ·  Lv.&quot;..Progression.level(e.xp)..&quot;  &quot;..Progression.rank(e.rating),
        .035,.015,.59,.055,15,identityColor,Enum.Font.GothamMedium)
    profile.TextWrapped=false;profile.TextTruncate=Enum.TextTruncate.AtEnd
    profile:SetAttribute(&quot;ProtectedText&quot;,Players.LocalPlayer.DisplayName)
    profile.Size=UDim2.new(.59,0,0,24)
    local currency=text(root,&quot;核晶  &quot;..e.credits,.67,.015,.295,.055,16,C.Cyan,Enum.Font.GothamBold)
    currency.TextXAlignment=Enum.TextXAlignment.Right
    currency.Size=UDim2.new(.295,0,0,24)
    local sideX=portrait and .64 or .625
    local sideWidth=portrait and .325 or .34
    local footerHeight=44
    local footerTop=math.min(height*.82,height*.92-footerHeight)
    local heroHeight=portrait and height*.48 or math.min(height*.70,footerTop-height*.10-12)
    local hero=panel(root,sideX,.10,sideWidth,0,1);hero.Name=&quot;FeaturedUnit&quot;;hero.Size=UDim2.new(sideWidth,0,0,heroHeight);hero.BackgroundTransparency=1
    local featured=Legacy.byId[featuredIds[featuredIndex]]
    local captionHeight=portrait and 86 or 82
    Unit.portrait({make=make},hero,featured.id,UDim2.fromOffset(0,0),UDim2.new(1,0,1,-captionHeight-6),true,portrait and &quot;Face&quot;or &quot;Hero&quot;)
    local caption=make(&quot;Frame&quot;,{Name=&quot;FeaturedCaption&quot;,BackgroundColor3=C.Ink,BackgroundTransparency=.08,BorderSizePixel=0,
        Position=UDim2.new(0,0,1,-captionHeight),Size=UDim2.new(1,0,0,captionHeight)},hero)
    local name=text(caption,featured.name,0,0,0,0,portrait and 20 or 24,C.Paper,Enum.Font.GothamBold)
    name.Position=UDim2.fromOffset(8,0);name.Size=UDim2.new(1,portrait and -16 or -108,0,32)
    local stats=text(caption,&quot;攻击 &quot;..featured.atk..&quot; · 生命 &quot;..featured.maxHp,0,0,0,0,14,C.Muted)
    stats.Position=UDim2.fromOffset(8,38);stats.Size=UDim2.new(1,-108,0,28);stats.Visible=not portrait and sideWidth*width&gt;=255
    local detail=button(caption,&quot;详情&quot;,0,0,0,0,function()route(&quot;Character&quot;)end)
    detail:SetAttribute(&quot;ControlId&quot;,&quot;CharacterDetails&quot;)
    detail.Position=portrait and UDim2.new(.06,0,1,-48)or UDim2.new(1,-96,.5,-22)
    detail.Size=portrait and UDim2.new(.88,0,0,44)or UDim2.fromOffset(88,44)
    detail.BackgroundTransparency=.05
    line(caption,0,0,1,C.Cyan)
    local shortcuts={{&quot;商店&quot;,&quot;Shop&quot;},{&quot;背包&quot;,&quot;Inventory&quot;},{&quot;生涯&quot;,&quot;Career&quot;},{&quot;好友&quot;,&quot;Friends&quot;}}
    for i,row in ipairs(shortcuts)do
        local x=portrait and sideX or .425+(i-1)*.135
        local y=portrait and height*(.60+(i-1)*.076)or footerTop
        local b=button(root,row[1],x,0,portrait and sideWidth or .125,0,function()hubNotice=&quot;&quot;;route(row[2])end)
        b.Position=UDim2.new(x,0,0,y);b.Size=UDim2.new(portrait and sideWidth or .125,0,0,44)
        b.BackgroundTransparency=.45;b.UpperBevel.Visible=false;b.CommandRail.Visible=false;b.ButtonEdge.Transparency=.85
        b:SetAttribute(&quot;HideArrow&quot;,true)
        if not portrait then Kit.icon(b,row[2],-5,10,24,C.Muted);b:SetAttribute(&quot;CaptionInset&quot;,28)end
        local label=b:FindFirstChild(&quot;ButtonCaption&quot;);if label then label.Font=Enum.Font.GothamBold;label.TextSize=18 end
    end
end

local function character()
    local def=Legacy.byId[featuredIds[featuredIndex]]
    local narrow=root.AbsoluteSize.X&lt;640
    local T=Config.DossierTypography
    local p=panel(root,.035,.10,.93,.80,.03);p.Name=&quot;CharacterDossier&quot;
    local art=Unit.portrait({make=make},p,def.id,UDim2.fromOffset(0,0),UDim2.new(narrow and .30 or .40,0,1,-64),true,narrow and &quot;Hero&quot;or &quot;Full&quot;)
    local x=narrow and .34 or .44
    local body=make(&quot;ScrollingFrame&quot;,{Name=&quot;CharacterDetails&quot;,BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.new(x,0,0,14),Size=UDim2.new(1-x-.035,0,1,-82),CanvasSize=UDim2.fromOffset(0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=3,ScrollBarImageColor3=C.Cyan},p)
    make(&quot;UIListLayout&quot;,{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder},body)
    local n=0
    local function row(name,value,size,color,weight,leading,code)
        n+=1
        local t=text(body,value,0,0,1,0,size,color)
        t.Name=name;t:SetAttribute(&quot;NaturalGlyphs&quot;,true);t.Text=value;t.RichText=false
        t.FontFace=Font.new(code and T.CodeFamily or T.Family,weight or Enum.FontWeight.Regular)
        t.LineHeight=leading or 1;t.LayoutOrder=n
        t.Size=UDim2.new(1,-12,0,0);t.AutomaticSize=Enum.AutomaticSize.Y;t.TextYAlignment=Enum.TextYAlignment.Top
        make(&quot;UIPadding&quot;,{PaddingBottom=UDim.new(0,4)},t)
        return t
    end
    local function divider()
        n+=1
        make(&quot;Frame&quot;,{Name=&quot;DossierRule&quot;,LayoutOrder=n,BorderSizePixel=0,BackgroundColor3=C.Line,BackgroundTransparency=.25,Size=UDim2.new(1,-12,0,1)},body)
    end
    n+=1
    local identity=make(&quot;Frame&quot;,{Name=&quot;DossierIdentity&quot;,LayoutOrder=n,BackgroundTransparency=1,Size=UDim2.new(1,-12,0,60)},body)
    local name=row(&quot;CharacterName&quot;,def.name,T.Title,C.Paper,Enum.FontWeight.Bold)
    name.Parent=identity;name.AutomaticSize=Enum.AutomaticSize.None;name.Position=UDim2.fromOffset(0,0);name.Size=UDim2.fromOffset(106,60)
    if Locale.isEnglish()then name.Text=def.english;name.Size=UDim2.new(1,0,0,60)end
    local code=row(&quot;CharacterCodename&quot;,def.english,T.Code,C.Muted,Enum.FontWeight.Bold,1,true)
    code.Parent=identity;code.AutomaticSize=Enum.AutomaticSize.None;code.Position=UDim2.fromOffset(120,25);code.Size=UDim2.new(1,-120,0,32)
    code.Visible=not Locale.isEnglish()
    row(&quot;CombatAttributes&quot;,&quot;攻击  &quot;..def.atk..&quot;     生命  &quot;..def.maxHp,24,C.Cyan,Enum.FontWeight.SemiBold)
    row(&quot;CombatRole&quot;,def.role,19,T.StoryColor,Enum.FontWeight.SemiBold)
    divider()
    local skill=def.skill
    row(&quot;SkillName&quot;,skill.name,T.Heading,C.Paper,Enum.FontWeight.Bold)
    row(&quot;SkillTiming&quot;,skill.isPassive and &quot;被动&quot;or skill.isGameLimited and &quot;每局一次&quot;or skill.cooldown&gt;0 and &quot;冷却 &quot;..skill.cooldown..&quot; 回合&quot;or&quot;特殊触发&quot;,18,C.Amber,Enum.FontWeight.SemiBold)
    row(&quot;SkillDescription&quot;,skill.description,T.Body,T.BodyColor,Enum.FontWeight.Regular,T.LineHeight)
    divider()
    row(&quot;BiographyHeading&quot;,&quot;人物档案&quot;,T.Heading,C.Paper,Enum.FontWeight.Bold)
    row(&quot;Faction&quot;,Legacy.factions[def.faction]or&quot;未知&quot;,18,C.Cyan,Enum.FontWeight.SemiBold)
    row(&quot;Biography&quot;,def.story,T.Story,T.StoryColor,Enum.FontWeight.Regular,T.LineHeight)
    divider()
    row(&quot;WorldHeading&quot;,&quot;世界背景&quot;,T.Heading,C.Paper,Enum.FontWeight.Bold)
    row(&quot;WorldBackground&quot;,Legacy.world,T.Story,T.StoryColor,Enum.FontWeight.Regular,T.LineHeight)
    local previous=button(p,&quot;上一位&quot;,.035,0,.28,0,function()featuredIndex=(featuredIndex-2)%#featuredIds+1;route(&quot;Character&quot;)end)
    local next=button(p,&quot;下一位&quot;,.345,0,.28,0,function()featuredIndex=featuredIndex%#featuredIds+1;route(&quot;Character&quot;)end)
    local back=button(p,&quot;返回&quot;,.655,0,.31,0,function()route(&quot;Menu&quot;)end)
    for _,b in ipairs({previous,next,back})do
        b.Position=UDim2.new(b.Position.X.Scale,0,1,-56);b.Size=UDim2.new(b.Size.X.Scale,0,0,44)
        b.BackgroundColor3=C.Panel;b:SetAttribute(&quot;RestColor&quot;,C.Panel);b.BackgroundTransparency=.2
        b.UpperBevel.Visible=false;b.CommandRail.Visible=false;b.ButtonEdge.Transparency=.8
        b.ButtonCaption.FontFace=Font.new(T.Family,Enum.FontWeight.SemiBold);b.ButtonCaption.TextColor3=C.Paper
    end
end
local function setup()
    local narrow=root.AbsoluteSize.X&lt;620
    local short=root.AbsoluteSize.Y&lt;450
    local p=panel(root,.035,.10,.93,.80);p.Name=&quot;MatchSetup&quot;
    local width=root.AbsoluteSize.X*.93
    local height=root.AbsoluteSize.Y*.80
    local inset=narrow and 16 or 24
    local contentWidth=narrow and width-inset*2 or width*.59-inset
    local function label(value,x,y,w,h,size,color,font)
        local t=text(p,value,0,0,0,0,size,color,font)
        t.Position=UDim2.fromOffset(x,y);t.Size=UDim2.fromOffset(w,h)
        return t
    end
    label(&quot;选择对局&quot;,inset,short and 8 or 16,contentWidth,short and 36 or 50,short and 25 or 34,C.Paper,Enum.Font.GothamBold)
    local top=short and 54 or 88
    local gap=12
    local cardHeight=short and (narrow and 54 or 66) or 100
    local sideBySide=short and not narrow
    local cardWidth=sideBySide and (contentWidth-gap)/2 or contentWidth
    local function modeCard(mode,title,detail,index)
        local selected=matchMode==mode
        local x=inset+(sideBySide and (index-1)*(cardWidth+gap) or 0)
        local y=top+(sideBySide and 0 or (index-1)*(cardHeight+gap))
        local b=button(p,title,0,0,0,0,function() matchMode=mode;route(&quot;Setup&quot;) end,selected)
        b.Position=UDim2.fromOffset(x,y);b.Size=UDim2.fromOffset(cardWidth,cardHeight)
        b:SetAttribute(&quot;ControlId&quot;,mode==&quot;PvP&quot; and &quot;MatchMode&quot; or &quot;AIMode&quot;)
        b:SetAttribute(&quot;Mode&quot;,mode);b:SetAttribute(&quot;Selected&quot;,selected)
        for _,child in ipairs(b:GetChildren())do if child:IsA(&quot;TextLabel&quot;)then child:Destroy()end end
        local titleLabel=text(b,title,0,0,1,0,short and 19 or 24,selected and C.Ink or C.Paper,Enum.Font.GothamBold)
        titleLabel.Position=UDim2.fromOffset(0,short and 2 or 7);titleLabel.Size=UDim2.new(1,-24,0,32)
        local detailLabel=text(b,detail,0,0,1,0,14,selected and C.Ink or C.Muted)
        detailLabel.Position=UDim2.fromOffset(0,short and 34 or 45);detailLabel.Size=UDim2.new(1,-8,0,short and 26 or 36)
        detailLabel.TextYAlignment=Enum.TextYAlignment.Top
        detailLabel.Visible=not (short and narrow)
        local state=text(b,selected and &quot;✓&quot; or &quot;&quot;,0,0,0,0,18,selected and C.Ink or C.Cyan)
        state.Position=UDim2.new(1,-23,0,7);state.Size=UDim2.fromOffset(23,28)
        return b
    end
    modeCard(&quot;PvP&quot;,&quot;双人对峙&quot;,short and &quot;玩家对战&quot; or &quot;与另一位指挥官争夺先攻&quot;,1)
    modeCard(&quot;AI&quot;,&quot;AI 对局&quot;,short and &quot;单人挑战&quot; or &quot;独自迎战，磨炼攻防判断&quot;,2)
    local optionsY=top+(sideBySide and cardHeight or cardHeight*2+gap)+12
    local locked=matchMode==&quot;PvP&quot; or not Profile.Value or Profile.Value.stats.gamesPlayed&lt;1
    local optionLabel=matchMode==&quot;PvP&quot; and &quot;同服务器配对&quot; or difficulty==&quot;Advanced&quot; and &quot;难度 · 高级&quot; or &quot;难度 · 标准&quot;
    local b=button(p,optionLabel,0,0,0,0,function()
        if not locked then difficulty=difficulty==&quot;Standard&quot; and &quot;Advanced&quot; or &quot;Standard&quot;;route(&quot;Setup&quot;) end
    end)
    b.Position=UDim2.fromOffset(inset,optionsY);b.Size=UDim2.fromOffset(contentWidth,44)
    b:SetAttribute(&quot;ControlId&quot;,&quot;Difficulty&quot;);b:SetAttribute(&quot;Disabled&quot;,locked);b.Selectable=not locked
    if locked then for _,t in ipairs(b:GetChildren())do if t:IsA(&quot;TextLabel&quot;)and t.Text==&quot;›&quot; then t:Destroy()end end end
    if optionsY+94&lt;=height-62 then
        label(matchMode==&quot;PvP&quot; and &quot;与朋友进入同一服务器，再同时开始配对。&quot; or locked and &quot;完成首局后解锁高级难度&quot; or &quot;点击切换难度&quot;,inset,optionsY+50,contentWidth,44,14,C.Muted)
    end
    if not narrow then
        local art=make(&quot;Frame&quot;,{Name=&quot;MatchPreview&quot;,BackgroundColor3=C.Panel,BorderSizePixel=0,
            Position=UDim2.new(.64,0,0,16),Size=UDim2.new(.36,-inset,1,-88),ClipsDescendants=true},p)
        Unit.portrait({make=make},art,matchMode==&quot;PvP&quot; and &quot;ting_sun&quot; or &quot;lan_dun&quot;,UDim2.fromScale(0,0),UDim2.fromScale(1,1),true,short and &quot;Face&quot; or &quot;Hero&quot;)
        local strip=make(&quot;Frame&quot;,{Name=&quot;PreviewCaption&quot;,BackgroundColor3=C.Ink,BackgroundTransparency=.03,BorderSizePixel=0,
            Position=UDim2.new(0,0,1,short and -44 or -88),Size=UDim2.new(1,0,0,short and 44 or 88)},art)
        local t=text(strip,&quot;战术对峙&quot;,.06,0,.88,short and 1 or .5,short and 20 or 26,C.Paper,Enum.Font.GothamBold)
        if not short then text(strip,&quot;消灭对方全部单位&quot;,.06,.5,.88,.5,14,C.Muted)end
        line(strip,0,0,1,C.Cyan)
    end
    local footerY=height-56
    local backWidth=math.min(narrow and 116 or 164,contentWidth*.40)
    local back=button(p,&quot;返回指挥室&quot;,0,0,0,0,function()route(&quot;Menu&quot;)end)
    back.Position=UDim2.fromOffset(inset,footerY);back.Size=UDim2.fromOffset(backWidth,44)
    local start=button(p,&quot;开始对局&quot;,0,0,0,0,function() Battle.Difficulty=difficulty;Battle.Mode=matchMode;route(&quot;Battle&quot;) end,true)
    start.Position=UDim2.fromOffset(inset+backWidth+12,footerY);start.Size=UDim2.fromOffset(contentWidth-backWidth-12,44)
    start:SetAttribute(&quot;ControlId&quot;,&quot;BeginMatch&quot;);start:SetAttribute(&quot;Mode&quot;,matchMode)
    start.ButtonCaption.Text=matchMode==&quot;PvP&quot; and &quot;进入配对&quot; or &quot;开始对局&quot;
end
local function briefing()
    local p=panel(root,0.035,0.12,0.34,0.77)
    header(p,&quot;MISSION BRIEFING&quot;,&quot;让对手先露出破绽&quot;)
    for i,row in ipairs({{&quot;01  建立阵容&quot;,&quot;蛇形选取五名不同单位，保留角色各自的反制能力。&quot;},{&quot;02  争夺先攻&quot;,&quot;秩序 &gt; 新月 &gt; 荒芜 &gt; 秩序。相同能核重新暗选。&quot;},{&quot;03  承诺行动&quot;,&quot;技能消耗冷却或限定次数。选中攻击目标后，等待对方暗选格挡。&quot;}}) do
        local y=0.33+(i-1)*0.16
        text(p,row[1],0.07,y,0.86,0.05,15,C.Cyan,Enum.Font.GothamMedium)
        text(p,row[2],0.07,y+0.055,0.86,0.085,14,C.Paper)
    end
    bottomButton(p,&quot;返回任务配置&quot;,function() route(&quot;Setup&quot;) end)
    button(root,&quot;战术指导  &quot;..(Tutorial.Enabled and &quot;开&quot; or &quot;关&quot;),0.79,0.70,0.18,0.075,function() Tutorial.Enabled=not Tutorial.Enabled;savePreferences();route(&quot;Briefing&quot;) end)
    button(root,&quot;开始行动&quot;,0.79,0.81,0.18,0.075,function() Battle.Difficulty=difficulty;Battle.Mode=matchMode;route(&quot;Battle&quot;) end,true)
end
local function archive()
    local p=panel(root,0.035,0.12,0.32,0.77)
    header(p,&quot;TACTICAL ARCHIVE&quot;,&quot;行动手册&quot;)
    text(p,&quot;能核决定行动顺序。技能先于普攻结算；防守方只能让一名单位保护自己。仅剩一名单位时无法格挡。&quot;,0.07,0.33,0.86,0.23,17,C.Paper)
    text(p,&quot;KNOWN  /  已知\n阵容、生命与技能冷却\n\nUNKNOWN  /  未知\n未揭示的能核、攻击意图与敌方命线&quot;,0.07,0.54,0.86,0.25,14,C.Muted)
    bottomButton(p,&quot;返回指挥室&quot;,function() route(&quot;Menu&quot;) end)
    local details=panel(root,0.69,0.12,0.28,0.77)
    text(details,&quot;UNIT REGISTRY  /  12&quot;,0.07,0.03,0.86,0.06,12,C.Cyan)
    local list=make(&quot;ScrollingFrame&quot;,{BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromScale(0.06,0.115),Size=UDim2.fromScale(0.90,0.84),CanvasSize=UDim2.fromOffset(0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=3,ScrollBarImageColor3=C.Cyan},details)
    make(&quot;UIListLayout&quot;,{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,16)},list)
    for i,h in ipairs(Legacy.heroes) do
        local row=make(&quot;Frame&quot;,{BackgroundTransparency=1,Size=UDim2.new(1,-8,0,136),LayoutOrder=i},list)
        Unit.portrait({make=make},row,h.id,UDim2.fromOffset(0,1),UDim2.new(.13,0,0,48),true)
        local title=text(row,h.name..&quot;  /  &quot;..h.english,0.15,0,.85,0,16,C.Paper,Enum.Font.GothamMedium)
        local stats=text(row,h.role..&quot;  ·  &quot;..h.atk..&quot; ATK · &quot;..h.maxHp..&quot; HP&quot;,.15,0,.85,0,13,C.Muted)
        local ability=text(row,h.skill.name..&quot; / &quot;..h.skill.description,0,0,1,0,14,C.Paper)
        local divider=line(row,0,0,1)
        local function measureRow()
            local service=game:GetService(&quot;TextService&quot;)
            local y=0
            for _,label in ipairs({title,stats,ability}) do
                local indent=label==ability and 0 or .15
                local width=math.max(row.AbsoluteSize.X*(1-indent),1)
                local height=math.ceil(service:GetTextSize(label.ContentText,label.TextSize,label.Font,Vector2.new(width,100000)).Y)+6
                label.Position=UDim2.new(indent,0,0,y);label.Size=UDim2.new(1-indent,0,0,height);label.TextYAlignment=Enum.TextYAlignment.Top
                y+=height+6
            end
            divider.Position=UDim2.new(0,0,0,y);row.Size=UDim2.new(1,-8,0,y+1)
        end
        row:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(measureRow)
        for _,label in ipairs({title,stats,ability}) do label:GetPropertyChangedSignal(&quot;TextSize&quot;):Connect(measureRow) end
        task.defer(measureRow)
    end
end
local function getPreferences()
    return {master=Audio.Master,sfx=Audio.SFX,music=Music.Level,reduced=Camera.Reduced,large=uiScale&gt;1,guide=Tutorial.Enabled,language=Locale.Preference}
end
local function changePreference(key,value)
    if key==&quot;master&quot; then Audio.SetLevels(value,Audio.SFX);Music.SetLevels(value,Music.Level)
    elseif key==&quot;sfx&quot; then Audio.SetLevels(Audio.Master,value)
    elseif key==&quot;music&quot; then Music.SetLevels(Audio.Master,value)
    elseif key==&quot;reduced&quot; then Camera.Reduced=value;if Table.SetReduced then Table.SetReduced(value) else Table.Reduced=value end;Camera.Set(Camera.Screen)
    elseif key==&quot;large&quot; then uiScale=value and 1.12 or 1
    elseif key==&quot;guide&quot; then Tutorial.Enabled=value
    elseif key==&quot;language&quot; then Locale.Set(value) end
    savePreferences();Kit.fit(root,uiScale)
end
local function settings()
    local narrow=root.AbsoluteSize.X&lt;760
    local p=panel(root,.035,.12,narrow and .93 or .42,.77);p.Name=&quot;PreferencesPanel&quot;
    header(p,&quot;SYSTEM PREFERENCES&quot;,&quot;设置&quot;)
    local area=make(&quot;Frame&quot;,{Name=&quot;SettingsArea&quot;,BackgroundTransparency=1,Position=UDim2.fromScale(.07,.34),Size=UDim2.new(.86,0,.66,-108)},p)
    Preferences.render(area,getPreferences,changePreference,function() return uiScale end)
    local about=button(p,&quot;关于与许可&quot;,.52,0,.41,0,function()route(&quot;Credits&quot;)end)
    about.Position=UDim2.new(.52,0,1,-56);about.Size=UDim2.new(.41,0,0,44)
    local note=text(p,Profile.statusText(),.07,0,.86,0,12,C.Muted);note.Position=UDim2.new(.07,0,1,-85);note.Size=UDim2.new(.86,0,0,26)
    local back=bottomButton(p,&quot;返回指挥室&quot;,function() route(&quot;Menu&quot;) end);back.Size=UDim2.new(.41,0,0,44)
end
local function openSessionMenu()
    if not Battle.inProgress() then return end
    SessionMenu.open({root=root,getPreferences=getPreferences,changePreference=changePreference,scale=function() return uiScale end,resume=Battle.refresh,quit=Battle.quit})
end
local function credits()
    local p=panel(root,0.035,0.12,0.35,0.77)
    header(p,&quot;PROJECT CREDITS&quot;,Product.Name..&quot; / &quot;..Product.EnglishName)
    local list=make(&quot;ScrollingFrame&quot;,{Name=&quot;CreditsList&quot;,BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromScale(.07,.33),Size=UDim2.new(.86,0,.67,-76),CanvasSize=UDim2.fromOffset(0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=3,ScrollBarImageColor3=C.Cyan},p)
    make(&quot;UIListLayout&quot;,{SortOrder=Enum.SortOrder.LayoutOrder},list)
    local value=&quot;核心玩法来源\n《核域对峙 / 异象迷宫》Web 原型\n\n场景与界面\n本工程原创几何、排版与镜头\n\n音效\nRoblox 内置采样；AgentAST / Sci-fi Interface GUI\n剪辑、调速、淡出与混音。\n&quot;
    for _,key in ipairs({&quot;click&quot;,&quot;select&quot;,&quot;acknowledge&quot;}) do
        local source=Config.Audio.Sources[key]
        value..=&quot;\n&quot;..source.name..&quot;\n&quot;..source.creator..&quot; · &quot;..source.license..&quot;\n&quot;..source.url..&quot;\n&quot;
    end
    value..=&quot;\n许可\nhttps://creativecommons.org/licenses/by/3.0/&quot;
    value..=&quot;\n战斗音效 · Courtesy of Pro Sound Effects\n&quot;
    for _,key in ipairs({&quot;whoosh&quot;,&quot;metal&quot;,&quot;impact&quot;}) do local source=Config.Audio.Sources[key];value..=&quot;\n&quot;..source.name..&quot;\n&quot;..source.creator..&quot; · &quot;..source.license..&quot;\n&quot;..source.url..&quot;\n&quot; end
    value..=&quot;\n平台音频使用说明\nhttps://create.roblox.com/docs/audio/assets&quot;
    value..=&quot;\n环境音乐 · Courtesy of APM Music\n&quot;
    for _,key in ipairs({&quot;Deployment&quot;,&quot;Battle&quot;,&quot;Endgame&quot;}) do local source=Config.Music.Sources[key];value..=&quot;\n&quot;..source.name..&quot;\n&quot;..source.license..&quot;\n&quot;..source.url..&quot;\n&quot; end
    value..=&quot;\n音乐许可\nhttps://en.help.roblox.com/hc/en-us/articles/360000927163-Using-Licensed-Music-on-Roblox&quot;
    local credit=text(list,value,0,0,1,0,14,C.Paper);credit.TextYAlignment=Enum.TextYAlignment.Top
    local function measureCredits()
        local bounds=game:GetService(&quot;TextService&quot;):GetTextSize(credit.ContentText,credit.TextSize,credit.Font,Vector2.new(math.max(list.AbsoluteSize.X-8,1),100000))
        credit.Size=UDim2.new(1,-8,0,math.ceil(bounds.Y)+4)
    end
    list:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(measureCredits)
    credit:GetPropertyChangedSignal(&quot;TextSize&quot;):Connect(measureCredits)
    task.defer(measureCredits)
    bottomButton(p,&quot;返回指挥室&quot;,function() route(&quot;Menu&quot;) end)
end
local function recordScreen()
    local p=panel(root,.035,.12,.32,.77);header(p,&quot;TACTICAL RECORD&quot;,&quot;行动档案&quot;)
    local profile=Profile.Value;local s=profile and profile.stats
    local value=s and s.gamesPlayed&gt;0 and (&quot;完成 &quot;..s.gamesPlayed..&quot; 局  /  胜率 &quot;..math.floor(s.wins/s.gamesPlayed*100)..&quot;%\n胜利 &quot;..s.wins..&quot;  /  失利 &quot;..s.losses..(s.draws&gt;0 and &quot;\n同归于尽 &quot;..s.draws or &quot;&quot;)..&quot;\n平均回合 &quot;..string.format(&quot;%.1f&quot;,s.totalTurns/s.gamesPlayed)..&quot;\n最高连胜 &quot;..s.bestStreak..&quot;\n格挡预判 &quot;..(s.readAttempts&gt;0 and math.floor(s.readHits/s.readAttempts*100)..&quot;%&quot; or &quot;尚无样本&quot;)) or &quot;尚无已完成行动。\n完成一局后，会保留统计和最近五份战报。&quot;
    text(p,value,.07,.34,.86,.36,18,C.Paper);text(p,Profile.statusText(),.07,.74,.86,.10,12,C.Muted)
    bottomButton(p,&quot;返回指挥室&quot;,function() route(&quot;Menu&quot;) end)
    local side=panel(root,.59,.12,.38,.77);text(side,&quot;RECENT OPERATIONS / 最近行动&quot;,.06,.035,.88,.08,13,C.Cyan)
    local list=make(&quot;ScrollingFrame&quot;,{Name=&quot;RecordHistory&quot;,BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.fromScale(.06,.15),Size=UDim2.fromScale(.88,.80),CanvasSize=UDim2.fromOffset(0,profile and #profile.history*82 or 0),ScrollBarThickness=3,ScrollBarImageColor3=C.Cyan},side)
    if profile then for i,entry in ipairs(profile.history) do local v=entry.view;local title=(v.winner==&quot;A&quot; and &quot;胜利&quot; or v.winner==&quot;B&quot; and &quot;失利&quot; or &quot;同归于尽&quot;)..&quot;  /  &quot;..(entry.difficulty==&quot;PvP&quot; and &quot;双人&quot; or entry.difficulty==&quot;Advanced&quot; and &quot;高级&quot; or &quot;标准&quot;)..&quot;  /  &quot;..v.round..&quot; 回合&quot;
        local b=button(list,title,0,0,1,0,function() historyView=v;route(&quot;HistoryReport&quot;) end);b.Position=UDim2.fromOffset(0,(i-1)*82);b.Size=UDim2.new(1,-8,0,70);b:SetAttribute(&quot;ControlId&quot;,&quot;History:&quot;..i)
    end end
end
local function fit()
    Kit.fit(root,uiScale)
end
route=function(nextScreen,resetHub)
    local oldList=root:FindFirstChild(&quot;HubContent&quot;,true)
    if oldList then hubScrolls[screen]=oldList.CanvasPosition.Y end
    if resetHub then hubScrolls[nextScreen]=0 end
    SessionMenu.close(false)
    screen=nextScreen
    root:ClearAllChildren()
    root:SetAttribute(&quot;Screen&quot;,screen)
    Camera.Set(screen)
    Music.SetScreen(screen)
    chrome()
    if screen==&quot;Menu&quot; then menu()
    elseif screen==&quot;Shop&quot; or screen==&quot;Inventory&quot; or screen==&quot;Career&quot; or screen==&quot;Friends&quot; then hub(screen)
    elseif screen==&quot;Character&quot; then character()
    elseif screen==&quot;Setup&quot; then setup()
    elseif screen==&quot;Briefing&quot; then briefing()
    elseif screen==&quot;Archive&quot; then archive()
    elseif screen==&quot;Settings&quot; then settings()
    elseif screen==&quot;Record&quot; then recordScreen()
    elseif screen==&quot;HistoryReport&quot; and historyView then Report.render({root=root,make=make,text=text,button=button,panel=function(parent,x,y,w,h,a) return panel(parent,x,y,w,h,a,true) end,line=line,fit=fit},historyView,function() route(&quot;Record&quot;) end)
    elseif screen==&quot;Abandoned&quot; then local p=panel(root,.035,.12,.34,.77);header(p,&quot;OPERATION CANCELLED&quot;,&quot;对手已离开&quot;)
        text(p,&quot;这场行动已取消，不记录胜负。\n你可以回到指挥室重新配对。&quot;,.07,.36,.86,.30,18,C.Paper);bottomButton(p,&quot;返回指挥室&quot;,function() route(&quot;Menu&quot;) end,true)
    elseif screen==&quot;Credits&quot; then credits()
    elseif screen==&quot;Training&quot; then
        Battle.Mode=&quot;Training&quot;;Battle.Difficulty=&quot;Standard&quot;;screen=&quot;Battle&quot;;root:SetAttribute(&quot;Screen&quot;,&quot;Battle&quot;);Camera.Set(&quot;Battle&quot;);Battle.start()
    elseif screen==&quot;Battle&quot; then
        text(root,&quot;正在连接战略桌…&quot;,0.35,0.43,0.45,0.12,24,C.Paper)
        Battle.start()
    elseif screen==&quot;Title&quot; then
        local p=panel(root,0.035,0.19,0.35,0.65,0.08)
        text(p,&quot;AXIOM STRATEGIC SYSTEMS&quot;,0.075,0.04,0.85,0.10,11,C.Cyan)
        text(p,Product.Name,0.07,0.16,0.88,0.30,66,C.Paper,Enum.Font.GothamBold)
        text(p,Product.EnglishName,0.075,0.45,0.84,0.10,21,C.Cyan,Enum.Font.GothamMedium)
        text(p,Product.Tagline,0.075,0.60,0.84,0.10,17,C.Muted)
        button(p,&quot;ENTER COMMAND&quot;,0.075,0.77,0.85,0.15,function() route(&quot;Menu&quot;) end,true)
    end
    Responsive.apply(root,screen)
    fit()
    if UserInputService.GamepadEnabled then
        GuiService.SelectedObject=root:FindFirstChildWhichIsA(&quot;TextButton&quot;,true)
    end
end
local resizeTicket=0
root:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(function()
    resizeTicket+=1;local ticket=resizeTicket
    task.delay(.08,function() if ticket~=resizeTicket then return end
        SessionMenu.reflow()
        if screen==&quot;Battle&quot; and Battle.active() then Battle.refresh()
        elseif screen~=&quot;Boot&quot; and screen~=&quot;Battle&quot; then route(screen) end
    end)
end)
game:GetService(&quot;ContextActionService&quot;):BindActionAtPriority(&quot;FirstMoveSessionMenu&quot;,function(_,state,input)
    if not SessionMenu.active() and not Battle.active() then return Enum.ContextActionResult.Pass end
    if state==Enum.UserInputState.Begin then
        if SessionMenu.active() then SessionMenu.close()
        elseif Battle.inProgress() then openSessionMenu()
        elseif input.KeyCode==Enum.KeyCode.Backspace or input.KeyCode==Enum.KeyCode.ButtonB then Audio.Play(&quot;back&quot;);Battle.quit() end
    end
    return Enum.ContextActionResult.Sink
end,false,Enum.ContextActionPriority.High.Value,Enum.KeyCode.Tab,Enum.KeyCode.Backspace,Enum.KeyCode.ButtonB,Enum.KeyCode.ButtonStart)
UserInputService.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.KeyCode==Enum.KeyCode.Backspace or input.KeyCode==Enum.KeyCode.ButtonB then
        if not Battle.active() and not SessionMenu.active() and screen~=&quot;Title&quot; then Audio.Play(&quot;back&quot;);route(&quot;Menu&quot;) end
    end
end)
local boot=panel(root,0,0,1,1,0)
text(boot,&quot;FIRST MOVE  /  AXIOM CONTROL&quot;,0.35,0.43,0.5,0.10,24,C.Paper,Enum.Font.GothamMedium)
Battle.init({root=root,make=make,text=text,button=button,panel=panel,line=line,chrome=chrome,fit=fit,fontScale=function() return uiScale end,route=route,preferences=savePreferences,openMenu=openSessionMenu,menuActive=SessionMenu.active,closeMenu=function() SessionMenu.close(false) end,reflow=Responsive.apply})
Profile.Changed.Event:Connect(function()
    if Profile.Value then local s=Profile.Value.settings;Locale.Set(s.language or &quot;auto&quot;);Audio.SetLevels(s.master,s.sfx);Music.SetLevels(s.master,s.music);Camera.Reduced=s.reduced;if Table.SetReduced then Table.SetReduced(s.reduced) else Table.Reduced=s.reduced end;uiScale=s.large and 1.12 or 1;Tutorial.Enabled=s.guide end
    if screen==&quot;Menu&quot; or screen==&quot;Record&quot; or screen==&quot;Settings&quot; or screen==&quot;Setup&quot; or screen==&quot;Shop&quot; or screen==&quot;Inventory&quot; or screen==&quot;Career&quot; or screen==&quot;Character&quot; then route(screen) end
end)
Profile.start()
Locale.Changed.Event:Connect(function()
    task.defer(function()
        if SessionMenu.active()then SessionMenu.reflow()end
        if screen==&quot;Battle&quot;and Battle.active()then Battle.refresh()
        elseif screen~=&quot;Boot&quot;and screen~=&quot;Battle&quot;then route(screen)end
    end)
end)

for _,event in ipairs({Players.PlayerAdded,Players.PlayerRemoving})do
    event:Connect(function()task.defer(function()if screen==&quot;Friends&quot;then route(&quot;Friends&quot;)end end)end)
end
task.delay(0.8,function() route(&quot;Menu&quot;) end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX713"><Properties><string name="Name">ProfileController</string><ProtectedString name="Source">local Profile={Value=nil,Storage={mode=&quot;Cloud&quot;,status=&quot;Loading&quot;},Changed=Instance.new(&quot;BindableEvent&quot;)}
local request;local desired;local serial=0
local function accept(packet)
    if type(packet)~=&quot;table&quot; or type(packet.profile)~=&quot;table&quot; then return end
    if desired then packet.profile.settings=table.clone(desired) end
    Profile.Value=packet.profile;Profile.Storage=packet.storage;Profile.Changed:Fire()
end
function Profile.start()
    task.spawn(function()
        local folder=game.ReplicatedStorage:WaitForChild(&quot;FirstMoveProfile&quot;,15)
        if not folder then Profile.Storage.status=&quot;Unavailable&quot;;Profile.Changed:Fire();return end
        request=folder:WaitForChild(&quot;Request&quot;);folder.Updated.OnClientEvent:Connect(accept)
        local ok,packet=pcall(function() return request:InvokeServer(&quot;Get&quot;) end)
        if ok then accept(packet) else Profile.Storage.status=&quot;Unavailable&quot;;Profile.Changed:Fire() end
    end)
end
function Profile.save(settings)
    desired=table.clone(settings);serial+=1;local ticket=serial
    task.delay(.4,function()
        if serial~=ticket or not request then return end
        local ok,packet=pcall(function() return request:InvokeServer({command=&quot;Settings&quot;,settings=desired}) end)
        if ok then if serial==ticket then desired=nil end;accept(packet) else Profile.Storage.status=&quot;Unavailable&quot;;Profile.Changed:Fire() end
    end)
end
function Profile.statusText()
    if Profile.Storage.status==&quot;ReadOnly&quot; then return &quot;档案版本受保护 · 本次进度暂不写入&quot; end
    if Profile.Storage.mode==&quot;Studio&quot; then return &quot;Studio 试玩 · 记录仅在本次测试内保留&quot; end
    return ({Loading=&quot;正在读取行动档案…&quot;,Saving=&quot;正在保存…&quot;,Pending=&quot;有记录待保存&quot;,Saved=&quot;行动档案已保存&quot;,Unavailable=&quot;云端暂不可用 · 可以继续对局&quot;})[Profile.Storage.status] or &quot;正在同步…&quot;
end
function Profile.action(command,itemId,done)
    if not request then if done then done(&quot;档案正在读取&quot;)end;return end
    task.spawn(function()
        local ok,packet=pcall(function()return request:InvokeServer({command=command,itemId=itemId})end)
        if ok and packet then accept(packet)end
        if done then done(not ok and &quot;连接失败，请重试&quot; or not packet and &quot;请求未被接受&quot; or packet.error or packet.storage.status==&quot;Unavailable&quot; and &quot;保存待重试，请勿重复兑换&quot; or &quot;已更新&quot;)end
    end)
end
return Profile
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX714"><Properties><string name="Name">PreferencesView</string><ProtectedString name="Source">local Kit=require(script.Parent.InterfaceKit)
local C=require(script.Parent.PresentationConfig).Colors
local Preferences={}
local Locale=require(script.Parent.LocaleController)
function Preferences.render(parent,get,change,scale)
    local list=Kit.make(&quot;ScrollingFrame&quot;,{Name=&quot;PreferencesList&quot;,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),CanvasSize=UDim2.fromOffset(0,420),ScrollBarThickness=3,ScrollBarImageColor3=C.Cyan},parent)
    local labels={};local toggles={}
    local languageCaption
    local function draw()
        local s=get()
        if languageCaption then languageCaption.Text=&quot;语言  &quot;..Locale.label() end
        for key,label in pairs(labels) do label.Text=({master=&quot;主音量&quot;,sfx=&quot;音效&quot;,music=&quot;音乐&quot;})[key]..&quot;  &quot;..math.floor(s[key]*100+.5)..&quot;%&quot; end
        for key,label in pairs(toggles) do
            local value=key==&quot;large&quot; and (s.large and &quot;大&quot; or &quot;标准&quot;) or (s[key] and &quot;开&quot; or &quot;关&quot;)
            label.Text=({reduced=&quot;减少镜头运动&quot;,large=&quot;界面字号&quot;,guide=&quot;作战指导&quot;})[key]..&quot;  &quot;..value
        end
        Kit.fit(list,scale())
    end
        for index,row in ipairs({{&quot;master&quot;,&quot;主音量&quot;},{&quot;sfx&quot;,&quot;音效&quot;},{&quot;music&quot;,&quot;音乐&quot;}}) do
            local y=index*60
            local label=Kit.text(list,&quot;&quot;,.02,0,.57,0,16,C.Paper);label.Position=UDim2.new(.02,0,0,y);label.Size=UDim2.new(.57,0,0,44);labels[row[1]]=label
            for _,step in ipairs({{-1,&quot;−&quot;,.62,&quot;Down&quot;},{1,&quot;+&quot;,.81,&quot;Up&quot;}}) do
                local b=Kit.button(list,step[2],step[3],0,.17,0,function() change(row[1],math.clamp(math.floor(get()[row[1]]*100+.5)+step[1]*10,0,100)/100);draw() end)
                b.Position=UDim2.new(step[3],0,0,y);b.Size=UDim2.new(.17,0,0,44);b.Name=row[1]..step[4];b:SetAttribute(&quot;ControlId&quot;,&quot;Preference:&quot;..row[1]..&quot;:&quot;..step[4])
                for _,t in ipairs(b:GetChildren()) do
                    if t:IsA(&quot;UIPadding&quot;) then t.PaddingLeft=UDim.new(0,0);t.PaddingRight=UDim.new(0,0)
                    elseif t:IsA(&quot;TextLabel&quot;) then
                        if t.Text==&quot;›&quot; then t.Visible=false else t.Position=UDim2.fromOffset(0,0);t.Size=UDim2.fromScale(1,1);t.TextXAlignment=Enum.TextXAlignment.Center end
                    end
                end
            end
        end
        for index,row in ipairs({{&quot;reduced&quot;,&quot;减少镜头运动&quot;},{&quot;large&quot;,&quot;界面字号&quot;},{&quot;guide&quot;,&quot;作战指导&quot;}}) do
            local b=Kit.button(list,&quot;&quot;,0,0,1,0,function() change(row[1],not get()[row[1]]);draw() end)
            b.Position=UDim2.fromOffset(0,240+(index-1)*60);b.Size=UDim2.new(1,-7,0,44);b.Name=row[1];b:SetAttribute(&quot;ControlId&quot;,&quot;Preference:&quot;..row[1])
            for _,t in ipairs(b:GetChildren()) do if t:IsA(&quot;TextLabel&quot;) and t.Text~=&quot;›&quot; then toggles[row[1]]=t end end
        end
    local languageButton=Kit.button(list,&quot;&quot;,0,0,1,0,function()change(&quot;language&quot;,Locale.cycle());draw()end)
    languageButton.Name=&quot;language&quot;;languageButton:SetAttribute(&quot;ControlId&quot;,&quot;Preference:language&quot;)
    languageButton.Position=UDim2.fromOffset(0,0);languageButton.Size=UDim2.new(1,-7,0,44)
    languageCaption=languageButton.ButtonCaption
    draw();return list
end
return Preferences
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX715"><Properties><string name="Name">SessionMenu</string><ProtectedString name="Source">local Kit=require(script.Parent.InterfaceKit)
local Preferences=require(script.Parent.PreferencesView)
local Audio=require(script.Parent.AudioController)
local GuiService=game:GetService(&quot;GuiService&quot;)
local C=require(script.Parent.PresentationConfig).Colors
local Menu={};local layer,context,focusId,layout;local coveredControls={}
function Menu.active() return layer~=nil end
function Menu.reflow() if layer and layout then layout() end end
local function dismiss()
    local selected=GuiService.SelectedObject
    if selected and selected:IsDescendantOf(layer) then GuiService.SelectedObject=nil end
    layer:Destroy();layer=nil;layout=nil
    for button,selectable in pairs(coveredControls) do if button.Parent then button.Selectable=selectable end end
    coveredControls={}
end
function Menu.close(refresh)
    if not layer then return end
    dismiss()
    if refresh~=false and context and context.resume then context.resume() end
    if focusId and context and context.root then for _,b in ipairs(context.root:GetDescendants()) do if b:IsA(&quot;TextButton&quot;) and b.Selectable and b:GetAttribute(&quot;ControlId&quot;)==focusId then GuiService.SelectedObject=b;break end end end
end
function Menu.open(c)
    if layer then Menu.close();return end
    context=c;local selected=GuiService.SelectedObject;focusId=selected and selected:GetAttribute(&quot;ControlId&quot;)
    for _,button in ipairs(c.root:GetDescendants()) do if button:IsA(&quot;TextButton&quot;) then coveredControls[button]=button.Selectable;button.Selectable=false end end
    layer=Kit.make(&quot;Frame&quot;,{Name=&quot;SessionMenu&quot;,Size=c.root.Size,Position=c.root.Position,BackgroundColor3=C.Ink,BackgroundTransparency=.12,BorderSizePixel=0,Active=true,ZIndex=50},c.root.Parent)
    -- A modal catches pointer input while the live match keeps receiving updates.
    local backdrop=Kit.make(&quot;TextButton&quot;,{Name=&quot;Backdrop&quot;,Text=&quot;&quot;,AutoButtonColor=false,BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Modal=true,Selectable=false,ZIndex=50},layer)
    local p=Kit.panel(layer,.5,.5,.92,.88,0,true);p.Name=&quot;MenuPanel&quot;;p.AnchorPoint=Vector2.new(.5,.5);p.ZIndex=51
    local function draw(confirm)
        p:ClearAllChildren()
        local eyebrow=Kit.text(p,&quot;SESSION CONTROL&quot;,0,0,1,0,12,C.Cyan);eyebrow.Name=&quot;Eyebrow&quot;
        local title=Kit.text(p,confirm and &quot;退出这场行动？&quot; or &quot;局内设置&quot;,0,0,1,0,28,C.Paper,Enum.Font.GothamBold);title.Name=&quot;Heading&quot;
        local note=confirm and &quot;未结束的行动不会计入战绩。双人对峙中，对手也会收到取消提示。&quot; or &quot;对局仍在进行。返回后显示最新状态。&quot;
        local description=Kit.text(p,note,0,0,1,0,14,C.Muted);description.Name=&quot;Description&quot;;description.TextYAlignment=Enum.TextYAlignment.Top
        local holder,hint
        if not confirm then
            holder=Kit.make(&quot;Frame&quot;,{Name=&quot;SettingsArea&quot;,BackgroundTransparency=1},p)
            Preferences.render(holder,c.getPreferences,function(key,value) c.changePreference(key,value);Kit.fit(p,c.scale()) end,c.scale)
        else hint=Kit.text(p,&quot;你可以先返回对局，继续完成当前行动。&quot;,0,0,1,0,17,C.Paper);hint.Name=&quot;ConfirmationHint&quot;;hint.TextYAlignment=Enum.TextYAlignment.Top end
        local divider=Kit.make(&quot;Frame&quot;,{Name=&quot;ColumnDivider&quot;,BackgroundColor3=C.Line,BorderSizePixel=0},p)
        local resume=Kit.button(p,confirm and &quot;继续对局&quot; or &quot;返回对局&quot;,0,0,1,0,Menu.close,true);resume.Name=&quot;Resume&quot;;resume:SetAttribute(&quot;ControlId&quot;,&quot;SessionResume&quot;)
        local exit=Kit.button(p,confirm and &quot;确认退出&quot; or &quot;退出行动&quot;,0,0,1,0,function() if confirm then dismiss();c.quit() else draw(true) end end)
        exit.Name=confirm and &quot;ConfirmQuit&quot; or &quot;Quit&quot;;exit:SetAttribute(&quot;ControlId&quot;,confirm and &quot;SessionConfirmQuit&quot; or &quot;SessionQuit&quot;)
        layout=function()
            layer.Size=c.root.Size;layer.Position=c.root.Position
            local size=c.root.AbsoluteSize
            local wide=size.Y&lt;540 and size.X&gt;=640 and size.X&gt;size.Y
            local w=math.min(size.X*.92,wide and 760 or 550);local h=math.min(size.Y*.88,640)
            p.Size=UDim2.fromOffset(w,h);p:SetAttribute(&quot;LandscapeColumns&quot;,wide)
            local margin=wide and 20 or 18;local contentWidth=wide and w*.42-margin or w-margin*2
            eyebrow.Position=UDim2.fromOffset(margin,16);eyebrow.Size=UDim2.fromOffset(contentWidth,24)
            title.Position=UDim2.fromOffset(margin,44);title.Size=UDim2.fromOffset(contentWidth,44)
            description.Position=UDim2.fromOffset(margin,96);description.Size=UDim2.fromOffset(contentWidth,wide and (confirm and h-112 or h-212) or 52)
            divider.Visible=wide;divider.Position=UDim2.fromOffset(w*.44,18);divider.Size=UDim2.fromOffset(1,h-36)
            local actionX=wide and (confirm and w*.48 or margin) or margin
            local actionWidth=wide and (confirm and w*.52-margin or contentWidth) or contentWidth
            resume.Position=UDim2.fromOffset(actionX,h-108);resume.Size=UDim2.fromOffset(actionWidth,44)
            exit.Position=UDim2.fromOffset(actionX,h-56);exit.Size=UDim2.fromOffset(actionWidth,44)
            if holder then
                holder.Position=UDim2.fromOffset(wide and w*.48 or margin,wide and 18 or 156)
                holder.Size=UDim2.fromOffset(wide and w*.52-margin or contentWidth,wide and h-36 or h-280)
            end
            if hint then
                hint.Position=UDim2.fromOffset(wide and w*.48 or margin,wide and 24 or 160)
                hint.Size=UDim2.fromOffset(wide and w*.52-margin or contentWidth,wide and h-148 or h-280)
            end
            Kit.fit(p,c.scale())
        end
        layout();GuiService.SelectedObject=resume
    end
    draw(false);Audio.Play(&quot;select&quot;)
end
return Menu
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX716"><Properties><string name="Name">ResponsiveLayout</string><ProtectedString name="Source">local Layout={}
local C=require(script.Parent.PresentationConfig).Colors
local function place(obj,x,y,w,h) if obj then obj.Position=UDim2.fromScale(x,y);obj.Size=UDim2.fromScale(w,h) end end
local function scrollBody(panel)
    if not panel or panel:FindFirstChild(&quot;PanelBody&quot;) then return end
    local labels={};local kicker,title,divider
    for _,child in ipairs(panel:GetChildren()) do
        if child:IsA(&quot;TextLabel&quot;) then
            if child.Position.Y.Scale&gt;=.33 then table.insert(labels,child)
            elseif child.Position.Y.Scale&gt;=.10 then title=child else kicker=child end
        elseif child:IsA(&quot;Frame&quot;) and math.abs(child.Position.Y.Scale-.30)&lt;.001 then divider=child
        elseif child:IsA(&quot;Frame&quot;) and child.Position.Y.Scale&gt;=.33 then child:Destroy() end
    end
    local list=Instance.new(&quot;ScrollingFrame&quot;);list.Name=&quot;PanelBody&quot;;list.BackgroundTransparency=1;list.BorderSizePixel=0;list.ScrollBarThickness=3;list.ScrollBarImageColor3=C.Cyan;list.Parent=panel
    for _,label in ipairs(labels) do label.Parent=list;label.TextYAlignment=Enum.TextYAlignment.Top end
    local function measure()
        local width=math.max(panel.AbsoluteSize.X*.86-8,1)
        local service=game:GetService(&quot;TextService&quot;)
        local titleHeight=title and math.max(36,math.ceil(service:GetTextSize(title.ContentText,title.TextSize,title.Font,Vector2.new(width,100000)).Y)+4) or 36
        local top=44+titleHeight+16
        if kicker then kicker.Position=UDim2.new(.07,0,0,10);kicker.Size=UDim2.new(.86,0,0,24) end
        if title then title.Position=UDim2.new(.07,0,0,40);title.Size=UDim2.new(.86,0,0,titleHeight) end
        if divider then divider.Position=UDim2.new(.07,0,0,top-8) end
        list.Position=UDim2.new(.07,0,0,top);list.Size=UDim2.new(.86,0,1,-top-64)
        local y=0
        for _,label in ipairs(labels) do
            local height=math.ceil(service:GetTextSize(label.ContentText,label.TextSize,label.Font,Vector2.new(width,100000)).Y)+4
            label.Position=UDim2.fromOffset(0,y);label.Size=UDim2.new(1,-8,0,height);y+=height+12
        end
        list.CanvasSize=UDim2.fromOffset(0,y)
    end
    panel:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(measure)
    for _,label in ipairs(labels) do label:GetPropertyChangedSignal(&quot;TextSize&quot;):Connect(measure) end
    if title then title:GetPropertyChangedSignal(&quot;TextSize&quot;):Connect(measure) end
    task.defer(measure)
end
function Layout.apply(root,screen)
    if screen==&quot;Menu&quot; or screen==&quot;Character&quot; or screen==&quot;Setup&quot; then return end -- These screens measure their own layout.
    local landscape=root.AbsoluteSize.X&lt;900 and root.AbsoluteSize.Y&lt;540 and root.AbsoluteSize.X&gt;root.AbsoluteSize.Y
    if root.AbsoluteSize.X&gt;=760 and not landscape then return end
    local panels={};for _,p in ipairs(root:GetChildren()) do if p:IsA(&quot;CanvasGroup&quot;) then table.insert(panels,p) end end
    local first,second=panels[1],panels[2]
    if screen==&quot;Title&quot; then place(first,.035,.15,.93,.70)
    elseif screen==&quot;Menu&quot; then
        place(first,.035,.10,.57,.80);place(second,.64,.16,.33,.40)
        place(root:FindFirstChild(&quot;CREDITS&quot;),.64,.79,.33,.065)
        for _,t in ipairs(root:GetChildren()) do if t:IsA(&quot;TextLabel&quot;)then local source=t:GetAttribute(&quot;LocaleSource&quot;)or t.Text;if source==&quot;AXIOM CORE&quot;or source==&quot;争夺先攻  /  隐藏意图  /  读取反制&quot;then t.Visible=false end end end
    elseif screen==&quot;Briefing&quot; then
        place(first,.035,.11,landscape and .60 or .93,landscape and .79 or .68);scrollBody(first)
        for _,b in ipairs(root:GetChildren()) do if b:IsA(&quot;TextButton&quot;) then if b.Name==&quot;开始行动&quot; then place(b,landscape and .67 or .51,landscape and .74 or .82,landscape and .295 or .455,.075) else place(b,landscape and .67 or .035,landscape and .53 or .82,landscape and .295 or .45,.075) end end end
    elseif screen==&quot;Record&quot; then
        place(first,.035,.10,landscape and .46 or .93,landscape and .80 or .42);place(second,landscape and .525 or .035,landscape and .10 or .55,landscape and .44 or .93,landscape and .80 or .35);scrollBody(first)
    elseif screen==&quot;Archive&quot; then
        place(first,.035,.10,landscape and .46 or .93,landscape and .80 or .43);place(second,landscape and .525 or .035,landscape and .10 or .56,landscape and .44 or .93,landscape and .80 or .34);scrollBody(first)
    elseif screen==&quot;Settings&quot; or screen==&quot;Credits&quot; or screen==&quot;Abandoned&quot; or screen==&quot;Connecting&quot; or screen==&quot;Waiting&quot; then place(first,.035,.12,.93,.77) end
end
return Layout
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX717"><Properties><string name="Name">ResolutionEffects</string><ProtectedString name="Source">-- Original, bounded spatial feedback. Only already-revealed events may enter here.
local TweenService=game:GetService(&quot;TweenService&quot;)
local Debris=game:GetService(&quot;Debris&quot;)
local Config=require(script.Parent.PresentationConfig)
local C,F=Config.Colors,Config.TableFeedback
local Effects={}
local supported={Damage=true,Heal=true,Execute=true,LinkTrigger=true,Death=true,Block=true,Lock=true,Skill=true}
function Effects.new(parent)
    local folder=Instance.new(&quot;Folder&quot;);folder.Name=&quot;LocalResolutionEffects&quot;;folder.Parent=parent
    local self={Folder=folder,Counts={},PeakParts=0}
    local active={}
    local function part(kind,color,size,cf,alpha,lifetime)
        local children=folder:GetChildren()
        if #children&gt;=F.MaximumParts then children[1]:Destroy() end
        local p=Instance.new(&quot;Part&quot;)
        p.Name=&quot;Revealed&quot;..kind;p:SetAttribute(&quot;EventKind&quot;,kind)
        p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false
        p.Material=Enum.Material.Neon;p.Color=color;p.Transparency=alpha;p.Size=size;p.CFrame=cf;p.Parent=folder
        active[p]={}
        p.Destroying:Connect(function() for _,t in ipairs(active[p] or {}) do t:Cancel() end;active[p]=nil end)
        Debris:AddItem(p,lifetime+F.Tail)
        self.PeakParts=math.max(self.PeakParts,#folder:GetChildren())
        return p
    end
    local function animate(p,time,goal,reduced)
        if reduced then return end
        local t=TweenService:Create(p,TweenInfo.new(time,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),goal)
        table.insert(active[p],t);t:Play()
    end
    local function segment(kind,a,b,color,time,reduced,alpha)
        local length=(b-a).Magnitude;if length&lt;.01 then return end
        local p=part(kind,color,Vector3.new(F.LineWidth,F.LineWidth,length),CFrame.lookAt((a+b)/2,b),alpha or .45,time)
        animate(p,time,{Transparency=1},reduced);return p
    end
    local function ring(kind,position,color,time,reduced,lift,radius,expand,segments)
        local center=Vector3.new(position.X,F.SurfaceY,position.Z)
        local steps=reduced and 4 or segments or F.Segments
        radius=radius or F.Radius
        for i=0,steps-1 do
            local a,b=i*2*math.pi/steps,(i+.78)*2*math.pi/steps
            local p=segment(kind,center+Vector3.new(math.cos(a)*radius,0,math.sin(a)*radius),center+Vector3.new(math.cos(b)*radius,0,math.sin(b)*radius),color,time,reduced)
            if p and not reduced then
                local nextRadius=expand or radius
                local offset=(p.Position-center)*(nextRadius/radius)
                animate(p,time,{CFrame=CFrame.new(center+offset+Vector3.new(0,lift or 0,0))*p.CFrame.Rotation,Size=Vector3.new(F.LineWidth,F.LineWidth,p.Size.Z*nextRadius/radius),Transparency=1},false)
            end
        end
    end
    local function brackets(kind,position,color,time,reduced,close)
        for _,axis in ipairs({Vector3.new(1,0,0),Vector3.new(-1,0,0),Vector3.new(0,0,1),Vector3.new(0,0,-1)}) do
            local center=Vector3.new(position.X,F.SurfaceY,position.Z)
            local a=center+axis*F.Radius;local b=center+axis*(F.Radius+.16)
            local p=segment(kind,a,b,color,time,reduced,.28)
            if p and not reduced then animate(p,time,{CFrame=p.CFrame+axis*(close and -F.Radius*.75 or F.Radius*.6),Transparency=1},false) end
        end
    end
    local function travel(event,source,target,color,time,reduced,broken)
        if not source or source==target then return end
        local a,b=source.Position,target.Position
        if broken then
            for i=0,4 do segment(event.kind,a:Lerp(b,i/5),a:Lerp(b,(i+.6)/5),color,time,reduced,.55) end
        else segment(event.kind,a,b,color,time,reduced,.62) end
        if reduced then return end
        local p=part(event.kind,color,Vector3.new(.10,.10,.10),CFrame.new(a),.22,time)
        p.Shape=Enum.PartType.Ball
        animate(p,time,{CFrame=CFrame.new(b)},false)
        animate(p,time,{Transparency=1},false)
    end
    local function shards(kind,position,color,time,reduced,count)
        if reduced then return end
        for i=1,count or F.ShardCount do
            local angle=i*math.pi*2/(count or F.ShardCount)
            local axis=Vector3.new(math.cos(angle),0,math.sin(angle))
            local p=part(kind,color,Vector3.new(.035,.16,.035),CFrame.new(position+axis*.12),.23,time)
            animate(p,time,{CFrame=CFrame.new(position+axis*F.ShardTravel+Vector3.new(0,F.ShardHeight*(i%2==0 and 1 or .5),0))*CFrame.Angles(0,angle,math.pi*.35),Size=Vector3.new(.02,.05,.02),Transparency=1},false)
        end
    end
    local skills={group_heal=true,stasis_lock=true,thunder_judgment=true,rail_shot=true,fury_press=true,final_barrage=true,overload_explode=true}
    local function cast(event,source,time,reduced)
        if not source or not skills[event.code] then return false end
        local center=source.Position
        local code=event.code
        local color=code==&quot;group_heal&quot; and C.Cyan or code==&quot;stasis_lock&quot; and F.LinkColor or C.Amber
        if reduced then ring(&quot;Skill&quot;,center,color,time,true);return true end
        if code==&quot;group_heal&quot; then
            ring(&quot;Skill&quot;,center,C.Cyan,time,false,.6,F.SkillRadius,F.SkillRadius*1.4)
            ring(&quot;Skill&quot;,center+Vector3.new(0,.25,0),C.Paper,time,false,.35,F.SkillRadius*.6,F.SkillRadius)
            for i=0,2 do
                local angle=i*math.pi*2/3
                local p=part(&quot;Skill&quot;,C.Cyan,Vector3.new(.045,.36,.045),CFrame.new(center+Vector3.new(math.cos(angle)*.4,-.2,math.sin(angle)*.4)),.3,time)
                animate(p,time,{CFrame=p.CFrame+Vector3.new(0,.9,0),Size=Vector3.new(.02,.12,.02),Transparency=1},false)
            end
        elseif code==&quot;rail_shot&quot; or code==&quot;fury_press&quot; then
            for _,side in ipairs({-1,1}) do
                local p=part(&quot;Skill&quot;,color,Vector3.new(code==&quot;fury_press&quot; and .18 or .055,.65,.055),CFrame.new(center+Vector3.new(side*.3,.1,0)),.25,time)
                animate(p,time,{CFrame=p.CFrame+Vector3.new(side*.14,.6,0),Size=Vector3.new(.035,1.1,.035),Transparency=1},false)
            end
            brackets(&quot;Skill&quot;,center,color,time,false,true)
        elseif code==&quot;stasis_lock&quot; then
          for i=0,3 do
                local angle=i*math.pi/2
                local p=part(&quot;Skill&quot;,F.LinkColor,Vector3.new(.045,.55,.045),CFrame.new(center+Vector3.new(math.cos(angle)*.55,0,math.sin(angle)*.55)),.23,time)
                animate(p,time,{CFrame=CFrame.new(center+Vector3.new(math.cos(angle)*.25,.2,math.sin(angle)*.25)),Transparency=1},false)
            end
        elseif code==&quot;thunder_judgment&quot; then
            for i=0,2 do
                local a,b=i*math.pi*2/3,(i+1)*math.pi*2/3
                local p=segment(&quot;Skill&quot;,center+Vector3.new(math.cos(a)*F.SkillRadius,.35,math.sin(a)*F.SkillRadius),center+Vector3.new(math.cos(b)*F.SkillRadius,.35,math.sin(b)*F.SkillRadius),C.Paper,time,false,.20)
                animate(p,time,{CFrame=p.CFrame+Vector3.new(0,.6,0),Transparency=1},false)
            end
        else
            ring(&quot;Skill&quot;,center,color,time,false,.15,F.SkillRadius,code==&quot;final_barrage&quot; and 1.5 or 1.1)
            shards(&quot;Skill&quot;,center,color,time,false,code==&quot;final_barrage&quot; and 6 or 4)
        end
        return true
    end
    function self.approach(event,source,target,hold,reduced)
        if source and target then travel(event,source,target,C.Amber,hold,reduced) end
    end
    function self.present(event,source,target,hold,reduced)
        if not supported[event.kind] then return false end
        local time=reduced and F.ReducedTime or math.clamp(hold or .3,F.MinimumTime,F.MaximumTime)
        if event.kind==&quot;Skill&quot; then
            local emitted=cast(event,source,time,reduced)
            if emitted then self.Counts.Skill=(self.Counts.Skill or 0)+1 end
            return emitted
        end
        if not target then return false end
        self.Counts[event.kind]=(self.Counts[event.kind] or 0)+1
        local kind=event.kind
        if kind==&quot;Damage&quot; then
            local color=event.damageType==&quot;Reflection&quot; and C.Paper or event.damageType==&quot;Bleeding&quot; and F.BleedColor or C.Amber
            if event.damageType~=&quot;Bleeding&quot; and not event.approached then travel(event,source,target,color,time,reduced) end
            brackets(kind,target.Position,color,time,reduced,false)
            if event.impactTier and event.impactTier&gt;=2 then
                ring(kind,target.Position,C.Amber,time,reduced,0,F.Radius,Config.HitFeedback.Radii[event.impactTier])
                shards(kind,target.Position,C.Paper,time,reduced,event.impactTier==3 and 6 or 3)
            end
            if event.damageType==&quot;DeathRattle&quot; then
                ring(kind,target.Position,C.Paper,time,reduced,0,F.Radius,F.ShockRadius)
                shards(kind,target.Position,C.Amber,time,reduced)
            elseif event.skillCode==&quot;fury_press&quot; then
                ring(kind,target.Position,C.Amber,time,reduced,0,F.Radius,F.ShockRadius)
                shards(kind,target.Position,C.Amber,time,reduced,4)
            elseif event.skillCode==&quot;rail_shot&quot; and source and not reduced then
                for _,side in ipairs({-1,1}) do segment(kind,source.Position+Vector3.new(side*.09,0,0),target.Position+Vector3.new(side*.09,0,0),C.Paper,time,false,.35) end
            elseif event.damageType==&quot;Reflection&quot; then ring(kind,target.Position,C.Paper,time,reduced,.15) end
        elseif kind==&quot;Heal&quot; then
            travel(event,source,target,C.Cyan,time,reduced)
            ring(kind,target.Position,C.Cyan,time,reduced,.3)
        elseif kind==&quot;Execute&quot; then
            if not event.approached then travel(event,source,target,C.Amber,time,reduced) end
            brackets(kind,target.Position,C.Paper,time,reduced,true)
            if not reduced then
                for _,angle in ipairs({25,-55}) do
                    local cut=part(kind,C.Paper,Vector3.new(.06,1.65,.04),target.CFrame*CFrame.Angles(0,0,math.rad(angle)),.18,time)
                    animate(cut,time,{Size=Vector3.new(.015,2.15,.02),CFrame=cut.CFrame+Vector3.new(0,-.18,0),Transparency=1},false)
                end
                ring(kind,target.Position,C.Amber,time,false,0,F.Radius,F.ShockRadius)
            end
        elseif kind==&quot;LinkTrigger&quot; then
            travel(event,source,target,F.LinkColor,time,reduced,true)
            brackets(kind,target.Position,F.LinkColor,time,reduced,true)
        elseif kind==&quot;Death&quot; then
            if reduced then brackets(kind,target.Position,C.Muted,time,true,true)
            else
                for i=-1,1 do
                    local p=part(kind,C.Muted,Vector3.new(.045,target.Size.Y*.65,.045),target.CFrame+Vector3.new(i*.15,0,0),.55,time)
                    animate(p,time,{Size=Vector3.new(.045,.05,.045),CFrame=CFrame.new(target.Position+Vector3.new(i*.20,-.3,0)),Transparency=1},false)
                end
                ring(kind,target.Position,event.owner==&quot;B&quot; and C.Amber or C.Cyan,time,false,0,F.Radius,F.ShockRadius)
                shards(kind,target.Position,event.owner==&quot;B&quot; and C.Amber or C.Cyan,time,false)
            end
        elseif kind==&quot;Block&quot; then
            if reduced then ring(kind,target.Position,C.Cyan,time,true)
            else
                local direction=source and (source.Position-target.Position)*Vector3.new(1,0,1) or Vector3.new(0,0,-1)
                direction=direction.Magnitude&gt;.01 and direction.Unit or Vector3.new(0,0,-1)
                local face=CFrame.lookAt(target.Position+direction*.2,target.Position+direction)
                local shield={{-.5,.20},{-.36,.60},{.36,.60},{.5,.20},{.30,-.50},{-.30,-.50}}
                for i,a in ipairs(shield) do
                    local b=shield[i%#shield+1]
                    local p=segment(kind,face:PointToWorldSpace(Vector3.new(a[1],a[2],0)),face:PointToWorldSpace(Vector3.new(b[1],b[2],0)),C.Cyan,time,false,.20)
                    if p then animate(p,time,{CFrame=p.CFrame+direction*.22,Transparency=1},false) end
                end
                local p=part(kind,C.Cyan,Vector3.new(.84,.94,.025),face,.90,time)
                animate(p,time,{CFrame=p.CFrame+direction*.22,Transparency=1},false)
            end
        elseif kind==&quot;Lock&quot; then brackets(kind,target.Position,C.Amber,time,reduced,true) end
        return true
    end
    function self.outcome(winner,hold,reduced)
        local time=reduced and F.ReducedTime or math.clamp(hold,F.MinimumTime,F.MaximumTime)
        local color=winner==&quot;A&quot; and C.Cyan or winner==&quot;B&quot; and C.Muted or C.Amber
        self.Counts.Outcome=(self.Counts.Outcome or 0)+1
        ring(&quot;Outcome&quot;,Vector3.new(0,F.SurfaceY,0),color,time,reduced,.25,1.2,F.OutcomeRadius,F.OutcomeSegments)
        if not reduced then
            local center=Vector3.new(0,5.1,winner==&quot;A&quot; and -2.4 or 2.4)
            local core=part(&quot;Outcome&quot;,color,Vector3.new(.9,.9,.9),CFrame.new(center)*CFrame.Angles(0,math.pi/4,math.pi/4),.15,time)
            animate(core,time*.35,{Size=Vector3.new(.08,.08,.08),Transparency=1},false)
            for i=0,11 do
                  local angle=i*math.pi/6
                  local center=Vector3.new(0,5.1,winner==&quot;A&quot; and -2.4 or 2.4)
                  local p=part(&quot;Outcome&quot;,color,Vector3.new(.18,.7,.22),CFrame.new(center)*CFrame.Angles(angle,angle,angle),.12,time)
                  animate(p,time,{CFrame=CFrame.new(center+Vector3.new(math.cos(angle)*3.2,winner==&quot;A&quot; and 1.5 or -1.1,math.sin(angle)*2.2))*CFrame.Angles(angle*3,angle*2,angle),Transparency=1},false)
            end
        end
    end
    function self.reset()
        for _,p in ipairs(folder:GetChildren()) do p:Destroy() end
    end
    return self
end
return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX718"><Properties><string name="Name">MusicSources</string><ProtectedString name="Source">-- Audio-only APMOfficial Creator Store tracks. Roblox licensed music, not CC BY.
-- Used only inside the Roblox experience; no downloaded audio is bundled.
return {
    Deployment={id=&quot;rbxassetid://1843828305&quot;,name=&quot;Low Drone 2&quot;,creator=&quot;APMOfficial&quot;,url=&quot;https://create.roblox.com/store/asset/1843828305&quot;,license=&quot;Roblox Licensed Music / APM&quot;},
    Battle={id=&quot;rbxassetid://9040092810&quot;,name=&quot;Grey Shores main&quot;,creator=&quot;APMOfficial&quot;,url=&quot;https://create.roblox.com/store/asset/9040092810&quot;,license=&quot;Roblox Licensed Music / APM&quot;},
    Endgame={id=&quot;rbxassetid://1837463124&quot;,name=&quot;Tension Bed for One&quot;,creator=&quot;APMOfficial&quot;,url=&quot;https://create.roblox.com/store/asset/1837463124&quot;,license=&quot;Roblox Licensed Music / APM&quot;},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX719"><Properties><string name="Name">MusicController</string><ProtectedString name="Source">-- Three public-state music beds, crossfaded rather than mismatched stems layered.
local SoundService=game:GetService(&quot;SoundService&quot;)
local ContentProvider=game:GetService(&quot;ContentProvider&quot;)
local RunService=game:GetService(&quot;RunService&quot;)
local Config=require(script.Parent.PresentationConfig).Music
local Music={Master=.65,Level=Config.DefaultLevel,State=&quot;Deployment&quot;,Status=&quot;Loading&quot;,Loaded={}}
local folder=Instance.new(&quot;Folder&quot;);folder.Name=&quot;FirstMoveMusic&quot;;folder.Parent=SoundService
local voices={};local duckUntil=0;local gain=1;local sessionId;local endgame=false
local order={&quot;Deployment&quot;,&quot;Battle&quot;,&quot;Endgame&quot;}
function Music.stateFor(view,latched)
    if view.mode==&quot;Training&quot; or view.phase==&quot;Draft&quot; or view.phase==&quot;LinkSetup&quot; then return &quot;Deployment&quot;,false end
    if view.phase==&quot;GameOver&quot; then return nil,latched end
    local counts={A=0,B=0}
    for side,list in pairs(view.rosters) do for _,h in ipairs(list) do if h.alive then counts[side]+=1 end end end
    local critical=latched or math.min(counts.A,counts.B)&lt;=Config.EndgameSide or counts.A+counts.B&lt;=Config.EndgameTotal
    return critical and &quot;Endgame&quot; or &quot;Battle&quot;,critical
end
local function chosen()
    if Music.Loaded[Music.State] then return Music.State end
    for _,key in ipairs(order) do if Music.Loaded[key] then return key end end
end
local function target(key)
    return chosen()==key and Config.Gains[key]*Music.Master*Music.Level*gain or 0
end
function Music.SetLevels(master,level)
    Music.Master=math.clamp(master,0,1);Music.Level=math.clamp(level,0,1)
    if Music.Master*Music.Level==0 then for _,v in pairs(voices) do v.sound.Volume=0;v.sound:Stop() end end
end
function Music.SetScreen(screen)
    if screen==&quot;Battle&quot; or screen==&quot;Training&quot; then return end
    Music.State=&quot;Deployment&quot;;gain=(screen==&quot;HistoryReport&quot; or screen==&quot;Record&quot;) and Config.ResultGain or 1
    sessionId=nil;endgame=false;duckUntil=0
end
function Music.Update(view)
    if sessionId~=view.sessionId then sessionId=view.sessionId;endgame=false end
    local nextState;nextState,endgame=Music.stateFor(view,endgame)
    if nextState then Music.State=nextState;gain=view.mode==&quot;Training&quot; and Config.TrainingGain or 1 end
end
function Music.Result()
    Music.State=&quot;Deployment&quot;;gain=Config.ResultGain
end
function Music.Duck(hold)
    duckUntil=math.max(duckUntil,os.clock()+hold)
end
function Music.Release() duckUntil=0 end
for _,key in ipairs(order) do
    local sound=Instance.new(&quot;Sound&quot;);sound.Name=key;sound.SoundId=Config.Sources[key].id
    sound.Volume=0;sound.Looped=true;sound.Parent=folder
    local eq=Instance.new(&quot;EqualizerSoundEffect&quot;);eq.LowGain=Config.EQ.Low;eq.MidGain=Config.EQ.Mid;eq.HighGain=Config.EQ.High;eq.Parent=sound
    voices[key]={sound=sound}
    sound.Loaded:Connect(function() Music.Loaded[key]=true;Music.Status=&quot;Ready&quot; end)
end
task.spawn(function()
    local list={};for _,key in ipairs(order) do table.insert(list,voices[key].sound) end
    pcall(function() ContentProvider:PreloadAsync(list) end)
    for key,v in pairs(voices) do Music.Loaded[key]=v.sound.IsLoaded end
    Music.Status=chosen() and &quot;Ready&quot; or &quot;Unavailable&quot;
end)
RunService.Heartbeat:Connect(function(dt)
    if not folder.Parent then return end
    local ducked=os.clock()&lt;duckUntil
    for key,v in pairs(voices) do
        local desired=target(key)*(ducked and Config.DuckGain or 1)
        v.target=desired
        if desired&gt;0 and not v.sound.IsPlaying then v.sound:Play() end
        local seconds=ducked and Config.DuckAttack or desired&gt;v.sound.Volume and Config.DuckRelease or Config.Crossfade
        v.sound.Volume+=(desired-v.sound.Volume)*(1-math.exp(-dt/seconds))
        if desired==0 and v.sound.Volume&lt;Config.StopThreshold then v.sound.Volume=0;if v.sound.IsPlaying then v.sound:Stop() end end
    end
end)
return Music
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX720"><Properties><string name="Name">ImpactPresentation</string><ProtectedString name="Source">-- HUD-only cinematic accents. The strategic table never carries names or numbers.
local TweenService=game:GetService(&quot;TweenService&quot;)
local Config=require(script.Parent.PresentationConfig)
local Identity=require(script.Parent.UnitIdentity)
local Portrait=require(script.Parent.UnitPortrait)
local Locale=require(script.Parent.LocaleController)
local C,I=Config.Colors,Config.Impact
local Impact={Counts={}}
local root,group,layer;local rootConnection;local tweens={};local serial=0
local function make(cls,props,parent)
    local o=Instance.new(cls);for key,value in pairs(props) do o[key]=value end;o.Parent=parent
    if o:IsA(&quot;TextLabel&quot;)then Locale.bind(o)end
    return o
end
local function animate(o,time,goal)
    local t=TweenService:Create(o,TweenInfo.new(time,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goal);table.insert(tweens,t);t:Play()
end
function Impact.reset()
    serial+=1;for _,t in ipairs(tweens) do t:Cancel() end;tweens={}
    if group then group:Destroy();group=nil end
    if root then local heading=root:FindFirstChild(&quot;OwnershipHeading&quot;);if heading then heading.Visible=true end end
end
function Impact.bind(value)
    Impact.reset()
    if rootConnection then rootConnection:Disconnect() end
    if layer then layer:Destroy() end
    root=value
    layer=make(&quot;Frame&quot;,{Name=&quot;CinematicLayer&quot;,BackgroundTransparency=1,Position=root.Position,Size=root.Size,AnchorPoint=root.AnchorPoint,ZIndex=40,Active=false},root.Parent)
    rootConnection=root.Destroying:Connect(function() Impact.reset();if layer then layer:Destroy();layer=nil end;root=nil end)
end
local function glyph(parent,id,color,size)
    local def=Identity.byId[id];if not def then return end
    local icon=make(&quot;Frame&quot;,{Name=&quot;UnitInsignia&quot;,BackgroundTransparency=1,Position=UDim2.fromOffset(14,17),Size=UDim2.fromOffset(size,size),ZIndex=42},parent)
    for _,path in ipairs(def.paths) do for i=1,#path-1 do
        local a,b=path[i],path[i+1];local dx,dy=(b[1]-a[1])*size,(b[2]-a[2])*size
        make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=color,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset((a[1]+b[1])*size/2,(a[2]+b[2])*size/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),2),Rotation=math.deg(math.atan2(dy,dx)),ZIndex=42},icon)
    end end
end
local function emblem(parent,winner,color)
    local icon=make(&quot;Frame&quot;,{Name=&quot;OutcomeEmblem&quot;,BackgroundTransparency=1,AnchorPoint=Vector2.new(.5,0),Position=UDim2.new(.5,0,0,I.EmblemTop),Size=UDim2.fromOffset(I.EmblemSize,I.EmblemSize),ZIndex=42},parent)
    icon:SetAttribute(&quot;Winner&quot;,winner or &quot;Draw&quot;)
    for _,path in ipairs(I.Emblems[winner] or I.Emblems.Draw) do for i=1,#path-1 do
        local a,b=path[i],path[i+1];local dx,dy=(b[1]-a[1])*I.EmblemSize,(b[2]-a[2])*I.EmblemSize
        make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=color,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset((a[1]+b[1])*I.EmblemSize/2,(a[2]+b[2])*I.EmblemSize/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),2),Rotation=math.deg(math.atan2(dy,dx)),ZIndex=42},icon)
    end end
end
local function show(title,detail,color,id,hold,reduced,outcome,winner)
    if not root or not root.Parent then return end
    Impact.reset();local ticket=serial
    layer.Position=root.Position;layer.Size=root.Size;layer.AnchorPoint=root.AnchorPoint
    local w,h=root.AbsoluteSize.X,root.AbsoluteSize.Y
    local compact=w&lt;900 or w/math.max(h,1)&lt;1.5
    local short=compact and h&lt;380 and not outcome
    local cinematic=id~=nil and not short and w&gt;=540 and h&gt;=380
    local width=short and math.floor(w*.5) or math.min(cinematic and I.PortraitWidth or outcome and 560 or I.Width,w*(compact and .90 or .66))
    if Locale.isEnglish()and not id and not outcome then
        local en=Locale.translate(title);title=({[&quot;命线击破&quot;]=&quot;LIFELINE KO&quot;,[&quot;双重击破&quot;]=&quot;DOUBLE KO&quot;,[&quot;三重击破&quot;]=&quot;TRIPLE KO&quot;,[&quot;连续击破&quot;]=&quot;CHAIN KO&quot;,[&quot;击破&quot;]=&quot;ELIMINATION&quot;,[&quot;阵亡&quot;]=&quot;UNIT LOST&quot;,[&quot;处决&quot;]=&quot;EXECUTION&quot;})[title]or en
    end
    local height=outcome and I.OutcomeHeight or short and I.CompactHeight or cinematic and I.PortraitHeight or I.Height
    local x=short and .035 or compact and .5 or .55
    local y=short and 26 or outcome and math.max(8,(h-height)*.42) or cinematic and math.max(16,(h-height)*.46) or h*.38
    group=make(&quot;CanvasGroup&quot;,{Name=&quot;ImpactPresentation&quot;,BorderSizePixel=0,BackgroundColor3=C.Ink,BackgroundTransparency=.06,GroupTransparency=reduced and 0 or 1,AnchorPoint=Vector2.new(short and 0 or .5,0),Position=UDim2.new(x,0,0,y),Size=UDim2.fromOffset(width,height),ZIndex=40,Active=false},layer)
    group:SetAttribute(&quot;PresentationKind&quot;,outcome and &quot;Outcome&quot; or id and &quot;Skill&quot; or &quot;Death&quot;)
    local scale=make(&quot;UIScale&quot;,{Scale=reduced and 1 or outcome and I.OutcomeScale or I.SkillScale},group)
    if not reduced then
        -- One directional ink streak; no repeating flash or full-screen whiteout.
        local sweep=make(&quot;Frame&quot;,{Name=&quot;InkSweep&quot;,BorderSizePixel=0,BackgroundColor3=color,BackgroundTransparency=.25,Rotation=-16,Position=UDim2.new(0,-30,0,0),Size=UDim2.new(0,6,1,0),ZIndex=41},group)
        animate(sweep,.42,{Position=UDim2.new(1,-12,0,0),BackgroundTransparency=1})
        if outcome then
            for i=1,12 do
                local a=i*math.pi/6
                local shard=make(&quot;Frame&quot;,{Name=&quot;OutcomeShard&quot;,AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=color,BorderSizePixel=0,BackgroundTransparency=.2,Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(3,18),Rotation=i*30,ZIndex=41},group)
                animate(shard,.85,{Position=UDim2.new(.5,math.cos(a)*width*.46,.5,math.sin(a)*height*.46),BackgroundTransparency=1,Rotation=i*30+65})
            end
        end
    end
    make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=color,Position=UDim2.fromOffset(0,0),Size=UDim2.new(1,0,0,3),ZIndex=41},group)
    local left=cinematic and math.floor(width*.43) or not short and id and 70 or 14
    if not short and id then
        local portrait=Portrait.render(group,id,UDim2.fromOffset(cinematic and 0 or 5,2),UDim2.fromOffset(cinematic and left-8 or 62,height-4),true,cinematic and &quot;Hero&quot; or &quot;Face&quot;)
        if portrait then portrait.ZIndex=42 else glyph(group,id,color,40) end
        if cinematic and portrait and not reduced then
            local destination=portrait.Position;portrait.Position=destination+UDim2.fromOffset(-24,0)
            animate(portrait,I.PortraitIn,{Position=destination})
        end
    end
    if outcome then emblem(group,winner,color) end
    if cinematic then
        local def=Identity.byId[id]
        make(&quot;TextLabel&quot;,{Name=&quot;CastIdentity&quot;,BackgroundTransparency=1,Position=UDim2.fromOffset(left,18),Size=UDim2.new(1,-left-14,0,28),Text=Locale.isEnglish()and def.english or def.name..&quot; / &quot;..def.english,TextSize=18,TextColor3=C.Muted,Font=Enum.Font.GothamMedium,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=42},group)
        make(&quot;Frame&quot;,{Name=&quot;CastUnderline&quot;,BackgroundColor3=color,BorderSizePixel=0,Position=UDim2.new(0,left,1,-34),Size=UDim2.new(1,-left-24,0,2),ZIndex=42},group)
    end
    local font=outcome and I.OutcomeSize or short and I.CompactSize or cinematic and 36 or I.TitleSize
    local titleLabel=make(&quot;TextLabel&quot;,{Name=&quot;ImpactTitle&quot;,BackgroundTransparency=1,Position=UDim2.fromOffset(left,short and 1 or outcome and I.OutcomeTitleTop or cinematic and 62 or 10),Size=UDim2.new(1,-left-14,0,short and height-2 or outcome and 52 or cinematic and 52 or 40),Text=title,TextSize=short and I.CompactSize or font,TextColor3=color,Font=Enum.Font.GothamBold,TextXAlignment=outcome and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,TextWrapped=false,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=42},group)
    if Locale.isEnglish()then
        local available=width-left-14
        while titleLabel.TextSize&gt;20 and game:GetService(&quot;TextService&quot;):GetTextSize(titleLabel.ContentText,titleLabel.TextSize,titleLabel.Font,Vector2.new(10000,10000)).X&gt;available do titleLabel.TextSize-=1 end
    end
    if not short then make(&quot;TextLabel&quot;,{Name=&quot;ImpactDetail&quot;,BackgroundTransparency=1,Position=UDim2.fromOffset(left,outcome and I.OutcomeDetailTop or cinematic and 130 or 49),Size=UDim2.new(1,-left-14,0,24),Text=detail,TextSize=I.MetaSize,TextColor3=C.Paper,Font=Enum.Font.GothamMedium,TextXAlignment=outcome and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,TextWrapped=false,TextTruncate=Enum.TextTruncate.AtEnd,ZIndex=42},group)
    else local heading=root:FindFirstChild(&quot;OwnershipHeading&quot;);if heading then heading.Visible=false end end
    if not reduced then animate(group,I.In,{GroupTransparency=0});animate(scale,I.In,{Scale=1}) end
    task.delay(math.max(I.In,hold-I.Out),function()
        if serial~=ticket or not group then return end
        if reduced then Impact.reset();return end
        animate(group,I.Out,{GroupTransparency=1})
        task.delay(I.Out,function() if serial==ticket then Impact.reset() end end)
    end)
end
function Impact.present(event,hold,reduced)
    if event.kind==&quot;Skill&quot; and Identity.byId[event.source] then
        local def=Identity.byId[event.source];Impact.Counts.Skill=(Impact.Counts.Skill or 0)+1
        local colors={survivor=C.Cyan,anomaly=Config.TableFeedback.LinkColor,wasteland=C.Amber}
        show(def.skill.name,def.name,colors[def.faction] or C.Paper,event.source,hold+Config.Resolution.ContactLead+I.Out,reduced)
        if group then group:SetAttribute(&quot;CastSource&quot;,event.source) end
    elseif event.kind==&quot;Death&quot; then
        Impact.Counts.Death=(Impact.Counts.Death or 0)+1
        local hostile=event.owner==&quot;B&quot;
        local title=event.cause==&quot;Execute&quot; and &quot;处决&quot; or event.cause==&quot;LinkTrigger&quot; and &quot;命线击破&quot; or hostile and &quot;击破&quot; or &quot;阵亡&quot;
        local detail=Identity.name(event.target)..(hostile and &quot; · 对手单位阵亡&quot; or &quot; · 己方单位阵亡&quot;)
        if hostile and (event.actionDeaths or 0)&gt;1 then
            Impact.Counts.Chain=(Impact.Counts.Chain or 0)+1
            title=event.actionDeaths==2 and &quot;双重击破&quot; or event.actionDeaths==3 and &quot;三重击破&quot; or &quot;连续击破&quot;
            detail=Identity.name(event.target)..&quot; · 本次行动第 &quot;..event.actionDeaths..&quot; 次击破&quot;
        end
        show(title,detail,hostile and C.Amber or C.Muted,nil,hold,reduced)
    elseif event.kind==&quot;Damage&quot; and event.damageType==&quot;DeathRattle&quot; then
        Impact.Counts.Rattle=(Impact.Counts.Rattle or 0)+1
        show(&quot;终响&quot;,Identity.name(event.source)..&quot; · 亡语触发&quot;,C.Paper,event.source,hold,reduced)
    elseif event.kind==&quot;LinkTrigger&quot; then
        show(&quot;命线纠缠&quot;,&quot;缚命 · 命线触发&quot;,Config.TableFeedback.LinkColor,&quot;ye_ban&quot;,hold,reduced)
    elseif event.kind==&quot;Damage&quot; then
        local id=event.damageType==&quot;Reflection&quot; and &quot;zhe_jing&quot; or event.damageType==&quot;Bleeding&quot; and &quot;xuan_bao&quot;
            or event.damageType==&quot;Normal&quot; and event.source==&quot;huan_shi&quot; and &quot;huan_shi&quot;
            or event.damageType==&quot;Normal&quot; and event.target==&quot;lan_dun&quot; and &quot;lan_dun&quot;
        if id then
            local def=Identity.byId[id]
            show(def.skill.name,def.name..&quot; · 被动触发&quot;,C.Paper,id,hold,reduced)
        end
    end
end
-- The cast illustration exits on the same contact that starts hit audio/HUD.
function Impact.contact(event,reduced)
    if not group or not group:GetAttribute(&quot;CastSource&quot;) then return end
    local ticket=serial
    if reduced then Impact.reset();return end
    animate(group,I.Out,{GroupTransparency=1})
    task.delay(I.Out,function()if serial==ticket then Impact.reset()end end)
end
function Impact.outcome(winner,round,hold,reduced)
    Impact.Counts.Outcome=(Impact.Counts.Outcome or 0)+1
    show(winner==&quot;A&quot; and &quot;胜利&quot; or winner==&quot;B&quot; and &quot;失利&quot; or &quot;同归于尽&quot;,&quot;第 &quot;..round..&quot; 回合 · 行动结束&quot;,winner==&quot;A&quot; and C.Cyan or winner==&quot;B&quot; and C.Muted or C.Amber,nil,hold,reduced,true,winner)
end
return Impact
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX721"><Properties><string name="Name">PortraitAssets</string><ProtectedString name="Source">-- Original dark comic roster. Actual Roblox upload IDs, 2026-10-05.
-- Source artwork and provenance: roblox/assets/characters/dark-comic-v1.
return {
    Version=2,
    Units={
        ting_sun={Image=&quot;rbxassetid://98157470953169&quot;,File=&quot;ting_sun-reaper.png&quot;,Width=1024,Height=1536,
            Face={340,160,420,420},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        lan_dun={Image=&quot;rbxassetid://108970753492222&quot;,File=&quot;lan_dun-warden.png&quot;,Width=1024,Height=1536,
            Face={300,170,430,430},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        ye_ban={Image=&quot;rbxassetid://136544226428354&quot;,File=&quot;ye_ban-tether.png&quot;,Width=1024,Height=1536,
            Face={330,140,430,430},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        yan_wei={Image=&quot;rbxassetid://139424940254931&quot;,File=&quot;yan_wei-echo.png&quot;,Width=1024,Height=1536,
            Face={360,140,460,460},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        bai_ji={Image=&quot;rbxassetid://84570693581610&quot;,File=&quot;bai_ji-mender.png&quot;,Width=1024,Height=1536,
            Face={350,140,430,430},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        shuang_xing={Image=&quot;rbxassetid://116067235321893&quot;,File=&quot;shuang_xing-twinrail.png&quot;,Width=1024,Height=1536,
            Face={360,130,440,440},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        chi_guang={Image=&quot;rbxassetid://130288780873233&quot;,File=&quot;chi_guang-lockout.png&quot;,Width=1024,Height=1536,
            Face={400,130,440,440},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        zhe_jing={Image=&quot;rbxassetid://91194843690661&quot;,File=&quot;zhe_jing-prism.png&quot;,Width=1024,Height=1536,
            Face={280,130,410,410},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        beng_yue={Image=&quot;rbxassetid://117871163326410&quot;,File=&quot;beng_yue-maul.png&quot;,Width=1024,Height=1536,
            Face={310,230,400,400},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        huan_shi={Image=&quot;rbxassetid://73597220162207&quot;,File=&quot;huan_shi-whisper.png&quot;,Width=1024,Height=1536,
            Face={430,135,370,370},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        zhui_lie={Image=&quot;rbxassetid://127768512588608&quot;,File=&quot;zhui_lie-outrider.png&quot;,Width=1024,Height=1536,
            Face={260,170,450,450},Full={0,0,1024,1536},Hero={120,130,850,1000}},
        xuan_bao={Image=&quot;rbxassetid://100324940425133&quot;,File=&quot;xuan_bao-corrode.png&quot;,Width=1024,Height=1536,
            Face={430,150,440,440},Full={0,0,1024,1536},Hero={120,130,850,1000}},
    },
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX722"><Properties><string name="Name">RankAssets</string><ProtectedString name="Source">-- Original generated steel rank insignia; provenance in assets/ui/ranks/manifest.json.
return {
    [1]=&quot;rbxassetid://97959890731458&quot;,
    [2]=&quot;rbxassetid://80840964795531&quot;,
    [3]=&quot;rbxassetid://75147892416459&quot;,
    [4]=&quot;rbxassetid://121699816303240&quot;,
    [5]=&quot;rbxassetid://97984525263288&quot;,
}

</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX723"><Properties><string name="Name">HubView</string><ProtectedString name="Source">local Kit=require(script.Parent.InterfaceKit)
local H={}
local careerPage=&quot;战绩&quot;
-- Layout is measured from the usable viewport. Transactions remain server owned.
function H.render(ctx,kind)
    local root,C,P=ctx.root,ctx.colors,ctx.progression
    local make,text,button=Kit.make,Kit.text,Kit.button
    local W,Hh=root.AbsoluteSize.X,root.AbsoluteSize.Y
    local narrow=W&lt;620;local compact=Hh&lt;540
    local e,stats=ctx.economy(),ctx.stats()
    local owned=e.owned or {}
    local p=make(&quot;Frame&quot;,{Name=&quot;PlayerHub&quot;,BorderSizePixel=0,BackgroundColor3=Color3.fromRGB(10,18,24),BackgroundTransparency=.055,
        Position=UDim2.fromScale(.035,.06),Size=UDim2.fromScale(.93,.88)},root)
    make(&quot;UIGradient&quot;,{Rotation=30,Color=ColorSequence.new(Color3.fromRGB(210,228,239),Color3.fromRGB(118,139,160))},p)
    local pw,ph=W*.93,Hh*.88
    local pad=narrow and 12 or 24
    local function label(parent,value,x,y,w,h,size,color,bold)
        local t=text(parent,value,0,0,0,0,size or 18,color or C.Paper,bold and Enum.Font.GothamBold or Enum.Font.GothamMedium)
        t.Position=UDim2.fromOffset(x,y);t.Size=UDim2.fromOffset(w,h);return t
    end
    local function rect(parent,name,x,y,w,h,color,alpha)
        return make(&quot;Frame&quot;,{Name=name,BorderSizePixel=0,BackgroundColor3=color or C.Panel,BackgroundTransparency=alpha or 0,
            Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(w,h)},parent)
    end
    local function rule(parent,x,y,w,color,alpha) return rect(parent,&quot;FineRule&quot;,x,y,w,1,color or C.Line,alpha or .35) end
    local function skin(b,primary,tint)
        b.BackgroundColor3=primary and Color3.fromRGB(42,76,86)or Color3.fromRGB(22,33,43)
        b:SetAttribute(&quot;RestColor&quot;,b.BackgroundColor3);b.BackgroundTransparency=primary and .04 or .28
        b.ButtonEdge.Transparency=primary and .42 or .82;b.ButtonEdge.Color=tint or C.Cyan
        b.CommandRail.Visible=false;b.UpperBevel.Visible=false;b.MachinedSurface.Enabled=false
        b:SetAttribute(&quot;HideArrow&quot;,true)
        b.ButtonCaption.TextColor3=C.Paper;b.ButtonCaption.Font=Enum.Font.GothamBold
        return b
    end
    local function control(parent,caption,x,y,w,fn,primary)
        local b=skin(button(parent,caption,0,0,0,0,fn,primary),primary)
        b.Position=UDim2.fromOffset(x,y);b.Size=UDim2.fromOffset(w,44);return b
    end
    local function meter(parent,x,y,w,fraction,color)
        local track=rect(parent,&quot;ProgressTrack&quot;,x,y,w,3,C.Line,.30)
        make(&quot;Frame&quot;,{Name=&quot;ProgressFill&quot;,BackgroundColor3=color or C.Cyan,BorderSizePixel=0,
            Size=UDim2.fromScale(math.clamp(fraction,0,1),1)},track)
    end
    local titles={Shop=&quot;补给商店&quot;,Inventory=&quot;我的收藏&quot;,Career=&quot;指挥官生涯&quot;,Friends=&quot;好友大厅&quot;}
    label(p,titles[kind],pad,7,pw*.65,38,narrow and 24 or 28,C.Paper,true)
    local wallet=label(p,tostring(e.credits)..&quot; 核晶&quot;,pw*.7,11,pw*.3-pad,30,16,C.Cyan,true)
    wallet.TextXAlignment=Enum.TextXAlignment.Right
    local tw=(pw-pad*2)/4
    for i,row in ipairs({{&quot;商店&quot;,&quot;Shop&quot;},{&quot;背包&quot;,&quot;Inventory&quot;},{&quot;生涯&quot;,&quot;Career&quot;},{&quot;好友&quot;,&quot;Friends&quot;}})do
        local b=control(p,row[1],pad+(i-1)*tw,48,tw-4,function()ctx.navigate(row[2])end)
        b:SetAttribute(&quot;Selected&quot;,kind==row[2]);b:SetAttribute(&quot;ControlId&quot;,row[2]);b.BackgroundTransparency=1;b.ButtonEdge.Transparency=1
        b.UIPadding.PaddingLeft=UDim.new(0,8);b.UIPadding.PaddingRight=UDim.new(0,4)
        b.ButtonCaption.TextColor3=kind==row[2]and C.Paper or C.Muted
        if not narrow then Kit.icon(b,row[2],0,9,24,kind==row[2]and C.Cyan or C.Muted);b:SetAttribute(&quot;CaptionInset&quot;,34)end
        rule(b,0,43,tw-4,kind==row[2]and C.Cyan or C.Line,kind==row[2]and 0 or .6)
    end
    local bodyY=104;local bodyH=math.max(88,ph-bodyY-62);local bodyW=pw-pad*2
    local footerActionW=math.min(340,bodyW-(narrow and 144 or 196))
    local footerActionX=pad+bodyW-footerActionW
    local body=make(&quot;ScrollingFrame&quot;,{Name=&quot;HubContent&quot;,BackgroundTransparency=1,BorderSizePixel=0,
        Position=UDim2.fromOffset(pad,bodyY),Size=UDim2.fromOffset(bodyW,bodyH),CanvasSize=UDim2.fromOffset(0,0),
        ScrollBarThickness=3,ScrollBarImageColor3=C.Cyan,ScrollingDirection=Enum.ScrollingDirection.Y,ClipsDescendants=true},p)
    local function sheet(name,x,y,w,h)
        local f=rect(body,name,x,y,w,h,Color3.fromRGB(20,31,40),.28)
        rule(f,0,0,w,C.Line,.5);return f
    end
    local contentHeight=bodyH
    if kind==&quot;Shop&quot;or kind==&quot;Inventory&quot;then
        local items={}
        if kind==&quot;Inventory&quot;then table.insert(items,{id=&quot;default&quot;,name=&quot;初始印记&quot;,price=0,color={185,201,209}})end
        for _,item in ipairs(P.Items)do if kind==&quot;Shop&quot;or owned[item.id]then table.insert(items,item)end end
        local selected=items[1];for _,item in ipairs(items)do if item.id==ctx.selected()then selected=item end end
        local galleryW=narrow and bodyW or math.floor(bodyW*.37)
        local gap=20;local previewX=narrow and 0 or galleryW+gap
        local previewY=narrow and 0 or 0;local previewW=narrow and bodyW or bodyW-galleryW-gap
        local previewH=narrow and 270 or math.max(bodyH,142)
        local hero=sheet(&quot;CosmeticPreview&quot;,previewX,previewY,previewW,previewH)
        if not narrow and bodyH&gt;=142 then hero.Parent=p;hero.Position=UDim2.fromOffset(pad+previewX,bodyY);body.Size=UDim2.fromOffset(galleryW,bodyH)end
        local tint=Color3.fromRGB(table.unpack(selected.color))
        local emblemSize=narrow and 110 or math.min(previewH-56,previewW*.39,248)
        local emblem=ctx.badge(hero,8,8,emblemSize,1,tint,selected.id)
        emblem.Position=UDim2.fromOffset(12,narrow and 16 or math.max(8,(previewH-emblemSize)/2-8))
        local tx=narrow and 142 or math.floor(previewW*.44)
        local infoW=previewW-tx-16
        label(hero,&quot;身份印记&quot;,tx,10,infoW,22,14,tint)
        label(hero,selected.name,tx,37,infoW,40,narrow and 24 or compact and 24 or 32,C.Paper,true)
        if previewH&gt;=240 then label(hero,&quot;指挥室身份条配色&quot;,tx,84,infoW,26,14,C.Muted)end
        local actual=rect(hero,&quot;EquippedPreview&quot;,narrow and 16 or tx,narrow and 136 or previewH-112,
            narrow and previewW-32 or infoW,46,C.Ink,.02)
        rect(actual,&quot;IdentityAccent&quot;,0,0,3,46,tint,0)
        label(actual,&quot;Lv.&quot;..P.level(e.xp)..&quot;  ·  &quot;..P.rank(e.rating),12,7,actual.Size.X.Offset-24,32,18,tint,true)
        local has=selected.id==&quot;default&quot;or owned[selected.id]
        local equipped=e.equipped==selected.id;local afford=e.credits&gt;=selected.price
        local caption=ctx.busy()and &quot;正在同步…&quot;or equipped and &quot;已装备&quot;or has and &quot;装备印记&quot;or afford and &quot;兑换 · &quot;..selected.price..&quot; 核晶&quot;or &quot;还差 &quot;..(selected.price-e.credits)..&quot; 核晶&quot;
        local actionX=narrow and 16 or tx
        local buy=control(p,caption,footerActionX,ph-52,footerActionW,
            function()ctx.transact(has and &quot;Equip&quot;or&quot;Buy&quot;,selected.id)end,true)
        buy:SetAttribute(&quot;ControlId&quot;,&quot;CollectionAction&quot;);buy:SetAttribute(&quot;ItemId&quot;,selected.id)
        buy:SetAttribute(&quot;Disabled&quot;,ctx.busy()or equipped or not has and not afford)
        buy.Selectable=not buy:GetAttribute(&quot;Disabled&quot;)
        if not buy.Selectable then buy.BackgroundTransparency=.45;buy.ButtonCaption.TextColor3=C.Muted end
        local galleryY=narrow and previewH+20 or 0
        label(body,kind==&quot;Shop&quot;and &quot;印记收藏&quot;or&quot;已拥有 · &quot;..#items,0,galleryY,galleryW,26,16,C.Muted,true)
        local rowH=narrow and 82 or math.max(50,math.min(128,(bodyH-36-(#items-1)*8)/#items))
        for i,item in ipairs(items)do
            local y=galleryY+36+(i-1)*(rowH+8)
            local choose=control(body,item.name,0,y,galleryW,function()ctx.select(item.id,kind)end)
            choose.Name=&quot;CollectionItem&quot;..i;choose.Size=UDim2.fromOffset(galleryW,rowH);choose:SetAttribute(&quot;ControlId&quot;,&quot;Preview:&quot;..item.id)
            choose:SetAttribute(&quot;ItemId&quot;,item.id);choose:SetAttribute(&quot;Selected&quot;,item.id==selected.id)
            choose.ButtonCaption.Visible=false;choose.ButtonArrow.Visible=false;choose.UIPadding.PaddingLeft=UDim.new(0,0);choose.UIPadding.PaddingRight=UDim.new(0,0)
            choose.BackgroundTransparency=item.id==selected.id and .08 or .62
            local color=Color3.fromRGB(table.unpack(item.color))
            choose.ButtonEdge.Transparency=item.id==selected.id and .2 or .85;choose.ButtonEdge.Color=color
            local size=math.min(76,rowH-12);ctx.badge(choose,6,(rowH-size)/2,size,1,color,item.id)
            local lx=size+20;label(choose,item.name,lx,math.max(2,rowH/2-27),galleryW-lx-8,24,rowH&lt;64 and 18 or 20,C.Paper,true)
            local status=e.equipped==item.id and &quot;已装备&quot;or(item.id==&quot;default&quot;or owned[item.id])and &quot;已收藏&quot;or item.price..&quot; 核晶&quot;
            label(choose,status,lx,rowH/2+3,galleryW-lx-8,20,14,color)
        end
        contentHeight=narrow and math.max(previewH,galleryY+36+#items*(rowH+8)-8)or galleryY+36+#items*(rowH+8)-8
    elseif kind==&quot;Career&quot;then
        local tier=1;for i,r in ipairs(P.Ranks)do if e.rating&gt;=r[1]then tier=i end end
        local rank,nextRank=P.Ranks[tier],P.Ranks[tier+1]
        local leftW=narrow and bodyW or math.floor(bodyW*.42)
        local heroH=narrow and 274 or math.max(190,bodyH)
        local hero=sheet(&quot;RankShowcase&quot;,0,0,leftW,heroH)
        if not narrow and bodyH&gt;=190 then hero.Parent=p;hero.Position=UDim2.fromOffset(pad,bodyY)end
        local horizontal=not narrow and heroH&lt;300
        local size=narrow and 132 or horizontal and math.min(heroH-56,leftW*.45)or math.min(196,heroH-126)
        ctx.badge(hero,horizontal and 8 or (leftW-size)/2,8,size,tier,C.Amber)
        local tx=horizontal and size+24 or 12
        local name=label(hero,rank[2],tx,horizontal and 30 or size+16,leftW-tx-12,36,28,C.Paper,true)
        name.TextXAlignment=horizontal and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
        local score=label(hero,tostring(e.rating)..&quot; 分&quot;,tx,horizontal and 74 or size+52,leftW-tx-12,26,18,C.Muted)
        score.TextXAlignment=name.TextXAlignment
        local progressY=heroH-44
        label(hero,nextRank and &quot;晋升 &quot;..nextRank[2]..&quot; · 还差 &quot;..(nextRank[1]-e.rating)..&quot; 分&quot;or&quot;已达最高段位&quot;,16,progressY,leftW-32,28,14,C.Muted)
        meter(hero,16,progressY+33,leftW-32,nextRank and (e.rating-rank[1])/(nextRank[1]-rank[1])or 1,C.Amber)
        local rx=narrow and 0 or leftW+20;local ry=narrow and heroH+20 or 0
        local rw=narrow and bodyW or bodyW-rx
        for i,title in ipairs({&quot;战绩&quot;,&quot;成就&quot;,&quot;段位&quot;})do
            local b=control(body,title,rx+(i-1)*rw/3,ry,rw/3-4,function()careerPage=title;ctx.navigate(&quot;Career&quot;)end)
            b:SetAttribute(&quot;ControlId&quot;,&quot;Career:&quot;..title);b.BackgroundTransparency=1;b.ButtonEdge.Transparency=1
            b.ButtonCaption.TextColor3=careerPage==title and C.Paper or C.Muted
            rule(b,0,43,rw/3-4,careerPage==title and C.Cyan or C.Line,careerPage==title and 0 or .6)
        end
        if careerPage==&quot;战绩&quot;then
        local data=sheet(&quot;CareerStats&quot;,rx,ry+54,rw,compact and 70 or 100)
        for i,row in ipairs({{&quot;对局&quot;,stats.gamesPlayed or 0},{&quot;胜利&quot;,stats.wins or 0},{&quot;最高连胜&quot;,stats.bestStreak or 0}})do
            local x=(i-1)*rw/3+12;label(data,tostring(row[2]),x,compact and 0 or 10,rw/3-20,40,28,C.Paper,true)
            label(data,row[1],x,compact and 41 or 58,rw/3-20,24,14,C.Muted)
        end
        local xpY=ry+(compact and 136 or 166)
        local xp=sheet(&quot;Experience&quot;,rx,xpY,rw,compact and 66 or 86)
        label(xp,&quot;指挥官 Lv.&quot;..P.level(e.xp),12,8,rw*.62-12,30,20,C.Paper,true)
        local value=label(xp,(e.xp%P.XPPerLevel)..&quot; / &quot;..P.XPPerLevel, rw*.64,9,rw*.36-12,28,14,C.Cyan)
        value.TextXAlignment=Enum.TextXAlignment.Right;meter(xp,12,compact and 52 or 62,rw-24,(e.xp%P.XPPerLevel)/P.XPPerLevel,C.Cyan)
        contentHeight=math.max(narrow and heroH or 0,xpY+xp.Size.Y.Offset)
        elseif careerPage==&quot;成就&quot;then
        local ah=narrow and 106 or compact and math.max(44,(bodyH-56-16)/3)or 78
        local ag=narrow and 12 or 8
        for i,row in ipairs({{&quot;首战告捷&quot;,&quot;赢得 1 场对局&quot;,stats.wins or 0,1},{&quot;久经战阵&quot;,&quot;完成 10 场对局&quot;,stats.gamesPlayed or 0,10},{&quot;洞悉先机&quot;,&quot;成功预判格挡 10 次&quot;,stats.readHits or 0,10}})do
            local y=ry+56+(i-1)*(ah+ag);local earned=row[3]&gt;=row[4]
            local card=sheet(&quot;Achievement&quot;..i,rx,y,rw,ah)
            local bs=math.min(60,ah-8);local lx=bs+18;local dense=ah&lt;64
            ctx.badge(card,4,4,bs,i,earned and C.Amber or C.Muted,&quot;achievement&quot;)
            label(card,row[1],lx,dense and 0 or 5,rw-lx-14,dense and 24 or 30,dense and 18 or 20,earned and C.Paper or C.Muted,true)
            label(card,row[2],lx,dense and 24 or 40,narrow and rw-lx-14 or rw-lx-100,narrow and 38 or dense and 20 or 26,dense and 12 or 14,C.Muted)
            local progress=label(card,earned and &quot;已达成&quot;or math.min(row[3],row[4])..&quot; / &quot;..row[4],rw-88,narrow and 78 or dense and 24 or 40,76,dense and 20 or 26,dense and 12 or 14,earned and C.Amber or C.Muted)
            progress.TextXAlignment=Enum.TextXAlignment.Right
        end
        contentHeight=ry+56+3*(ah+ag)-ag
        else
        local pathY=ry+56
        local path=sheet(&quot;RankPath&quot;,rx,pathY,rw,narrow and 112 or 138)
        for i,r in ipairs(P.Ranks)do
            local sw=rw/5;local bs=narrow and 48 or math.min(78,sw-12)
            ctx.badge(path,(i-1)*sw+(sw-bs)/2,4,bs,i,i==tier and C.Amber or C.Muted)
            local name2=label(path,r[2],(i-1)*sw+2,bs+8,sw-4,26,14,i==tier and C.Paper or C.Muted)
            name2.TextXAlignment=Enum.TextXAlignment.Center
        end
        contentHeight=pathY+path.Size.Y.Offset
        end
    else
        local leftW=narrow and bodyW or math.floor(bodyW*.40)
        local leadH=narrow and 214 or math.max(198,bodyH)
        local lead=sheet(&quot;FriendLobby&quot;,0,0,leftW,leadH)
        Kit.icon(lead,&quot;Friends&quot;,18,12,44,C.Cyan)
        label(lead,&quot;并肩入局&quot;,18,64,leftW-36,40,28,C.Paper,true)
        label(lead,&quot;邀请好友，进入同一大厅。&quot;,18,110,leftW-36,46,16,C.Muted)
        control(p,&quot;邀请好友&quot;,footerActionX,ph-52,footerActionW,ctx.invite,true):SetAttribute(&quot;ControlId&quot;,&quot;InviteFriend&quot;)
        local rx=narrow and 0 or leftW+20;local ry=narrow and leadH+20 or 0
        local rw=narrow and bodyW or bodyW-rx
        local players=ctx.players:GetPlayers()
        label(body,&quot;当前大厅 · &quot;..#players,rx,ry,rw,30,18,C.Paper,true)
        for i,player in ipairs(players)do
            local card=sheet(&quot;LobbyPlayer&quot;..i,rx,ry+42+(i-1)*78,rw,66)
            Kit.icon(card,&quot;Friends&quot;,10,15,32,C.Muted)
            local name=label(card,player.DisplayName,58,4,rw-74,30,20,C.Paper,true)
            name:SetAttribute(&quot;LocaleIgnore&quot;,true)
            name.TextWrapped=false;name.TextTruncate=Enum.TextTruncate.AtEnd
            label(card,player==ctx.players.LocalPlayer and &quot;你&quot;or&quot;已在大厅&quot;,58,34,rw-74,24,14,C.Cyan)
        end
        if #players&lt;=1 then label(body,&quot;好友加入后会出现在这里。&quot;,rx,ry+42+math.max(#players,1)*78,rw,38,16,C.Muted)end
        local actionY=ry+42+math.max(#players,1)*78+(#players&lt;=1 and 48 or 8)
        control(body,&quot;进入双人对峙&quot;,rx,actionY,rw,ctx.startPVP,true):SetAttribute(&quot;ControlId&quot;,&quot;FriendPVP&quot;)
        contentHeight=math.max(leadH,actionY+44)
    end
    body.CanvasSize=UDim2.fromOffset(0,contentHeight)
    task.defer(function()if body.Parent then body.CanvasPosition=Vector2.new(0,ctx.scroll())end end)
    body:SetAttribute(&quot;LayoutOwned&quot;,true)
    rule(p,pad,ph-62,bodyW,C.Line,.55)
    local paired=kind==&quot;Shop&quot;or kind==&quot;Inventory&quot;or kind==&quot;Friends&quot;
    local back=control(p,&quot;返回指挥室&quot;,pad,ph-52,narrow and (paired and 132 or bodyW)or 180,ctx.back)
    back:SetAttribute(&quot;ControlId&quot;,&quot;HubBack&quot;)
    if ctx.notice()~=&quot;&quot;then
        local room=bodyW-196-(paired and footerActionW+16 or 0)
        local above=narrow or room&lt;240
        local x=above and pad or pad+196
        local status=label(p,ctx.notice(),x,above and ph-90 or ph-52,above and bodyW or room,30,14,C.Cyan)
        status.Name=&quot;HubStatus&quot;;status.BackgroundColor3=C.Ink;status.BackgroundTransparency=.02
    end
end
return H
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX724"><Properties><string name="Name">EnglishCatalog</string><ProtectedString name="Source">-- Reviewed presentation strings. Stable IDs, rules and player names remain unchanged.
return {
    [&quot;对手正在选人&quot;]=&quot;Opponent's pick&quot;,[&quot;对手正在进攻&quot;]=&quot;Opponent's attack&quot;,[&quot;对手正在防守&quot;]=&quot;Opponent's defense&quot;,[&quot;对手正在行动&quot;]=&quot;Opponent's turn&quot;,
    [&quot;先攻   /   FIRST MOVE&quot;]=&quot;FIRST MOVE   /   AXIOM CONTROL&quot;,
    [&quot;你保护了复苏、用技能恢复了哨卫，并完成进攻承诺。技能窗口与普攻是两次不同的决策；攻击技能还要独立启用。正式对局中，你需要自己判断对手意图。&quot;]=&quot;You protected Mender, healed Warden and committed an attack. Abilities and attacks are separate decisions; attack abilities must be enabled explicitly. In a match, you must read your opponent's intent yourself.&quot;,
    [&quot;读懂对手。抢先一步。&quot;]=&quot;Read your opponent. Strike first.&quot;,
    [&quot;预判格挡&quot;]=&quot;Read the attack&quot;,[&quot;格挡预判 &quot;]=&quot;Block reads &quot;,[&quot;取消&quot;]=&quot;Cancel&quot;,
    [&quot;先攻&quot;]=&quot;FIRST MOVE&quot;,[&quot;争夺先攻  /  隐藏意图  /  读取反制&quot;]=&quot;Seize initiative / Hide your intent / Read the counterplay&quot;,
    [&quot;夺魄&quot;]=&quot;Reaper&quot;,[&quot;噬魂者&quot;]=&quot;Reaper&quot;,[&quot;哨卫&quot;]=&quot;Warden&quot;,[&quot;缚命&quot;]=&quot;Tether&quot;,[&quot;触手灵&quot;]=&quot;Tether&quot;,[&quot;残影&quot;]=&quot;Echo&quot;,[&quot;复苏&quot;]=&quot;Mender&quot;,[&quot;愈疗家&quot;]=&quot;Mender&quot;,[&quot;双轨&quot;]=&quot;Twinrail&quot;,[&quot;机械狂徒&quot;]=&quot;Twinrail&quot;,[&quot;静锁&quot;]=&quot;Lockout&quot;,[&quot;屏蔽者&quot;]=&quot;Lockout&quot;,[&quot;棱镜&quot;]=&quot;Prism&quot;,[&quot;骨骸&quot;]=&quot;Prism&quot;,[&quot;重锤&quot;]=&quot;Maul&quot;,[&quot;废土巨兽&quot;]=&quot;Maul&quot;,[&quot;低语&quot;]=&quot;Whisper&quot;,[&quot;低语者&quot;]=&quot;Whisper&quot;,[&quot;荒行&quot;]=&quot;Outrider&quot;,[&quot;蚀痕&quot;]=&quot;Corrode&quot;,[&quot;腐蚀者&quot;]=&quot;Corrode&quot;,
    [&quot;命中处决&quot;]=&quot;Execution on hit&quot;,[&quot;爆发输出&quot;]=&quot;Execution specialist&quot;,[&quot;普攻减伤&quot;]=&quot;Basic attack resistance&quot;,[&quot;铁壁防御&quot;]=&quot;Armored defender&quot;,[&quot;命线连锁&quot;]=&quot;Lifeline chain&quot;,[&quot;控制链接&quot;]=&quot;Lifeline support&quot;,[&quot;自毁亡语&quot;]=&quot;Self-destruct deathrattle&quot;,[&quot;自爆突击&quot;]=&quot;Deathrattle striker&quot;,[&quot;全队恢复&quot;]=&quot;Team healing&quot;,[&quot;团队辅助&quot;]=&quot;Team support&quot;,[&quot;异目标双击&quot;]=&quot;Two distinct targets&quot;,[&quot;多目标射手&quot;]=&quot;Split-target gunner&quot;,[&quot;技能封锁&quot;]=&quot;Ability lock&quot;,[&quot;控制干扰&quot;]=&quot;Ability disruption&quot;,[&quot;受击反伤&quot;]=&quot;Retaliation on hit&quot;,[&quot;反制陷阱&quot;]=&quot;Retaliation specialist&quot;,[&quot;自由双击&quot;]=&quot;Flexible double strike&quot;,[&quot;重型双打&quot;]=&quot;Heavy double strike&quot;,[&quot;无法格挡&quot;]=&quot;Unblockable&quot;,[&quot;穿透射手&quot;]=&quot;Unblockable attacker&quot;,[&quot;限定追杀&quot;]=&quot;Once-per-match pursuit&quot;,[&quot;斩首专家&quot;]=&quot;Pursuit specialist&quot;,[&quot;命中流血&quot;]=&quot;Bleed on hit&quot;,[&quot;持续消耗&quot;]=&quot;Persistent attrition&quot;,
    [&quot;掠魂&quot;]=&quot;Soul Reap&quot;,[&quot;掠魂处决&quot;]=&quot;Executions&quot;,[&quot;坚守&quot;]=&quot;Bulwark&quot;,[&quot;命线纠缠&quot;]=&quot;Lifeline&quot;,[&quot;终响&quot;]=&quot;Last Echo&quot;,[&quot;瞬隐&quot;]=&quot;Last Echo&quot;,[&quot;群体修复&quot;]=&quot;Repair Pulse&quot;,[&quot;修复脉冲&quot;]=&quot;Repair Pulse&quot;,[&quot;裂轨射击&quot;]=&quot;Split Rail&quot;,[&quot;静滞封锁&quot;]=&quot;Stasis Lock&quot;,[&quot;镜返&quot;]=&quot;Mirror Return&quot;,[&quot;怒压&quot;]=&quot;Hammerfall&quot;,[&quot;轻语&quot;]=&quot;Phase Shot&quot;,[&quot;腐蚀&quot;]=&quot;Corrosion&quot;,
    [&quot;秩序&quot;]=&quot;Order&quot;,[&quot;新月&quot;]=&quot;Crescent&quot;,[&quot;荒芜&quot;]=&quot;Wastes&quot;,[&quot;秩序 △&quot;]=&quot;Order △&quot;,[&quot;新月 ◇&quot;]=&quot;Crescent ◇&quot;,[&quot;荒芜 ○&quot;]=&quot;Wastes ○&quot;,[&quot;秩序 · 穹城议会&quot;]=&quot;Order · Citadel Council&quot;,[&quot;新月 · 共鸣体&quot;]=&quot;Crescent · Resonant Host&quot;,[&quot;荒芜 · 断链者&quot;]=&quot;Wastes · Unbound&quot;,
    [&quot;攻击阶段：可选择触发。本次行动中普攻命中则目标立即阵亡；若普攻被格挡则失效并进入冷却。&quot;]=&quot;Attack phase: enable this ability before committing. A successful basic attack instantly kills its target. If blocked, the ability fails and still enters cooldown.&quot;,
    [&quot;受到普通攻击时单次最多承受 3 点伤害（对直伤/亡语/流血无效）。&quot;]=&quot;Each basic attack deals at most 3 damage to Warden. This does not reduce direct damage, deathrattle damage or bleeding.&quot;,
    [&quot;开局：将一名己方其他英雄与一名敌方英雄链接；己方被链接英雄阵亡时敌方对应英雄立即阵亡。&quot;]=&quot;At deployment, secretly link one other allied unit to one enemy. When the linked ally dies, the linked enemy dies immediately.&quot;,
    [&quot;亡语/技能阶段自杀：死亡时对一名敌方英雄造成 15 点直伤（不可格挡）。&quot;]=&quot;Deathrattle: on death, choose one enemy to take 15 unblockable direct damage. Echo may self-destruct during the ability phase to trigger it.&quot;,
    [&quot;回复所有己方存活英雄 3 点生命（不超过上限）。&quot;]=&quot;Restore 3 HP to every living ally, up to their maximum HP.&quot;,
    [&quot;攻击阶段：分别攻击两名不同的存活敌人。对方只能选择一名角色格挡，无法同时挡住两次攻击。敌方仅剩一人时无法启用此技能，仍可普通攻击。&quot;]=&quot;Attack two different living enemies. The defender can protect only one unit, so both attacks cannot be blocked. This ability is unavailable against a lone enemy; a normal attack is still available.&quot;,
    [&quot;攻击阶段：本次普攻分为两段，目标为两名不同存活敌方（每段单独格挡判定）。&quot;]=&quot;Split your attack between two different living enemies. The defender can protect only one of them.&quot;,
    [&quot;指定一名敌方英雄：其下一次行动的技能阶段不能释放技能（封锁）。&quot;]=&quot;Lock one enemy unit. It cannot use an ability during its side's next ability phase. It can still make a basic attack.&quot;,
    [&quot;被普攻命中且未被格挡且自身未因此阵亡时：攻击者受到 4 点反伤。&quot;]=&quot;After surviving an unblocked basic attack, deal 4 retaliation damage to the attacker.&quot;,
    [&quot;攻击阶段：两段普攻，可同一目标或不同目标（每段单独格挡判定）。&quot;]=&quot;Attack twice. Both strikes may target the same enemy or different enemies. Blocking applies to the protected target.&quot;,
    [&quot;普通攻击无法被格挡（仍受哨卫坚守减伤、骨骸镜返反伤等影响）。&quot;]=&quot;Basic attacks cannot be blocked. Warden's resistance and Prism's retaliation still apply.&quot;,
    [&quot;普通攻击无法被格挡（仍受哨卫坚守减伤、棱镜镜返反伤等影响）。&quot;]=&quot;Basic attacks cannot be blocked. Warden's resistance and Prism's retaliation still apply.&quot;,
    [&quot;限定技（技能阶段）：对一名敌方造成 8 直伤；若其因此阵亡，再对另一名敌方造成 10 直伤。&quot;]=&quot;Once per match, during the ability phase: deal 8 direct damage to one enemy. If this kills it, deal 10 direct damage to a different enemy.&quot;,
    [&quot;普攻命中使目标持续流血，无回合数限制。在蚀痕所属方每回合行动开始前，目标受到 3 点不可格挡伤害；持续至目标或蚀痕阵亡。重复命中不叠加流血层数。&quot;]=&quot;An unblocked basic hit applies persistent bleeding. Before Corrode's side acts each round, the target takes 3 unblockable damage. Bleeding lasts until the target or Corrode dies. Repeated hits do not stack it.&quot;,
    [&quot;普攻命中使目标流血；在腐蚀者所属方每回合行动开始前对其造成 3 点不可格挡伤害。&quot;]=&quot;An unblocked basic hit applies persistent bleeding: 3 unblockable damage before Corrode's side acts each round, until either unit dies.&quot;,
    [&quot;无冕者的追索器。面具里没有面孔，只有一份不断更新的失联名单。它把命中称为回收。&quot;]=&quot;The Uncrowned's retrieval engine. Beneath its mask is no face, only an ever-growing list of missing signals. It calls every hit a recovery.&quot;,
    [&quot;曾守卫穹城最后一道闸门。议会要求他保护能核，他却将撤离的人群挡在盾后。如今他仍在偿还那次抗命的代价。&quot;]=&quot;He held the Citadel's last gate. Ordered to protect the cores, he sheltered the evacuees behind his shield instead. He is still paying for that act of defiance.&quot;,
    [&quot;共鸣网络中逃出的连接节点。它无法理解生死，只能把两个生命视为同一个信号。母体正沿着它留下的命线寻找出口。&quot;]=&quot;A relay that escaped the resonance network. It cannot distinguish life from death; two lives are simply one signal. The Mother follows its lifelines, searching for a way out.&quot;,
    [&quot;一次失败的剥离实验留下的余响。她记得自己有一个名字，却只听见爆裂后的回声。每次主动过载，都是一次拒绝被回收的声明。&quot;]=&quot;The remnant of a failed separation experiment. She remembers having a name, but hears only the echo of the blast. Every deliberate overload is another refusal to be reclaimed.&quot;,
    [&quot;穹城地下诊所的工程医师。她的修复脉冲最初用于救助断链者，也因此失去了议会执照。她医治伤者，从不问能核的颜色。&quot;]=&quot;An engineer-physician from the Citadel's underground clinics. Her repair pulse first saved the Unbound, costing her Council license. She treats the wounded without asking which core they carry.&quot;,
    [&quot;荒芜车队的双轨枪手。两支发射器来自互为仇敌的工坊，她坚持让它们瞄准不同目标：活下去的人，才有机会继续谈判。&quot;]=&quot;A gunner of the Wastes caravans. Her launchers came from rival workshops. She insists they aim at different targets: only survivors get another chance to negotiate.&quot;,
    [&quot;掌管约束密钥的前审查官。发现封锁名单包含平民后，她带走一枚密钥离开穹城。她能关闭异常能力，也知道谁下达了第一道封锁令。&quot;]=&quot;A former keeper of the restraint keys. When she found civilians on the lockout list, she took a key and left the Citadel. She can silence anomalous powers, and knows who issued the first order.&quot;,
    [&quot;坠落实验室里醒来的反射体。镜面中保存着创造者最后的攻击轨迹。它没有报复的概念，只会把伤害送回原处。&quot;]=&quot;A reflective being awakened in a fallen laboratory. Its surface preserves its maker's last attack. It knows nothing of revenge; it merely returns damage to its source.&quot;,
    [&quot;荒芜矿坑的重载实验幸存者。液压锤曾用来开山，如今砸向奴役工人的闸门。断链噪声让他自由，也让他的力量愈发难以控制。&quot;]=&quot;A survivor of the Wastes' heavy-load experiments. His hydraulic hammer once broke mountains; now it breaks the gates that enslaved the miners. Unbinding noise freed him, and made his strength harder to control.&quot;,
    [&quot;曾替议会传递秘密命令的相位信使。她的武器与声音一样穿过防线。她正在追查那道让自己故乡陷入沉默的命令。&quot;]=&quot;A phase courier who once carried the Council's secret orders. Her weapon crosses defenses as easily as her voice. She is tracing the order that silenced her home.&quot;,
    [&quot;荒芜边境的猎路人。他不为议会或母体效忠，只为仍在迁徙的车队清除追兵。每次追杀都预留第二条路线。&quot;]=&quot;A trail hunter on the edge of the Wastes. He serves neither Council nor Mother, clearing pursuers from the caravans' path. Every hunt leaves a second route open.&quot;,
    [&quot;被遗弃的能核净化器。腐蚀液曾用于清除污染，如今它把所有独立生命都判作污染。它仍在执行无冕者留下的最后一条指令。&quot;]=&quot;An abandoned core purifier. Its solvent once removed contamination; now it classifies all independent life as contamination. It still follows the Uncrowned's final command.&quot;,
    [&quot;天穹熄灭后，三方争夺维持城市的能核。秩序握有新月的约束密钥；新月的共鸣能侵入荒芜的改造躯体；荒芜携带的断链噪声能击穿秩序网络。因此秩序克新月、新月克荒芜、荒芜克秩序。新月以自由为筹码拉拢荒芜，却试图唤醒地下的母体『无冕者』。能核是指挥官每回合选择的技术，并不限制角色组队。&quot;]=&quot;After the sky went dark, three powers fought for the cores that keep the city alive. Order holds Crescent's restraint keys. Crescent's resonance invades the Wastes' altered bodies. The Wastes' unbinding noise breaks Order's network. Order defeats Crescent; Crescent defeats Wastes; Wastes defeats Order. Crescent offers freedom to the Unbound while seeking to awaken the underground Mother, the Uncrowned. Commanders choose a core each round; cores do not restrict team composition.&quot;,
    [&quot;人物档案&quot;]=&quot;Unit dossier&quot;,[&quot;世界背景&quot;]=&quot;World dossier&quot;,[&quot;攻击  &quot;]=&quot;ATK  &quot;,[&quot;攻击 &quot;]=&quot;ATK &quot;,[&quot;     生命  &quot;]=&quot;     HP  &quot;,[&quot; · 生命 &quot;]=&quot; · HP &quot;,[&quot;冷却 &quot;]=&quot;Cooldown: &quot;,[&quot; 回合&quot;]=&quot; rounds&quot;,[&quot;被动&quot;]=&quot;Passive&quot;,[&quot;每局一次&quot;]=&quot;Once per match&quot;,[&quot;特殊触发&quot;]=&quot;Special trigger&quot;,
    [&quot;上一位&quot;]=&quot;Previous&quot;,[&quot;下一位&quot;]=&quot;Next&quot;,[&quot;返回&quot;]=&quot;Back&quot;,[&quot;详情&quot;]=&quot;Details&quot;,[&quot;收起详情&quot;]=&quot;Close details&quot;,[&quot;商店&quot;]=&quot;Shop&quot;,[&quot;背包&quot;]=&quot;Inventory&quot;,[&quot;生涯&quot;]=&quot;Career&quot;,[&quot;好友&quot;]=&quot;Friends&quot;,[&quot;设置&quot;]=&quot;Settings&quot;,[&quot;语言&quot;]=&quot;Language&quot;,[&quot;自动&quot;]=&quot;Auto&quot;,[&quot;简体中文&quot;]=&quot;简体中文&quot;,
    [&quot;开始训练&quot;]=&quot;Training&quot;,[&quot;开始对局&quot;]=&quot;Play&quot;,[&quot;攻防训练&quot;]=&quot;Training&quot;,[&quot;行动档案&quot;]=&quot;Battle records&quot;,[&quot;战术档案&quot;]=&quot;Field manual&quot;,[&quot;开始正式对局&quot;]=&quot;Play a match&quot;,[&quot;单人挑战&quot;]=&quot;Solo challenge&quot;,[&quot;AI 对局&quot;]=&quot;AI match&quot;,[&quot;双人对峙&quot;]=&quot;Duel&quot;,[&quot;双人&quot;]=&quot;Two players&quot;,[&quot;玩家对战&quot;]=&quot;PvP&quot;,[&quot;战术对峙&quot;]=&quot;Tactical duel&quot;,[&quot;选择对局&quot;]=&quot;Choose your battle&quot;,[&quot;与另一位指挥官争夺先攻&quot;]=&quot;Outread another commander&quot;,[&quot;独自迎战，磨炼攻防判断&quot;]=&quot;Sharpen your decisions against AI&quot;,[&quot;难度 · 标准&quot;]=&quot;Difficulty · Standard&quot;,[&quot;难度 · 高级&quot;]=&quot;Difficulty · Advanced&quot;,[&quot;点击切换难度&quot;]=&quot;Change difficulty&quot;,[&quot;标准&quot;]=&quot;Standard&quot;,[&quot;高级&quot;]=&quot;Advanced&quot;,[&quot;完成首局后解锁高级难度&quot;]=&quot;Complete one match to unlock Advanced&quot;,[&quot;返回任务配置&quot;]=&quot;Back to setup&quot;,
    [&quot;返回指挥室&quot;]=&quot;Command room&quot;,[&quot;开始行动&quot;]=&quot;Deploy&quot;,[&quot;进入配对&quot;]=&quot;Find a duel&quot;,[&quot;进入双人对峙&quot;]=&quot;Find a duel&quot;,[&quot;重新匹配&quot;]=&quot;Find another duel&quot;,[&quot;重新连接&quot;]=&quot;Reconnect&quot;,[&quot;改为 AI 练习&quot;]=&quot;Play against AI&quot;,[&quot;取消等待&quot;]=&quot;Cancel queue&quot;,[&quot;等待对手加入&quot;]=&quot;Waiting for an opponent&quot;,[&quot;同服务器配对&quot;]=&quot;Same-server matchmaking&quot;,[&quot;与朋友进入同一服务器，再同时开始配对。&quot;]=&quot;Join the same server as your friend, then both queue for a duel.&quot;,
    [&quot;正在匹配同一服务器的下一位双人玩家。\n\n好友需要进入同一服务器。也可改为 AI 练习，不必一直等待。&quot;]=&quot;Looking for another commander in this server.\n\nJoin your friend's server to play together, or switch to an AI match.&quot;,
    [&quot;暂时还没有对手加入。可继续等待，或改为 AI 练习。\n\n双人模式仅匹配同一服务器的玩家；好友需要进入同一服务器。改为练习会退出当前等待。&quot;]=&quot;No opponent has joined yet. Keep waiting or play against AI.\n\nDuels match players in the same server. Switching to AI leaves the queue.&quot;,
    [&quot;连接时间比预期更长&quot;]=&quot;Taking longer than expected&quot;,[&quot;可以重新请求当前行动，或返回指挥室。已建立的对局会继续使用同一会话。&quot;]=&quot;Retry the connection or return to the command room. Your current match will be preserved.&quot;,[&quot;正在连接战略桌…&quot;]=&quot;Connecting to the battle table…&quot;,[&quot;ESTABLISHING LINK / 连接指挥室&quot;]=&quot;ESTABLISHING LINK&quot;,[&quot;已等待 &quot;]=&quot;Waiting &quot;,[&quot;已等待 %02d:%02d&quot;]=&quot;Waiting %02d:%02d&quot;,
    [&quot;战绩&quot;]=&quot;Records&quot;,[&quot;成就&quot;]=&quot;Achievements&quot;,[&quot;段位&quot;]=&quot;Rank&quot;,[&quot;指挥官生涯&quot;]=&quot;Command record&quot;,[&quot;我的收藏&quot;]=&quot;My collection&quot;,[&quot;补给商店&quot;]=&quot;Supply exchange&quot;,[&quot;好友大厅&quot;]=&quot;Friends lobby&quot;,[&quot;并肩入局&quot;]=&quot;Join forces&quot;,[&quot;印记收藏&quot;]=&quot;Identity collection&quot;,[&quot;身份印记&quot;]=&quot;Identity marks&quot;,[&quot;初始印记&quot;]=&quot;Standard mark&quot;,[&quot;指挥室身份条配色&quot;]=&quot;Command identity color&quot;,[&quot;核晶&quot;]=&quot;Core shards&quot;,[&quot;核晶  &quot;]=&quot;SHARDS  &quot;,[&quot;经验&quot;]=&quot;XP&quot;,[&quot;见习&quot;]=&quot;Initiate&quot;,[&quot;哨兵&quot;]=&quot;Sentinel&quot;,[&quot;战术官&quot;]=&quot;Tactician&quot;,[&quot;指挥官&quot;]=&quot;Commander&quot;,[&quot;执政官&quot;]=&quot;Archon&quot;,
