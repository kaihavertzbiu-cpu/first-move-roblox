            cast_rail={channel=&quot;Skill&quot;,asset=&quot;whoosh&quot;,speed=1.30,gain=.26,hold=.28,fade=.24},
            cast_maul={channel=&quot;Skill&quot;,asset=&quot;metal&quot;,fallback=&quot;action_jump_land.mp3&quot;,speed=.90,gain=.32,hold=.35,fade=.32},
            cast_overload={channel=&quot;Skill&quot;,asset=&quot;metal&quot;,fallback=&quot;action_jump_land.mp3&quot;,speed=.70,gain=.36,hold=.45,fade=.42},
