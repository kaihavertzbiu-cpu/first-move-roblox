return {[&quot;sourceCommit&quot;]=&quot;242dd1b2a58a9ff7e5f0ab057b5023f328ac9f3d&quot;,[&quot;heroes&quot;]={{[&quot;id&quot;]=&quot;ting_sun&quot;,[&quot;name&quot;]=&quot;噬魂者&quot;,[&quot;atk&quot;]=8,[&quot;maxHp&quot;]=22,[&quot;role&quot;]=&quot;爆发输出&quot;,[&quot;faction&quot;]=&quot;anomaly&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;thunder_judgment&quot;,[&quot;name&quot;]=&quot;掠魂&quot;,[&quot;type&quot;]=&quot;active_attack_phase&quot;,[&quot;triggerTiming&quot;]=&quot;onAttack&quot;,[&quot;cooldown&quot;]=5,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;攻击阶段：可选择触发。本次行动中普攻命中则目标立即阵亡；若普攻被格挡则失效并进入冷却。&quot;}},{[&quot;id&quot;]=&quot;lan_dun&quot;,[&quot;name&quot;]=&quot;哨卫&quot;,[&quot;atk&quot;]=3,[&quot;maxHp&quot;]=26,[&quot;role&quot;]=&quot;铁壁防御&quot;,[&quot;faction&quot;]=&quot;survivor&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;steadfast&quot;,[&quot;name&quot;]=&quot;坚守&quot;,[&quot;type&quot;]=&quot;passive&quot;,[&quot;triggerTiming&quot;]=&quot;passive&quot;,[&quot;cooldown&quot;]=0,[&quot;isPassive&quot;]=true,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;受到普通攻击时单次最多承受 3 点伤害（对直伤/亡语/流血无效）。&quot;}},{[&quot;id&quot;]=&quot;ye_ban&quot;,[&quot;name&quot;]=&quot;触手灵&quot;,[&quot;atk&quot;]=4,[&quot;maxHp&quot;]=20,[&quot;role&quot;]=&quot;控制链接&quot;,[&quot;faction&quot;]=&quot;anomaly&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;fate_line&quot;,[&quot;name&quot;]=&quot;命线纠缠&quot;,[&quot;type&quot;]=&quot;game_start&quot;,[&quot;triggerTiming&quot;]=&quot;passive&quot;,[&quot;cooldown&quot;]=0,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;开局：将一名己方其他英雄与一名敌方英雄链接；己方被链接英雄阵亡时敌方对应英雄立即阵亡。&quot;}},{[&quot;id&quot;]=&quot;yan_wei&quot;,[&quot;name&quot;]=&quot;残影&quot;,[&quot;atk&quot;]=7,[&quot;maxHp&quot;]=16,[&quot;role&quot;]=&quot;自爆突击&quot;,[&quot;faction&quot;]=&quot;anomaly&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;overload_explode&quot;,[&quot;name&quot;]=&quot;瞬隐&quot;,[&quot;type&quot;]=&quot;death_rattle&quot;,[&quot;triggerTiming&quot;]=&quot;active&quot;,[&quot;cooldown&quot;]=0,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;亡语/技能阶段自杀：死亡时对一名敌方英雄造成 15 点直伤（不可格挡）。&quot;}},{[&quot;id&quot;]=&quot;bai_ji&quot;,[&quot;name&quot;]=&quot;愈疗家&quot;,[&quot;atk&quot;]=4,[&quot;maxHp&quot;]=23,[&quot;role&quot;]=&quot;团队辅助&quot;,[&quot;faction&quot;]=&quot;survivor&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;group_heal&quot;,[&quot;name&quot;]=&quot;群体修复&quot;,[&quot;type&quot;]=&quot;active_skill_phase&quot;,[&quot;triggerTiming&quot;]=&quot;active&quot;,[&quot;cooldown&quot;]=3,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;回复所有己方存活英雄 3 点生命（不超过上限）。&quot;}},{[&quot;id&quot;]=&quot;shuang_xing&quot;,[&quot;name&quot;]=&quot;机械狂徒&quot;,[&quot;atk&quot;]=7,[&quot;maxHp&quot;]=22,[&quot;role&quot;]=&quot;多目标射手&quot;,[&quot;faction&quot;]=&quot;wasteland&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;rail_shot&quot;,[&quot;name&quot;]=&quot;裂轨射击&quot;,[&quot;type&quot;]=&quot;active_attack_phase&quot;,[&quot;triggerTiming&quot;]=&quot;onAttack&quot;,[&quot;cooldown&quot;]=2,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;攻击阶段：本次普攻分为两段，目标为两名不同存活敌方（每段单独格挡判定）。&quot;}},{[&quot;id&quot;]=&quot;chi_guang&quot;,[&quot;name&quot;]=&quot;屏蔽者&quot;,[&quot;atk&quot;]=4,[&quot;maxHp&quot;]=20,[&quot;role&quot;]=&quot;控制干扰&quot;,[&quot;faction&quot;]=&quot;survivor&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;stasis_lock&quot;,[&quot;name&quot;]=&quot;静滞封锁&quot;,[&quot;type&quot;]=&quot;active_skill_phase&quot;,[&quot;triggerTiming&quot;]=&quot;active&quot;,[&quot;cooldown&quot;]=3,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;指定一名敌方英雄：其下一次行动的技能阶段不能释放技能（封锁）。&quot;}},{[&quot;id&quot;]=&quot;zhe_jing&quot;,[&quot;name&quot;]=&quot;骨骸&quot;,[&quot;atk&quot;]=5,[&quot;maxHp&quot;]=22,[&quot;role&quot;]=&quot;反制陷阱&quot;,[&quot;faction&quot;]=&quot;wasteland&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;mirror_return&quot;,[&quot;name&quot;]=&quot;镜返&quot;,[&quot;type&quot;]=&quot;passive&quot;,[&quot;triggerTiming&quot;]=&quot;passive&quot;,[&quot;cooldown&quot;]=0,[&quot;isPassive&quot;]=true,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;被普攻命中且未被格挡且自身未因此阵亡时：攻击者受到 4 点反伤。&quot;}},{[&quot;id&quot;]=&quot;beng_yue&quot;,[&quot;name&quot;]=&quot;废土巨兽&quot;,[&quot;atk&quot;]=8,[&quot;maxHp&quot;]=22,[&quot;role&quot;]=&quot;重型双打&quot;,[&quot;faction&quot;]=&quot;wasteland&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;fury_press&quot;,[&quot;name&quot;]=&quot;怒压&quot;,[&quot;type&quot;]=&quot;active_attack_phase&quot;,[&quot;triggerTiming&quot;]=&quot;onAttack&quot;,[&quot;cooldown&quot;]=3,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;攻击阶段：两段普攻，可同一目标或不同目标（每段单独格挡判定）。&quot;}},{[&quot;id&quot;]=&quot;huan_shi&quot;,[&quot;name&quot;]=&quot;低语者&quot;,[&quot;atk&quot;]=7,[&quot;maxHp&quot;]=18,[&quot;role&quot;]=&quot;穿透射手&quot;,[&quot;faction&quot;]=&quot;survivor&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;phase_arrow&quot;,[&quot;name&quot;]=&quot;轻语&quot;,[&quot;type&quot;]=&quot;passive&quot;,[&quot;triggerTiming&quot;]=&quot;onAttack&quot;,[&quot;cooldown&quot;]=0,[&quot;isPassive&quot;]=true,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;普通攻击无法被格挡（仍受哨卫坚守减伤、骨骸镜返反伤等影响）。&quot;}},{[&quot;id&quot;]=&quot;zhui_lie&quot;,[&quot;name&quot;]=&quot;荒行&quot;,[&quot;atk&quot;]=8,[&quot;maxHp&quot;]=20,[&quot;role&quot;]=&quot;斩首专家&quot;,[&quot;faction&quot;]=&quot;wasteland&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;final_barrage&quot;,[&quot;name&quot;]=&quot;终幕&quot;,[&quot;type&quot;]=&quot;limited&quot;,[&quot;triggerTiming&quot;]=&quot;active&quot;,[&quot;cooldown&quot;]=0,[&quot;isPassive&quot;]=false,[&quot;isGameLimited&quot;]=true,[&quot;description&quot;]=&quot;限定技（技能阶段）：对一名敌方造成 8 直伤；若其因此阵亡，再对另一名敌方造成 10 直伤。&quot;}},{[&quot;id&quot;]=&quot;xuan_bao&quot;,[&quot;name&quot;]=&quot;腐蚀者&quot;,[&quot;atk&quot;]=7,[&quot;maxHp&quot;]=22,[&quot;role&quot;]=&quot;持续消耗&quot;,[&quot;faction&quot;]=&quot;anomaly&quot;,[&quot;skill&quot;]={[&quot;code&quot;]=&quot;blood_hunt&quot;,[&quot;name&quot;]=&quot;腐蚀&quot;,[&quot;type&quot;]=&quot;passive&quot;,[&quot;triggerTiming&quot;]=&quot;onAttack&quot;,[&quot;cooldown&quot;]=0,[&quot;isPassive&quot;]=true,[&quot;isGameLimited&quot;]=false,[&quot;description&quot;]=&quot;普攻命中使目标流血；在腐蚀者所属方每回合行动开始前对其造成 3 点不可格挡伤害。&quot;}}},[&quot;draft&quot;]={{[&quot;player&quot;]=&quot;A&quot;,[&quot;picks&quot;]=1},{[&quot;player&quot;]=&quot;B&quot;,[&quot;picks&quot;]=2},{[&quot;player&quot;]=&quot;A&quot;,[&quot;picks&quot;]=2},{[&quot;player&quot;]=&quot;B&quot;,[&quot;picks&quot;]=2},{[&quot;player&quot;]=&quot;A&quot;,[&quot;picks&quot;]=2},{[&quot;player&quot;]=&quot;B&quot;,[&quot;picks&quot;]=1}},[&quot;beats&quot;]={[&quot;cyan&quot;]=&quot;purple&quot;,[&quot;red&quot;]=&quot;cyan&quot;,[&quot;purple&quot;]=&quot;red&quot;},[&quot;damage&quot;]={[&quot;bleeding&quot;]=3,[&quot;reflection&quot;]=4,[&quot;deathRattle&quot;]=15,[&quot;finalFirst&quot;]=8,[&quot;finalSecond&quot;]=10},[&quot;healing&quot;]=3,[&quot;normalDamageCap&quot;]=3}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX676"><Properties><string name="Name">AIConfig</string><ProtectedString name="Source">return {Standard={think=.75},Advanced={think=1.05,coreMemory=5,coreExploration=.28,blockPenalty=5,killBonus=12,executionWeight=.8,exploration=2,weakestProtection=.75}}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX677"><Properties><string name="Name">ProgressionConfig</string><ProtectedString name="Source">local P={Currency=&quot;核晶&quot;,XPPerLevel=200,WinCredits=60,LossCredits=20,WinXP=100,LossXP=40,RankWin=25,RankLoss=15}
P.Items={
    {id=&quot;signal_cyan&quot;,name=&quot;新月信标&quot;,price=120,description=&quot;指挥室身份条 · 冷青配色&quot;,color={103,207,216}},
    {id=&quot;signal_amber&quot;,name=&quot;秩序印记&quot;,price=120,description=&quot;指挥室身份条 · 琥珀配色&quot;,color={219,177,100}},
    {id=&quot;signal_violet&quot;,name=&quot;荒芜回声&quot;,price=180,description=&quot;指挥室身份条 · 紫灰配色&quot;,color={174,164,206}},
}
P.ById={};for _,item in ipairs(P.Items)do P.ById[item.id]=item end
P.Ranks={{0,&quot;见习&quot;},{100,&quot;哨兵&quot;},{250,&quot;战术官&quot;},{500,&quot;指挥官&quot;},{900,&quot;执政官&quot;}}
function P.rank(points)local name=P.Ranks[1][2];for _,r in ipairs(P.Ranks)do if points&gt;=r[1]then name=r[2]end end;return name end
function P.level(xp)return 1+math.floor(xp/P.XPPerLevel)end
return P
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX678"><Properties><string name="Name">ProductConfig</string><ProtectedString name="Source">return {Name=&quot;先攻&quot;, EnglishName=&quot;FIRST MOVE&quot;, Tagline=&quot;读懂对手。抢先一步。&quot;}</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX697"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX696"><Properties><string name="Name">DeadlockServer</string></Properties><Item class="ModuleScript" referent="RBX681"><Properties><string name="Name">OpeningRules</string><ProtectedString name="Source">-- Server-only opening migration. Combat resolution is deliberately not implemented here.
local Config = require(game:GetService(&quot;ReplicatedStorage&quot;).DeadlockShared.LegacyConfig)
local Rules = {}
local definitions = {}
for _, hero in ipairs(Config.heroes) do definitions[hero.id] = hero end
local function other(owner) return owner == &quot;A&quot; and &quot;B&quot; or &quot;A&quot; end
local function owns(state, owner, id)
    for _, hero in ipairs(state.rosters[owner]) do
        if hero.id == id then return hero end
    end
end
local function beginCores(state)
    state.phase = &quot;CoreSelection&quot;
    state.round = 1
    state.actor = nil
end
function Rules.new()
    return {revision=0, phase=&quot;Draft&quot;, round=0, draftStep=1,
        picksRemaining=Config.draft[1].picks, rosters={A={}, B={}},
        taken={}, cores={}, link=nil, events={}}
end
function Rules.actor(state)
    if state.phase == &quot;Draft&quot; then return Config.draft[state.draftStep].player end
    if state.phase == &quot;LinkSetup&quot; then return state.linkOwner end
    return state.actor
end
-- Validate completely before mutation. Owner is supplied by the server, never by a payload.
function Rules.apply(state, owner, intent)
    if owner ~= &quot;A&quot; and owner ~= &quot;B&quot; then return false, &quot;InvalidOwner&quot; end
    if type(intent) ~= &quot;table&quot; or intent.revision ~= state.revision then return false, &quot;StaleRevision&quot; end
    local kind = intent.kind
    if state.phase == &quot;Draft&quot; and kind == &quot;DraftPick&quot; then
        if Rules.actor(state) ~= owner then return false, &quot;WrongActor&quot; end
        local id = intent.heroId
        if type(id) ~= &quot;string&quot; or not definitions[id] then return false, &quot;UnknownHero&quot; end
        if state.taken[id] then return false, &quot;HeroTaken&quot; end
        local def = definitions[id]
        state.taken[id] = true
        table.insert(state.rosters[owner], {id=id, hp=def.maxHp, maxHp=def.maxHp,
            atk=def.atk, cooldown=0, alive=true, used=false, statuses={}})
        state.picksRemaining -= 1
        if state.picksRemaining == 0 then
            state.draftStep += 1
            local step = Config.draft[state.draftStep]
            if step then state.picksRemaining = step.picks
            else
                for _, side in ipairs({&quot;A&quot;, &quot;B&quot;}) do
                    if owns(state, side, &quot;ye_ban&quot;) then state.linkOwner = side end
                end
                if state.linkOwner then state.phase = &quot;LinkSetup&quot; else beginCores(state) end
            end
        end
    elseif state.phase == &quot;LinkSetup&quot; and kind == &quot;LinkConfirm&quot; then
        if owner ~= state.linkOwner then return false, &quot;WrongActor&quot; end
        if intent.allyId == &quot;ye_ban&quot; or not owns(state, owner, intent.allyId) then return false, &quot;InvalidAlly&quot; end
        if not owns(state, other(owner), intent.enemyId) then return false, &quot;InvalidEnemy&quot; end
        state.link = {owner=owner, allyId=intent.allyId, enemyId=intent.enemyId, active=true}
        beginCores(state)
    elseif state.phase == &quot;CoreSelection&quot; and kind == &quot;CoreLock&quot; then
        if type(intent.core) ~= &quot;string&quot; or not Config.beats[intent.core] then return false, &quot;InvalidCore&quot; end
        if state.cores[owner] then return false, &quot;AlreadyLocked&quot; end
        state.cores[owner] = intent.core
        if state.cores.A and state.cores.B then
            local a, b = state.cores.A, state.cores.B
            table.insert(state.events, {kind=&quot;CoreReveal&quot;, round=state.round, A=a, B=b})
            if a == b then
                state.cores = {}
                table.insert(state.events, {kind=&quot;CoreTie&quot;, round=state.round})
            else
                state.initiative = Config.beats[a] == b and &quot;A&quot; or &quot;B&quot;
                state.actor = state.initiative
                state.phase = &quot;SkillPhase&quot;
            end
        end
    else return false, &quot;WrongPhase&quot; end
    state.revision += 1
    return true
end
-- Explicit public projection: never clone the private state into a network response.
function Rules.view(state, owner)
    assert(owner == &quot;A&quot; or owner == &quot;B&quot;, &quot;Invalid viewer&quot;)
    local view = {revision=state.revision, phase=state.phase, round=state.round,
        actor=Rules.actor(state), initiative=state.initiative,
        picksRemaining=state.picksRemaining, rosters={A={}, B={}},
        coreLocked={A=state.cores.A ~= nil, B=state.cores.B ~= nil},
        ownCore=state.cores[owner], events={}}
    for _, side in ipairs({&quot;A&quot;, &quot;B&quot;}) do
        for _, hero in ipairs(state.rosters[side]) do
            table.insert(view.rosters[side], {id=hero.id, hp=hero.hp, maxHp=hero.maxHp,
                atk=hero.atk, cooldown=hero.cooldown, alive=hero.alive, used=hero.used})
        end
    end
    if state.link and state.link.owner == owner then
        view.ownLink = {allyId=state.link.allyId, enemyId=state.link.enemyId, active=state.link.active}
    end
    for _, event in ipairs(state.events) do table.insert(view.events, table.clone(event)) end
    return view
end
return Rules
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX682"><Properties><string name="Name">OpeningTests</string><ProtectedString name="Source">local Rules = require(script.Parent.OpeningRules)
local Config = require(game:GetService(&quot;ReplicatedStorage&quot;).DeadlockShared.LegacyConfig)
return function()
    local checks = 0
    local function check(value, label)
        assert(value, &quot;FIRST_MOVE_TEST: &quot;..label)
        checks += 1
    end
    local state = Rules.new()
    local function apply(owner, intent)
        intent.revision = state.revision
        return Rules.apply(state, owner, intent)
    end
    check(not apply(&quot;B&quot;, {kind=&quot;DraftPick&quot;,heroId=&quot;ting_sun&quot;}) and state.revision == 0, &quot;wrong actor rejected atomically&quot;)
    check(apply(&quot;A&quot;, {kind=&quot;DraftPick&quot;,heroId=&quot;ting_sun&quot;}), &quot;first pick&quot;)
    check(not apply(&quot;B&quot;, {kind=&quot;DraftPick&quot;,heroId=&quot;ting_sun&quot;}) and state.revision == 1, &quot;duplicate rejected atomically&quot;)
    for i=2,10 do check(apply(Rules.actor(state), {kind=&quot;DraftPick&quot;,heroId=Config.heroes[i].id}), &quot;snake pick &quot;..i) end
    check(#state.rosters.A == 5 and #state.rosters.B == 5 and state.phase == &quot;LinkSetup&quot;, &quot;five per side and link gate&quot;)
    local owner = state.linkOwner
    local enemy = owner == &quot;A&quot; and &quot;B&quot; or &quot;A&quot;
    check(not apply(owner, {kind=&quot;LinkConfirm&quot;,allyId=&quot;ye_ban&quot;,enemyId=state.rosters[enemy][1].id}), &quot;link cannot bind its source&quot;)
    local allyId
    for _, h in ipairs(state.rosters[owner]) do if h.id ~= &quot;ye_ban&quot; then allyId=h.id;break end end
    check(apply(owner, {kind=&quot;LinkConfirm&quot;,allyId=allyId,enemyId=state.rosters[enemy][1].id}), &quot;valid private link&quot;)
    check(Rules.view(state, enemy).ownLink == nil and Rules.view(state, owner).ownLink ~= nil, &quot;enemy link remains secret&quot;)
    check(apply(&quot;A&quot;, {kind=&quot;CoreLock&quot;,core=&quot;red&quot;}), &quot;first core locks&quot;)
    local hidden = Rules.view(state, &quot;B&quot;)
    check(hidden.ownCore == nil and hidden.cores == nil and #hidden.events == 0 and hidden.coreLocked.A, &quot;unrevealed enemy core never projected&quot;)
    check(not apply(&quot;A&quot;, {kind=&quot;CoreLock&quot;,core=&quot;cyan&quot;}), &quot;locked commitment cannot be overwritten&quot;)
    check(apply(&quot;B&quot;, {kind=&quot;CoreLock&quot;,core=&quot;red&quot;}) and state.round == 1 and state.phase == &quot;CoreSelection&quot; and next(state.cores) == nil, &quot;tie reselects without round advance&quot;)
    local revision = state.revision
    check(not Rules.apply(state, &quot;A&quot;, {kind=&quot;CoreLock&quot;,core=&quot;cyan&quot;,revision=revision-1}) and state.revision == revision, &quot;stale request has no effect&quot;)
    check(not apply(&quot;A&quot;, {kind=&quot;CoreLock&quot;,core=&quot;bogus&quot;}), &quot;invalid core rejected&quot;)
    check(apply(&quot;A&quot;, {kind=&quot;CoreLock&quot;,core=&quot;cyan&quot;}) and apply(&quot;B&quot;, {kind=&quot;CoreLock&quot;,core=&quot;purple&quot;}) and state.actor == &quot;A&quot; and state.phase == &quot;SkillPhase&quot;, &quot;source core relation selects first actor&quot;)
    local view=Rules.view(state,&quot;A&quot;)
    view.rosters.A[1].hp=0
    check(state.rosters.A[1].hp == state.rosters.A[1].maxHp, &quot;projection is isolated from authority&quot;)
    check(not apply(&quot;A&quot;, {kind=&quot;DraftPick&quot;,heroId=&quot;zhui_lie&quot;}), &quot;wrong phase rejected&quot;)
    print(&quot;FIRST_MOVE_TEST: &quot;..checks..&quot; opening assertions passed&quot;)
    return checks
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX683"><Properties><string name="Name">CombatRules</string><ProtectedString name="Source">-- Server authority. Pending choices keep the remaining event queue, never replay a snapshot.
local Config = require(game:GetService(&quot;ReplicatedStorage&quot;).DeadlockShared.LegacyConfig)
local Combat = {}
local defs = {}
for _, h in ipairs(Config.heroes) do defs[h.id]=h end
local function other(owner) return owner == &quot;A&quot; and &quot;B&quot; or &quot;A&quot; end
local function get(state,id)
    for _,owner in ipairs({&quot;A&quot;,&quot;B&quot;}) do
        for _,h in ipairs(state.rosters[owner]) do if h.id==id then return h,owner end end
    end
end
local function living(state,owner)
    local result={}
    for _,h in ipairs(state.rosters[owner]) do if h.alive then table.insert(result,h) end end
    return result
end
local function emit(state,kind,data)
    data=data or {};data.kind=kind;data.round=state.round
    table.insert(state.events,data)
end
local function prepend(state,events)
    for i=#events,1,-1 do table.insert(state.queue,1,events[i]) end
end
local function checkWin(state)
    local a,b=#living(state,&quot;A&quot;),#living(state,&quot;B&quot;)
    if a&gt;0 and b&gt;0 then return false end
    state.phase=&quot;GameOver&quot;;state.actor=nil;state.pending=nil;state.attack=nil
    state.winner=a==0 and b==0 and &quot;Draw&quot; or (a&gt;0 and &quot;A&quot; or &quot;B&quot;)
    emit(state,&quot;GameOver&quot;,{winner=state.winner})
    return true
end
local drain
local function startAction(state,owner)
    state.actor=owner;state.actionOwner=owner;state.phase=&quot;Resolving&quot;;state.resume=&quot;SkillPhase&quot;;state.queue={}
    emit(state,&quot;ActionStart&quot;,{owner=owner})
    local source=get(state,&quot;xuan_bao&quot;)
    if source and source.alive then
        local _,sourceOwner=get(state,&quot;xuan_bao&quot;)
        if sourceOwner==owner then
            for _,h in ipairs(living(state,other(owner))) do
                if h.statuses.bleeding then table.insert(state.queue,{kind=&quot;Damage&quot;,target=h.id,source=source.id,amount=Config.damage.bleeding,damageType=&quot;Bleeding&quot;}) end
            end
        end
    end
    drain(state)
end
local function finishAction(state)
    local owner=state.actionOwner
    for _,h in ipairs(state.rosters[owner]) do h.statuses.blocked=nil end
    state.attack=nil
    if state.turnSlot==1 then
        state.turnSlot=2
        startAction(state,other(state.initiative))
    else
        for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do
            for _,h in ipairs(state.rosters[side]) do if h.alive then h.cooldown=math.max(0,h.cooldown-1) end end
        end
        emit(state,&quot;RoundEnd&quot;)
        state.round+=1;state.cores={};state.phase=&quot;CoreSelection&quot;;state.actor=nil
    end
end
local function death(state,event)
    local h,owner=get(state,event.target)
    if not h or not h.alive then return end
    h.hp=0;h.alive=false
    emit(state,&quot;Death&quot;,{target=h.id,owner=owner})
    local nextEvents={}
    if h.id==&quot;yan_wei&quot; then table.insert(nextEvents,{kind=&quot;Rattle&quot;,source=h.id,owner=owner,target=event.rattleTarget}) end
    -- Keep this continuation even if the rattle pauses or kills another unit.
    table.insert(nextEvents,{kind=&quot;Link&quot;,target=h.id,owner=owner})
    prepend(state,nextEvents)
end
local function damage(state,event)
    local target=get(state,event.target)
    if not target or not target.alive then return end
    local amount=event.amount
    if event.damageType==&quot;Normal&quot; then
        local attacker=get(state,event.source)
        if not attacker or not attacker.alive then return end
        if event.blocker==target.id and attacker.id~=&quot;huan_shi&quot; then
            emit(state,&quot;Block&quot;,{source=attacker.id,target=target.id})
            return
        end
        if event.execute then
            emit(state,&quot;Execute&quot;,{source=attacker.id,target=target.id})
            target.hp=0;prepend(state,{{kind=&quot;Death&quot;,target=target.id}});return
        end
        if target.id==&quot;lan_dun&quot; then amount=math.min(amount,Config.normalDamageCap) end
        if attacker.id==&quot;xuan_bao&quot; then target.statuses.bleeding=true end
    end
    local effective=math.min(target.hp,amount)
    target.hp=math.max(0,target.hp-amount)
    emit(state,&quot;Damage&quot;,{source=event.source,target=target.id,amount=amount,effective=effective,damageType=event.damageType})
    if target.hp==0 then prepend(state,{{kind=&quot;Death&quot;,target=target.id,rattleTarget=event.rattleTarget}})
    elseif event.damageType==&quot;Normal&quot; and target.id==&quot;zhe_jing&quot; then
        prepend(state,{{kind=&quot;Damage&quot;,source=target.id,target=event.source,amount=Config.damage.reflection,damageType=&quot;Reflection&quot;}})
    end
end
drain=function(state)
    while #state.queue&gt;0 do
        local event=table.remove(state.queue,1)
        if event.kind==&quot;Damage&quot; then damage(state,event)
        elseif event.kind==&quot;Death&quot; then death(state,event)
        elseif event.kind==&quot;Link&quot; then
            local link=state.link
            if link and link.active and link.owner==event.owner and link.allyId==event.target then
                link.active=false
                emit(state,&quot;LinkTrigger&quot;,{source=event.target,target=link.enemyId})
                prepend(state,{{kind=&quot;Death&quot;,target=link.enemyId}})
            end
        elseif event.kind==&quot;Rattle&quot; then
            local enemies=living(state,other(event.owner))
            if #enemies&gt;0 then
                local target,targetOwner=get(state,event.target)
                if target and target.alive and targetOwner~=event.owner then
                    prepend(state,{{kind=&quot;Damage&quot;,source=event.source,target=target.id,amount=Config.damage.deathRattle,damageType=&quot;DeathRattle&quot;}})
                else
                    state.pending={owner=event.owner,source=event.source}
                    state.phase=&quot;DeathRattleChoice&quot;;state.actor=event.owner
                    return
                end
            end
        elseif event.kind==&quot;FinalSecond&quot; then
            local first=get(state,event.first)
            if first and not first.alive and event.target then
                prepend(state,{{kind=&quot;Damage&quot;,source=event.source,target=event.target,amount=Config.damage.finalSecond,damageType=&quot;Skill&quot;}})
            end
        end
    end
    if checkWin(state) then return end
    if state.resume==&quot;AfterAttack&quot; then finishAction(state)
    else state.phase=state.resume;state.actor=state.actionOwner or state.actor end
end
function Combat.beginRound(state)
    state.turnSlot=1;state.actionOwner=state.initiative
    startAction(state,state.initiative)
end
local function enemyTarget(state,owner,id)
    local h,side=get(state,id)
    return h and h.alive and side==other(owner)
end
local function resolveAttack(state,blocker)
    local attack=state.attack
    local h=get(state,attack.attackerId)
    local def=defs[h.id]
    state.queue={};state.resume=&quot;AfterAttack&quot;;state.phase=&quot;Resolving&quot;;state.actor=attack.owner;state.actionOwner=attack.owner
    if attack.useSkill then h.cooldown=def.skill.cooldown;emit(state,&quot;Skill&quot;,{source=h.id,code=def.skill.code}) end
    for _,id in ipairs(attack.targets) do
        table.insert(state.queue,{kind=&quot;Damage&quot;,source=h.id,target=id,amount=h.atk,damageType=&quot;Normal&quot;,blocker=blocker,execute=attack.useSkill and h.id==&quot;ting_sun&quot;})
    end
    drain(state)
end
function Combat.apply(state,owner,intent)
    if state.phase==&quot;DeathRattleChoice&quot; and intent.kind==&quot;DeathRattleTarget&quot; then
        if owner~=state.pending.owner then return false,&quot;WrongActor&quot; end
        if not enemyTarget(state,owner,intent.targetId) then return false,&quot;InvalidEnemy&quot; end
        prepend(state,{{kind=&quot;Damage&quot;,source=state.pending.source,target=intent.targetId,amount=Config.damage.deathRattle,damageType=&quot;DeathRattle&quot;}})
        state.pending=nil;state.phase=&quot;Resolving&quot;;drain(state);return true
    end
    if state.actor~=owner then return false,&quot;WrongActor&quot; end
    if state.phase==&quot;SkillPhase&quot; and intent.kind==&quot;SkillEnd&quot; then state.phase=&quot;AttackSelect&quot;;return true end
    if state.phase==&quot;SkillPhase&quot; and intent.kind==&quot;SkillCast&quot; then
        local caster,side=get(state,intent.casterId)
        if not caster or not caster.alive or side~=owner then return false,&quot;InvalidCaster&quot; end
        if caster.cooldown&gt;0 or caster.used or caster.statuses.blocked then return false,&quot;SkillUnavailable&quot; end
        local code=defs[caster.id].skill.code
        if code~=&quot;group_heal&quot; and code~=&quot;stasis_lock&quot; and code~=&quot;final_barrage&quot; and code~=&quot;overload_explode&quot; then return false,&quot;WrongSkillTiming&quot; end
        if code==&quot;stasis_lock&quot; or code==&quot;final_barrage&quot; then
            if not enemyTarget(state,owner,intent.targetId) then return false,&quot;InvalidEnemy&quot; end
        end
        if code==&quot;final_barrage&quot; then
            local enemies=living(state,other(owner))
            if #enemies&gt;1 and (not enemyTarget(state,owner,intent.secondTargetId) or intent.secondTargetId==intent.targetId) then return false,&quot;InvalidSecondTarget&quot; end
        end
        if code==&quot;overload_explode&quot; and intent.targetId~=nil and not enemyTarget(state,owner,intent.targetId) then return false,&quot;InvalidEnemy&quot; end
        emit(state,&quot;Skill&quot;,{source=caster.id,code=code})
        state.queue={};state.actionOwner=owner;state.resume=&quot;SkillPhase&quot;;state.phase=&quot;Resolving&quot;
        if code==&quot;group_heal&quot; then
            for _,h in ipairs(living(state,owner)) do
                local amount=math.min(Config.healing,h.maxHp-h.hp);h.hp+=amount
                if amount&gt;0 then emit(state,&quot;Heal&quot;,{source=caster.id,target=h.id,amount=amount}) end
            end
            caster.cooldown=defs[caster.id].skill.cooldown
        elseif code==&quot;stasis_lock&quot; then
            get(state,intent.targetId).statuses.blocked=true;caster.cooldown=defs[caster.id].skill.cooldown
            emit(state,&quot;Lock&quot;,{source=caster.id,target=intent.targetId})
        elseif code==&quot;overload_explode&quot; then
            table.insert(state.queue,{kind=&quot;Death&quot;,target=caster.id,rattleTarget=intent.targetId})
        else
            caster.used=true
            table.insert(state.queue,{kind=&quot;Damage&quot;,source=caster.id,target=intent.targetId,amount=Config.damage.finalFirst,damageType=&quot;Skill&quot;})
            table.insert(state.queue,{kind=&quot;FinalSecond&quot;,source=caster.id,first=intent.targetId,target=intent.secondTargetId})
        end
        drain(state);return true
    end
    if state.phase==&quot;AttackSelect&quot; and intent.kind==&quot;AttackCommit&quot; then
        local attacker,side=get(state,intent.attackerId)
        if not attacker or not attacker.alive or side~=owner then return false,&quot;InvalidAttacker&quot; end
        if type(intent.targets)~=&quot;table&quot; or #intent.targets&lt;1 or #intent.targets&gt;2 then return false,&quot;InvalidTargets&quot; end
        local use=intent.useSkill==true
        local def=defs[attacker.id]
        local double=use and (attacker.id==&quot;shuang_xing&quot; or attacker.id==&quot;beng_yue&quot;)
        if use and (attacker.cooldown&gt;0 or def.skill.type~=&quot;active_attack_phase&quot;) then return false,&quot;SkillUnavailable&quot; end
        if #intent.targets~=(double and 2 or 1) then return false,&quot;InvalidTargets&quot; end
        if use and attacker.id==&quot;shuang_xing&quot; and intent.targets[1]==intent.targets[2] then return false,&quot;DistinctTargetsRequired&quot; end
        for _,id in ipairs(intent.targets) do if not enemyTarget(state,owner,id) then return false,&quot;InvalidEnemy&quot; end end
        state.attack={owner=owner,attackerId=attacker.id,targets=table.clone(intent.targets),useSkill=use}
        state.phase=&quot;BlockSelect&quot;;state.actor=other(owner)
        emit(state,&quot;AttackCommitted&quot;,{owner=owner}) -- No hidden attacker/target in public event.
        if #living(state,other(owner))==1 then resolveAttack(state,nil) end
        return true
    end
    if state.phase==&quot;BlockSelect&quot; and intent.kind==&quot;BlockCommit&quot; then
        if intent.blockerId~=nil then
            local h,side=get(state,intent.blockerId)
            if not h or not h.alive or side~=owner then return false,&quot;InvalidBlocker&quot; end
        end
        resolveAttack(state,intent.blockerId);return true
    end
    return false,&quot;WrongPhase&quot;
end
return Combat
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX684"><Properties><string name="Name">BattleReport</string><ProtectedString name="Source">-- Derived on the server after terminal resolution; never accepts client statistics.
local Config=require(game:GetService(&quot;ReplicatedStorage&quot;).DeadlockShared.LegacyConfig)
local Report={}
local function totals()
    return {damage=0,healing=0,blocks=0,executions=0,links=0,skills=0,survivors=0,hp=0}
end
function Report.build(state)
    assert(state.phase==&quot;GameOver&quot;,&quot;Report requires terminal state&quot;)
    local result={schemaVersion=1,winner=state.winner,finalRound=state.round,completedRounds=0,teams={A=totals(),B=totals()},rounds={}}
    local owners,roundMap={},{}
    for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do for _,h in ipairs(state.rosters[side]) do
        owners[h.id]=side
        if h.alive then result.teams[side].survivors+=1;result.teams[side].hp+=h.hp end
    end end
    for _,e in ipairs(state.events) do
        if e.round&lt;1 then continue end
        local row=roundMap[e.round]
        if not row then row={round=e.round,ties=0,teams={A=totals(),B=totals()},fallen={}};roundMap[e.round]=row;table.insert(result.rounds,row) end
        local side=owners[e.source]
        local key,amount
        if e.kind==&quot;Damage&quot; then key=&quot;damage&quot;;amount=e.effective
        elseif e.kind==&quot;Heal&quot; then key=&quot;healing&quot;;amount=e.amount
        elseif e.kind==&quot;Block&quot; then key=&quot;blocks&quot;;amount=1;side=owners[e.target]
        elseif e.kind==&quot;Execute&quot; then key=&quot;executions&quot;;amount=1
        elseif e.kind==&quot;LinkTrigger&quot; then key=&quot;links&quot;;amount=1
        elseif e.kind==&quot;Skill&quot; then key=&quot;skills&quot;;amount=1
        elseif e.kind==&quot;Death&quot; then table.insert(row.fallen,{id=e.target,owner=owners[e.target]})
        elseif e.kind==&quot;RoundEnd&quot; then result.completedRounds+=1;row.completed=true
        elseif e.kind==&quot;CoreTie&quot; then row.ties+=1
        elseif e.kind==&quot;CoreReveal&quot; and e.A~=e.B then row.initiative=Config.beats[e.A]==e.B and &quot;A&quot; or &quot;B&quot;;row.cores={A=e.A,B=e.B}
        end
        if key and side then result.teams[side][key]+=amount;row.teams[side][key]+=amount end
    end
    local turning
    for _,row in ipairs(result.rounds) do
        if not turning or #row.fallen&gt;#turning.fallen or (#row.fallen==#turning.fallen and row.teams.A.damage+row.teams.B.damage&gt;turning.teams.A.damage+turning.teams.B.damage) then turning=row end
    end
    if turning then result.turningRound=turning.round;result.turningDeaths=#turning.fallen end
    return result
end
return Report
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX685"><Properties><string name="Name">BattleReportTests</string><ProtectedString name="Source">return function()
    local Report=require(script.Parent.BattleReport)
    local state={phase=&quot;GameOver&quot;,winner=&quot;A&quot;,round=2,rosters={A={{id=&quot;ting_sun&quot;,alive=true,hp=7},{id=&quot;bai_ji&quot;,alive=true,hp=23}},B={{id=&quot;yan_wei&quot;,alive=false,hp=0},{id=&quot;huan_shi&quot;,alive=false,hp=0}}},events={
        {kind=&quot;CoreReveal&quot;,round=1,A=&quot;red&quot;,B=&quot;red&quot;},{kind=&quot;CoreTie&quot;,round=1},{kind=&quot;CoreReveal&quot;,round=1,A=&quot;cyan&quot;,B=&quot;purple&quot;},
        {kind=&quot;Damage&quot;,round=1,source=&quot;ting_sun&quot;,target=&quot;yan_wei&quot;,amount=8,effective=5},
        {kind=&quot;Death&quot;,round=1,target=&quot;yan_wei&quot;,owner=&quot;B&quot;},
        {kind=&quot;Damage&quot;,round=1,source=&quot;yan_wei&quot;,target=&quot;ting_sun&quot;,amount=15,effective=15},
        {kind=&quot;Heal&quot;,round=1,source=&quot;bai_ji&quot;,target=&quot;ting_sun&quot;,amount=3},
        {kind=&quot;Block&quot;,round=1,source=&quot;huan_shi&quot;,target=&quot;bai_ji&quot;},{kind=&quot;RoundEnd&quot;,round=1},
        {kind=&quot;Execute&quot;,round=2,source=&quot;ting_sun&quot;,target=&quot;huan_shi&quot;},{kind=&quot;Death&quot;,round=2,target=&quot;huan_shi&quot;,owner=&quot;B&quot;},
    }}
    local r=Report.build(state);local count=0
    local function check(v,label) assert(v,label);count+=1 end
    check(r.teams.A.damage==5,&quot;Overkill must not inflate effective damage&quot;)
    check(r.teams.B.damage==15,&quot;Dead caster's rattle belongs to its team&quot;)
    check(r.teams.A.healing==3,&quot;Only effective heal events count&quot;)
    check(r.teams.A.blocks==1 and r.teams.B.blocks==0,&quot;Block belongs to defender&quot;)
    check(r.teams.A.executions==1 and r.teams.A.damage==5,&quot;Execution separate from normal damage&quot;)
    check(r.completedRounds==1 and r.finalRound==2,&quot;Terminal partial round is not completed&quot;)
    check(r.rounds[1].ties==1 and r.rounds[1].initiative==&quot;A&quot;,&quot;Tie retry stays in same round&quot;)
    check(r.teams.A.survivors==2 and r.teams.A.hp==30,&quot;Survivors use terminal roster&quot;)
    check(r.turningRound==1 and r.turningDeaths==1,&quot;Turning round ranks deaths then effective damage&quot;)
    local ok=pcall(Report.build,{phase=&quot;SkillPhase&quot;});check(not ok,&quot;No premature report&quot;)
    state.winner=&quot;Draw&quot;;check(Report.build(state).winner==&quot;Draw&quot;,&quot;Draw remains distinct&quot;)
    print(&quot;FIRST_MOVE_REPORT: &quot;..count..&quot; assertions passed&quot;)
    return count
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX686"><Properties><string name="Name">MatchRules</string><ProtectedString name="Source">local Opening=require(script.Parent.OpeningRules)
local Combat=require(script.Parent.CombatRules)
local Report=require(script.Parent.BattleReport)
local Match={new=Opening.new}
function Match.apply(state,owner,intent)
    if owner~=&quot;A&quot; and owner~=&quot;B&quot; then return false,&quot;InvalidOwner&quot; end
    if type(intent)~=&quot;table&quot; or intent.revision~=state.revision then return false,&quot;StaleRevision&quot; end
    if state.phase==&quot;Draft&quot; or state.phase==&quot;LinkSetup&quot; or state.phase==&quot;CoreSelection&quot; then
        local ok,err=Opening.apply(state,owner,intent)
        if ok and state.phase==&quot;SkillPhase&quot; then Combat.beginRound(state) end
        return ok,err
    end
    local ok,err=Combat.apply(state,owner,intent)
    if ok then state.revision+=1 end
    return ok,err
end
function Match.view(state,owner)
    local view=Opening.view(state,owner)
    view.winner=state.winner
    if state.phase==&quot;GameOver&quot; then view.report=Report.build(state) end
    if state.pending then view.choice={owner=state.pending.owner,source=state.pending.source} end
    if state.attack and state.attack.owner==owner then
        view.ownAttack={attackerId=state.attack.attackerId,targets=table.clone(state.attack.targets),useSkill=state.attack.useSkill}
    end
    for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do
        for i,h in ipairs(state.rosters[side]) do view.rosters[side][i].statuses=table.clone(h.statuses) end
    end
    return view
end
return Match
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX687"><Properties><string name="Name">StandardAI</string><ProtectedString name="Source">-- Input is the same projected view a player receives; no private state reference.
local Config=require(game:GetService(&quot;ReplicatedStorage&quot;).DeadlockShared.LegacyConfig)
local defs={}
for _,h in ipairs(Config.heroes) do defs[h.id]=h end
local AI={}
local function alive(roster)
    local list={};for _,h in ipairs(roster) do if h.alive then table.insert(list,h) end end;return list
end
local function weakest(list)
    local best=list[1];for _,h in ipairs(list) do if h.hp&lt;best.hp then best=h end end;return best
end
function AI.intent(view,owner,rng)
    local enemy=owner==&quot;A&quot; and &quot;B&quot; or &quot;A&quot;
    local allies=alive(view.rosters[owner]);local enemies=alive(view.rosters[enemy])
    local function answer(kind,fields)
        fields=fields or {};fields.kind=kind;fields.revision=view.revision;return fields
    end
    if view.phase==&quot;Draft&quot; and view.actor==owner then
        local taken={};for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do for _,h in ipairs(view.rosters[side]) do taken[h.id]=true end end
        local best,score
        for _,h in ipairs(Config.heroes) do
            local value=h.atk+h.maxHp*.20+rng:NextNumber(0,5)
            if h.id==&quot;ting_sun&quot; or h.id==&quot;xuan_bao&quot; then value+=2 end
            if not taken[h.id] and (not score or value&gt;score) then best=h;score=value end
        end
        return answer(&quot;DraftPick&quot;,{heroId=best.id})
    end
    if view.phase==&quot;LinkSetup&quot; and view.actor==owner then
        local ally
        for _,h in ipairs(allies) do if h.id~=&quot;ye_ban&quot; and (not ally or h.maxHp&lt;ally.maxHp) then ally=h end end
        local target=enemies[1]
        for _,h in ipairs(enemies) do if h.atk&gt;target.atk then target=h end end
        return answer(&quot;LinkConfirm&quot;,{allyId=ally.id,enemyId=target.id})
    end
    if view.phase==&quot;CoreSelection&quot; and not view.coreLocked[owner] then
        local cores={&quot;cyan&quot;,&quot;red&quot;,&quot;purple&quot;}
        return answer(&quot;CoreLock&quot;,{core=cores[rng:NextInteger(1,3)]})
    end
    if view.actor~=owner then return nil end
    if view.phase==&quot;DeathRattleChoice&quot; then return answer(&quot;DeathRattleTarget&quot;,{targetId=weakest(enemies).id}) end
    if view.phase==&quot;SkillPhase&quot; then
        for _,h in ipairs(allies) do
            if h.cooldown==0 and not h.used and not h.statuses.blocked then
                local code=defs[h.id].skill.code
                if code==&quot;group_heal&quot; then
                    local missing=0;for _,a in ipairs(allies) do missing+=math.min(Config.healing,a.maxHp-a.hp) end
                    if missing&gt;=4 then return answer(&quot;SkillCast&quot;,{casterId=h.id}) end
                elseif code==&quot;final_barrage&quot; and weakest(enemies).hp&lt;=Config.damage.finalFirst then
                    local first=weakest(enemies);local second
                    for _,e in ipairs(enemies) do if e.id~=first.id and (not second or e.hp&lt;second.hp) then second=e end end
                    return answer(&quot;SkillCast&quot;,{casterId=h.id,targetId=first.id,secondTargetId=second and second.id})
                elseif code==&quot;stasis_lock&quot; then
                    local target
                    for _,e in ipairs(enemies) do
                        local skill=defs[e.id].skill
                        if not e.statuses.blocked and e.cooldown==0 and not skill.isPassive and skill.triggerTiming==&quot;active&quot; then target=e;break end
                    end
                    if target then return answer(&quot;SkillCast&quot;,{casterId=h.id,targetId=target.id}) end
                elseif code==&quot;overload_explode&quot; and h.hp&lt;=5 then
                    return answer(&quot;SkillCast&quot;,{casterId=h.id,targetId=weakest(enemies).id})
                end
            end
        end
        return answer(&quot;SkillEnd&quot;)
    end
    if view.phase==&quot;AttackSelect&quot; then
        local best,score,use,targets
        for _,h in ipairs(allies) do
            for _,e in ipairs(enemies) do
                local damage=e.id==&quot;lan_dun&quot; and math.min(h.atk,Config.normalDamageCap) or h.atk
                local active=h.cooldown==0 and defs[h.id].skill.type==&quot;active_attack_phase&quot;
                if h.id==&quot;shuang_xing&quot; and #enemies&lt;2 then active=false end
                local value=math.min(e.hp,damage)+(e.hp&lt;=damage and 8 or 0)+rng:NextNumber(0,4)
                if h.id==&quot;huan_shi&quot; then value+=2 end
                if h.id==&quot;xuan_bao&quot; and not e.statuses.bleeding then value+=2 end
                if e.id==&quot;zhe_jing&quot; and e.hp&gt;damage then value-=3 end
                if active then value+=h.id==&quot;ting_sun&quot; and e.hp*.65 or damage end
                if not score or value&gt;score then
                    best=h;score=value;use=active;targets={e.id}
                    if active and h.id==&quot;beng_yue&quot; then table.insert(targets,e.id)
                    elseif active and h.id==&quot;shuang_xing&quot; then
                        for _,second in ipairs(enemies) do if second.id~=e.id then table.insert(targets,second.id);break end end
                    end
                end
            end
        end
        return answer(&quot;AttackCommit&quot;,{attackerId=best.id,targets=targets,useSkill=use})
    end
    if view.phase==&quot;BlockSelect&quot; then
        -- Mix protecting a threatened unit with unpredictable legal choices.
        local target=rng:NextNumber()&lt;.70 and weakest(allies) or allies[rng:NextInteger(1,#allies)]
        return answer(&quot;BlockCommit&quot;,{blockerId=target.id})
    end
end
return AI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX688"><Properties><string name="Name">CombatTests</string><ProtectedString name="Source">local Match=require(script.Parent.MatchRules)
local AI=require(script.Parent.StandardAI)
local Config=require(game:GetService(&quot;ReplicatedStorage&quot;).DeadlockShared.LegacyConfig)
local defs={};for _,h in ipairs(Config.heroes) do defs[h.id]=h end
return function()
    local count=0
    local function check(value,label) assert(value,&quot;FIRST_MOVE_COMBAT: &quot;..label);count+=1 end
    local function fixture(a,b)
        local state=Match.new();state.phase=&quot;SkillPhase&quot;;state.round=1;state.actor=&quot;A&quot;;state.actionOwner=&quot;A&quot;;state.initiative=&quot;A&quot;;state.turnSlot=1
        state.draftStep=7;state.picksRemaining=0
        for owner,ids in pairs({A=a,B=b}) do
            for _,id in ipairs(ids) do
                local h=defs[id];table.insert(state.rosters[owner],{id=id,hp=h.maxHp,maxHp=h.maxHp,atk=h.atk,cooldown=0,alive=true,used=false,statuses={}})
            end
        end
        return state
    end
    local function hero(state,id)
        for _,owner in ipairs({&quot;A&quot;,&quot;B&quot;}) do for _,h in ipairs(state.rosters[owner]) do if h.id==id then return h end end end
    end
    local function act(state,owner,kind,fields)
        fields=fields or {};fields.kind=kind;fields.revision=state.revision
        local ok,err=Match.apply(state,owner,fields);assert(ok,&quot;FIRST_MOVE_COMBAT action &quot;..kind..&quot;: &quot;..tostring(err))
    end
    local function attack(state,id,targets,use,blocker)
        act(state,&quot;A&quot;,&quot;SkillEnd&quot;);act(state,&quot;A&quot;,&quot;AttackCommit&quot;,{attackerId=id,targets=targets,useSkill=use})
        if state.phase==&quot;BlockSelect&quot; then act(state,&quot;B&quot;,&quot;BlockCommit&quot;,{blockerId=blocker}) end
    end
    local s=fixture({&quot;ting_sun&quot;},{&quot;lan_dun&quot;,&quot;zhe_jing&quot;})
    attack(s,&quot;ting_sun&quot;,{&quot;lan_dun&quot;},false,&quot;lan_dun&quot;)
    check(hero(s,&quot;lan_dun&quot;).hp==26 and s.actor==&quot;B&quot;,&quot;self block negates normal hit; second actor begins&quot;)
    s=fixture({&quot;huan_shi&quot;},{&quot;lan_dun&quot;,&quot;zhe_jing&quot;})
    attack(s,&quot;huan_shi&quot;,{&quot;lan_dun&quot;},false,&quot;lan_dun&quot;)
    check(hero(s,&quot;lan_dun&quot;).hp==23,&quot;unblockable attack still respects normal cap&quot;)
    s=fixture({&quot;ting_sun&quot;,&quot;bai_ji&quot;},{&quot;zhe_jing&quot;,&quot;lan_dun&quot;});hero(s,&quot;ting_sun&quot;).hp=4
    attack(s,&quot;ting_sun&quot;,{&quot;zhe_jing&quot;},false,nil)
    check(not hero(s,&quot;ting_sun&quot;).alive and hero(s,&quot;zhe_jing&quot;).hp==14,&quot;surviving mirror reflects and kills attacker&quot;)
    s=fixture({&quot;ting_sun&quot;},{&quot;zhe_jing&quot;})
    attack(s,&quot;ting_sun&quot;,{&quot;zhe_jing&quot;},true,nil)
    check(s.phase==&quot;GameOver&quot; and s.winner==&quot;A&quot; and hero(s,&quot;ting_sun&quot;).hp==22,&quot;execute skips normal damage/reflection; last defender auto resolves&quot;)
    s=fixture({&quot;ting_sun&quot;,&quot;bai_ji&quot;},{&quot;lan_dun&quot;,&quot;zhe_jing&quot;})
    attack(s,&quot;ting_sun&quot;,{&quot;lan_dun&quot;},true,&quot;lan_dun&quot;)
    check(hero(s,&quot;ting_sun&quot;).cooldown==5 and hero(s,&quot;lan_dun&quot;).alive,&quot;blocked execute consumes cooldown&quot;)
    s=fixture({&quot;beng_yue&quot;},{&quot;yan_wei&quot;,&quot;lan_dun&quot;});hero(s,&quot;yan_wei&quot;).hp=8
    attack(s,&quot;beng_yue&quot;,{&quot;yan_wei&quot;,&quot;lan_dun&quot;},true,nil)
    check(s.phase==&quot;DeathRattleChoice&quot; and hero(s,&quot;lan_dun&quot;).hp==26,&quot;multi attack pauses before second segment&quot;)
    local rev=s.revision
    check(not Match.apply(s,&quot;A&quot;,{kind=&quot;DeathRattleTarget&quot;,targetId=&quot;beng_yue&quot;,revision=rev}) and s.revision==rev,&quot;wrong owner cannot resolve rattle&quot;)
    act(s,&quot;B&quot;,&quot;DeathRattleTarget&quot;,{targetId=&quot;beng_yue&quot;})
    check(hero(s,&quot;beng_yue&quot;).hp==7 and hero(s,&quot;lan_dun&quot;).hp==23 and hero(s,&quot;beng_yue&quot;).cooldown==3,&quot;rattle and remaining segment resolve once&quot;)
    s=fixture({&quot;yan_wei&quot;,&quot;ye_ban&quot;,&quot;bai_ji&quot;},{&quot;lan_dun&quot;,&quot;zhe_jing&quot;,&quot;chi_guang&quot;});hero(s,&quot;lan_dun&quot;).hp=10
    s.link={owner=&quot;A&quot;,allyId=&quot;yan_wei&quot;,enemyId=&quot;zhe_jing&quot;,active=true}
    act(s,&quot;A&quot;,&quot;SkillCast&quot;,{casterId=&quot;yan_wei&quot;,targetId=&quot;lan_dun&quot;})
    check(not hero(s,&quot;lan_dun&quot;).alive and not hero(s,&quot;zhe_jing&quot;).alive and not s.link.active,&quot;lethal rattle preserves originating death link continuation&quot;)
    s=fixture({&quot;xuan_bao&quot;,&quot;bai_ji&quot;},{&quot;yan_wei&quot;,&quot;lan_dun&quot;});hero(s,&quot;yan_wei&quot;).hp=3
    hero(s,&quot;yan_wei&quot;).statuses.bleeding=true;hero(s,&quot;lan_dun&quot;).statuses.bleeding=true;s.phase=&quot;CoreSelection&quot;;s.actor=nil
    act(s,&quot;A&quot;,&quot;CoreLock&quot;,{core=&quot;cyan&quot;});act(s,&quot;B&quot;,&quot;CoreLock&quot;,{core=&quot;purple&quot;})
    check(s.phase==&quot;DeathRattleChoice&quot;,&quot;bleeding death requests a target&quot;)
    act(s,&quot;B&quot;,&quot;DeathRattleTarget&quot;,{targetId=&quot;xuan_bao&quot;})
    check(hero(s,&quot;lan_dun&quot;).hp==23 and s.phase==&quot;SkillPhase&quot; and s.actor==&quot;A&quot;,&quot;bleeding resumes remaining targets and original actor&quot;)
    s=fixture({&quot;zhui_lie&quot;},{&quot;yan_wei&quot;,&quot;lan_dun&quot;});hero(s,&quot;yan_wei&quot;).hp=8
    act(s,&quot;A&quot;,&quot;SkillCast&quot;,{casterId=&quot;zhui_lie&quot;,targetId=&quot;yan_wei&quot;,secondTargetId=&quot;lan_dun&quot;})
    check(s.phase==&quot;DeathRattleChoice&quot;,&quot;final barrage pauses after first kill&quot;)
    act(s,&quot;B&quot;,&quot;DeathRattleTarget&quot;,{targetId=&quot;zhui_lie&quot;})
    check(hero(s,&quot;lan_dun&quot;).hp==16 and hero(s,&quot;zhui_lie&quot;).used,&quot;final second resumes after rattle, bypasses normal cap&quot;)
    s=fixture({&quot;zhui_lie&quot;},{&quot;lan_dun&quot;});hero(s,&quot;lan_dun&quot;).hp=8
    act(s,&quot;A&quot;,&quot;SkillCast&quot;,{casterId=&quot;zhui_lie&quot;,targetId=&quot;lan_dun&quot;})
    check(s.phase==&quot;GameOver&quot; and s.winner==&quot;A&quot;,&quot;skill kill last enemy applies immediate victory&quot;)
    s=fixture({&quot;yan_wei&quot;},{&quot;lan_dun&quot;});hero(s,&quot;lan_dun&quot;).hp=15
    act(s,&quot;A&quot;,&quot;SkillCast&quot;,{casterId=&quot;yan_wei&quot;,targetId=&quot;lan_dun&quot;})
    check(s.winner==&quot;Draw&quot;,&quot;full simultaneous death chain produces draw&quot;)
    s=fixture({&quot;chi_guang&quot;,&quot;bai_ji&quot;},{&quot;lan_dun&quot;,&quot;zhe_jing&quot;})
    local revision=s.revision
    check(not Match.apply(s,&quot;A&quot;,{kind=&quot;SkillCast&quot;,casterId=&quot;chi_guang&quot;,targetId=&quot;bai_ji&quot;,revision=revision}) and s.revision==revision and hero(s,&quot;chi_guang&quot;).cooldown==0,&quot;allied skill target rejected atomically&quot;)
    act(s,&quot;A&quot;,&quot;SkillEnd&quot;);act(s,&quot;A&quot;,&quot;AttackCommit&quot;,{attackerId=&quot;chi_guang&quot;,targets={&quot;lan_dun&quot;}})
    local view=Match.view(s,&quot;B&quot;)
    check(view.ownAttack==nil and view.attack==nil and view.queue==nil and view.events[#view.events].source==nil,&quot;attack intent and queue hidden from defender&quot;)
    s=fixture({&quot;bai_ji&quot;,&quot;lan_dun&quot;},{&quot;zhe_jing&quot;,&quot;chi_guang&quot;});hero(s,&quot;lan_dun&quot;).hp=24
    act(s,&quot;A&quot;,&quot;SkillCast&quot;,{casterId=&quot;bai_ji&quot;})
    check(hero(s,&quot;lan_dun&quot;).hp==26 and hero(s,&quot;bai_ji&quot;).cooldown==3,&quot;healing clamps to max&quot;)
    attack(s,&quot;lan_dun&quot;,{&quot;chi_guang&quot;},false,nil)
    act(s,&quot;B&quot;,&quot;SkillEnd&quot;);act(s,&quot;B&quot;,&quot;AttackCommit&quot;,{attackerId=&quot;chi_guang&quot;,targets={&quot;lan_dun&quot;}});act(s,&quot;A&quot;,&quot;BlockCommit&quot;,{blockerId=&quot;lan_dun&quot;})
    check(s.round==2 and s.phase==&quot;CoreSelection&quot; and hero(s,&quot;bai_ji&quot;).cooldown==2,&quot;round end decrements newly used cooldown&quot;)
    -- Complete public-view-only games: catches deadlocks and illegal AI intents.
    local reports={}
    for seed=1,30 do
        local gameState=Match.new();local rng=Random.new(seed);local steps=0
        check(Match.view(gameState,&quot;A&quot;).report==nil,&quot;report unavailable before terminal&quot;)
        while gameState.phase~=&quot;GameOver&quot; and steps&lt;2500 do
            local owner=gameState.phase==&quot;CoreSelection&quot; and (gameState.cores.A and &quot;B&quot; or &quot;A&quot;) or (gameState.phase==&quot;Draft&quot; and Config.draft[gameState.draftStep].player or gameState.actor or gameState.linkOwner)
            local intent=AI.intent(Match.view(gameState,owner),owner,rng)
            check(intent~=nil,&quot;AI has legal phase intent seed &quot;..seed)
            local ok,err=Match.apply(gameState,owner,intent)
            check(ok,&quot;AI intent accepted seed &quot;..seed..&quot;: &quot;..tostring(err))
            steps+=1
            for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do for _,h in ipairs(gameState.rosters[side]) do check(h.hp&gt;=0 and h.hp&lt;=h.maxHp and h.alive==(h.hp&gt;0),&quot;health invariant&quot;) end end
        end
        check(gameState.phase==&quot;GameOver&quot;,&quot;seed &quot;..seed..&quot; finishes without timeout&quot;)
        local report=Match.view(gameState,&quot;A&quot;).report
        check(report.winner==gameState.winner and report.finalRound==gameState.round,&quot;report describes terminal result&quot;)
        check(report.completedRounds==gameState.round-1,&quot;partial final round excluded from completed count&quot;)
        for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do
            local sum=0;for _,row in ipairs(report.rounds) do sum+=row.teams[side].damage end
            check(sum==report.teams[side].damage,&quot;round damage reconciles with team total&quot;)
        end
        table.insert(reports,{seed=seed,rounds=gameState.round,winner=gameState.winner,steps=steps})
    end
    print(&quot;FIRST_MOVE_COMBAT: &quot;..count..&quot; assertions passed; 30/30 public-view self-play matches completed&quot;)
    print(&quot;FIRST_MOVE_REGRESSION: &quot;..game:GetService(&quot;HttpService&quot;):JSONEncode(reports))
    return count
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX689"><Properties><string name="Name">MatchService</string><ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local ReplicatedStorage=game:GetService(&quot;ReplicatedStorage&quot;)
local HttpService=game:GetService(&quot;HttpService&quot;)
local Rules=require(script.Parent.MatchRules)
local AI=require(script.Parent.AIDirector)
local Data=require(script.Parent.DataService)
local Training=require(script.Parent.TrainingMatch)
local AITuning=require(ReplicatedStorage.DeadlockShared.AIConfig)
local Service={}
local sessions={}
local rates={}
local tuning={Burst=8,RequestsPerSecond=5,AIThink=.75,MaxIdLength=64}
local schemas={DraftPick={heroId=&quot;string&quot;},LinkConfirm={allyId=&quot;string&quot;,enemyId=&quot;string&quot;},CoreLock={core=&quot;string&quot;},SkillEnd={},SkillCast={casterId=&quot;string&quot;,targetId=&quot;string?&quot;,secondTargetId=&quot;string?&quot;},AttackCommit={attackerId=&quot;string&quot;,targets=&quot;targets&quot;,useSkill=&quot;boolean?&quot;},BlockCommit={blockerId=&quot;string?&quot;},DeathRattleTarget={targetId=&quot;string&quot;},TrainingContinue={},TrainingRetry={}}
local function validIntent(intent)
    if type(intent)~=&quot;table&quot; or type(intent.kind)~=&quot;string&quot; or not schemas[intent.kind] then return false end
    if type(intent.revision)~=&quot;number&quot; or intent.revision&lt;0 or intent.revision%1~=0 then return false end
    local schema=schemas[intent.kind]
    for key in pairs(intent) do if key~=&quot;kind&quot; and key~=&quot;revision&quot; and not schema[key] then return false end end
    for key,expected in pairs(schema) do
        local value=intent[key]
        if expected:sub(-1)==&quot;?&quot; and value==nil then continue end
        local basic=expected:gsub(&quot;%?&quot;,&quot;&quot;)
        if basic==&quot;targets&quot; then
            if type(value)~=&quot;table&quot; or #value&lt;1 or #value&gt;2 then return false end
            for index,id in pairs(value) do
                if type(index)~=&quot;number&quot; or index%1~=0 or index&lt;1 or index&gt;#value or type(id)~=&quot;string&quot; or #id&gt;tuning.MaxIdLength then return false end
            end
        elseif type(value)~=basic or (basic==&quot;string&quot; and #value&gt;tuning.MaxIdLength) then return false end
    end
    return true
end
local function clone(value)
    if type(value)~=&quot;table&quot; then return value end
    local result={};for key,item in pairs(value) do result[key]=clone(item) end;return result
end
function Service.start()
    local folder=Instance.new(&quot;Folder&quot;);folder.Name=&quot;DeadlockRemotes&quot;;folder.Parent=ReplicatedStorage
    local intent=Instance.new(&quot;RemoteEvent&quot;);intent.Name=&quot;Intent&quot;;intent.Parent=folder
    local stateEvent=Instance.new(&quot;RemoteEvent&quot;);stateEvent.Name=&quot;State&quot;;stateEvent.Parent=folder
    local waiting={}
    local Projection=require(script.Parent.PlayerProjection)
    local function send(player,member,errorCode,ack,started,synced)
        local match=member.match;local owner=member.owner
        local view=Projection.view(match.state,owner);view.sessionId=match.id;view.difficulty=match.difficulty;view.mode=match.mode
        view.duration=math.floor(os.clock()-match.started)
        if match.training then view.training=Training.model(match.training) end
        if match.mode==&quot;PvP&quot; and match.completed then
            local other=owner==&quot;A&quot; and &quot;B&quot; or &quot;A&quot;;local opponent=match.players[other]
            local present=opponent~=nil and opponent.Parent~=nil and opponent.Parent~=false and sessions[opponent]~=nil and sessions[opponent].match==match
            view.rematch={available=present,requested=match.rematchVotes and match.rematchVotes[owner]==true or false,opponentRequested=match.rematchVotes and match.rematchVotes[other]==true or false}
        end
        if view.report then view.report.readAttempts=match.readAttempts[owner];view.report.readHits=match.readHits[owner] end
        if view.phase==&quot;GameOver&quot; and match.mode~=&quot;Training&quot; then
            for _,entry in ipairs(Data.profile(player).history)do if entry.view.sessionId==match.id then view.reward=entry.reward;break end end
        end
        stateEvent:FireClient(player,{view=view,error=errorCode,ack=ack,started=started,synced=synced})
    end
    local function broadcast(match,actingPlayer,started)
        if match.mode~=&quot;Training&quot; and match.state.phase==&quot;GameOver&quot; and not match.completed then
            match.completed=true
            for owner,p in pairs(match.players) do
                local view=Projection.view(match.state,owner);view.sessionId=match.id;view.mode=match.mode;view.difficulty=match.difficulty;view.duration=math.floor(os.clock()-match.started)
                view.report.readAttempts=match.readAttempts[owner];view.report.readHits=match.readHits[owner]
                Data.complete(p,view,match.mode==&quot;PvP&quot; and &quot;PvP&quot; or match.difficulty,view.duration,match.readAttempts[owner],match.readHits[owner])
            end
        end
        for _,p in pairs(match.players) do if p.Parent and sessions[p] and sessions[p].match==match then send(p,sessions[p],nil,p==actingPlayer,started) end end
    end
    local function cancel(player,left)
        for i=#waiting,1,-1 do if waiting[i]==player then table.remove(waiting,i) end end
        local member=sessions[player]
        if member and member.match.completed then
            local match=member.match;match.players[member.owner]=nil;sessions[player]=nil
            if player.Parent then stateEvent:FireClient(player,{closed=true}) end
            for _,p in pairs(match.players) do if p.Parent and sessions[p] and sessions[p].match==match then send(p,sessions[p]) end end
            return
        end
        if member then local match=member.match;match.cancelled=true;for _,p in pairs(match.players) do
            if sessions[p] and sessions[p].match==match then sessions[p]=nil;if p.Parent then stateEvent:FireClient(p,{closed=true,abandoned=p~=player and not match.completed}) end end
        end end
        if not member and not left and player.Parent then stateEvent:FireClient(player,{closed=true}) end
    end
    local schedule
    schedule=function(match)
        if match.mode~=&quot;AI&quot; or match.cancelled or match.scheduled or match.state.phase==&quot;GameOver&quot; then return end
        local aiIntent=AI.intent(Rules.view(match.state,&quot;B&quot;),&quot;B&quot;,match.rng,match.difficulty)
        if not aiIntent then return end
        match.scheduled=true
        task.delay(AITuning[match.difficulty].think,function()
            match.scheduled=false
            if match.cancelled then return end
            local action=AI.intent(Rules.view(match.state,&quot;B&quot;),&quot;B&quot;,match.rng,match.difficulty)
            if action then
                local nextState=clone(match.state)
                local ok,err=Rules.apply(nextState,&quot;B&quot;,action)
                if not ok then warn(&quot;FIRST_MOVE_AI: rejected &quot;..tostring(err));return end
                if nextState.phase==&quot;CoreSelection&quot; and (match.state.phase~=&quot;CoreSelection&quot; or nextState.round~=match.state.round or (#nextState.events&gt;#match.state.events and (nextState.events[#nextState.events] or {}).kind==&quot;CoreTie&quot;)) then match.coreWindowRevision=nextState.revision end
                match.state=nextState;broadcast(match)
            end
            schedule(match)
        end)
    end
    local function create(players,mode,difficulty)
        local match={id=HttpService:GenerateGUID(false),state=Rules.new(),rng=Random.new(),mode=mode,difficulty=difficulty,players=players,started=os.clock(),readAttempts={A=0,B=0},readHits={A=0,B=0},coreWindowRevision=0}
        if mode==&quot;Training&quot; then match.state,match.training=Training.new() end
        for owner,p in pairs(players) do sessions[p]={match=match,owner=owner} end
        broadcast(match,nil,true);schedule(match)
    end
    intent.OnServerEvent:Connect(function(player,message)
        local now=os.clock();local rate=rates[player] or {time=now,tokens=tuning.Burst}
        rate.tokens=math.min(tuning.Burst,rate.tokens+(now-rate.time)*tuning.RequestsPerSecond);rate.time=now;rates[player]=rate
        if rate.tokens&lt;1 then return end
        rate.tokens-=1
        if type(message)~=&quot;table&quot; or type(message.command)~=&quot;string&quot; then return end
        if message.command==&quot;Start&quot; then
            if sessions[player] then send(player,sessions[player],nil,true,true);return end
            for key in pairs(message) do if key~=&quot;command&quot; and key~=&quot;mode&quot; and key~=&quot;difficulty&quot; then stateEvent:FireClient(player,{startError=&quot;InvalidRequest&quot;});return end end
            local mode=message.mode or &quot;AI&quot;;if mode~=&quot;AI&quot; and mode~=&quot;PvP&quot; and mode~=&quot;Training&quot; then stateEvent:FireClient(player,{startError=&quot;InvalidMode&quot;});return end
            if mode==&quot;PvP&quot; then
                for _,p in ipairs(waiting) do if p==player then stateEvent:FireClient(player,{queued=true});return end end
                local opponent
                while #waiting&gt;0 and not opponent do local candidate=table.remove(waiting,1);if candidate.Parent and not sessions[candidate] and candidate~=player then opponent=candidate end end
                if opponent then create({A=opponent,B=player},&quot;PvP&quot;,&quot;Standard&quot;) else table.insert(waiting,player);stateEvent:FireClient(player,{queued=true}) end
                return
            end
            if mode==&quot;Training&quot; then
                for i=#waiting,1,-1 do if waiting[i]==player then table.remove(waiting,i) end end
                create({A=player},&quot;Training&quot;,&quot;Standard&quot;);return
            end
            local difficulty=message.difficulty or &quot;Standard&quot;
            if not AITuning[difficulty] or (difficulty==&quot;Advanced&quot; and Data.profile(player).stats.gamesPlayed&lt;1) then stateEvent:FireClient(player,{startError=&quot;DifficultyLocked&quot;});return end
            for i=#waiting,1,-1 do if waiting[i]==player then table.remove(waiting,i) end end
            create({A=player},&quot;AI&quot;,difficulty);return
        end
        local member=sessions[player]
        if message.command==&quot;Quit&quot; then if not member or message.sessionId==nil or message.sessionId==member.match.id then cancel(player,false) end;return end
        if not member or message.sessionId~=member.match.id then return end
        if message.command==&quot;Sync&quot; then send(player,member,nil,false,false,true);return end
        local match=member.match;local owner=member.owner
        if message.command==&quot;Restart&quot; then
            for key in pairs(message) do if key~=&quot;command&quot; and key~=&quot;sessionId&quot; and key~=&quot;accept&quot; then send(player,member,&quot;InvalidRequest&quot;,true);return end end
            if not match.completed then send(player,member,&quot;WrongPhase&quot;,true);return end
            if match.mode==&quot;PvP&quot; then
                if type(message.accept)~=&quot;boolean&quot; then send(player,member,&quot;InvalidRequest&quot;,true);return end
                local other=owner==&quot;A&quot; and &quot;B&quot; or &quot;A&quot;;local opponent=match.players[other]
                if not opponent or not opponent.Parent or not sessions[opponent] or sessions[opponent].match~=match then send(player,member,&quot;OpponentUnavailable&quot;,true);return end
                match.rematchVotes=match.rematchVotes or {};match.rematchVotes[owner]=message.accept
                if match.rematchVotes.A and match.rematchVotes.B then
                    local players={A=match.players.B,B=match.players.A};match.players={};match.cancelled=true
                    create(players,&quot;PvP&quot;,&quot;Standard&quot;)
                else broadcast(match,player) end
                return
            end
            if match.mode~=&quot;AI&quot; then send(player,member,&quot;WrongPhase&quot;,true);return end
            if message.accept~=nil then send(player,member,&quot;InvalidRequest&quot;,true);return end
            match.players[owner]=nil;sessions[player]=nil
            create({A=player},&quot;AI&quot;,match.difficulty);return
        end
        if message.command~=&quot;Action&quot; or not validIntent(message.intent) then send(player,member,&quot;InvalidIntent&quot;,true);return end
        local action=clone(message.intent)
        if match.mode==&quot;Training&quot; then
            local nextState,nextTraining=clone(match.state),clone(match.training)
            local ok,result=Training.apply(nextState,nextTraining,action)
            if ok then
                if result==&quot;Retry&quot; then nextState,nextTraining=Training.new(match.state.revision+1)
                elseif result==&quot;BlockRead&quot; then Data.learning(player,&quot;blockChosen&quot;);Data.learning(player,&quot;blockRead&quot;)
                elseif result==&quot;BlockChosen&quot; then Data.learning(player,&quot;blockChosen&quot;)
                elseif result==&quot;SkillUsed&quot; then Data.learning(player,&quot;skillUsed&quot;)
                elseif result==&quot;AttackCommitted&quot; then Data.learning(player,&quot;attackCommitted&quot;) end
                match.state,match.training=nextState,nextTraining;broadcast(match,player)
            else send(player,member,result,true) end
            return
        end
        -- Both secret core choices may arrive at the same revision. Rebase only within
        -- this core window; a tie/new round starts a new window and rejects old choices.
        if action.kind==&quot;CoreLock&quot; and match.state.phase==&quot;CoreSelection&quot; and not match.state.cores[owner] and action.revision&gt;=match.coreWindowRevision and action.revision&lt;=match.state.revision then action.revision=match.state.revision end
        local nextState=clone(match.state)
        local ok,err=Rules.apply(nextState,owner,action)
        if ok then
            if message.intent.kind==&quot;BlockCommit&quot; and message.intent.blockerId then
                match.readAttempts[owner]+=1
                for i=#match.state.events+1,#nextState.events do local e=nextState.events[i];if e.kind==&quot;Block&quot; and e.target==message.intent.blockerId then match.readHits[owner]+=1;break end end
            end
            if nextState.phase==&quot;CoreSelection&quot; and (match.state.phase~=&quot;CoreSelection&quot; or nextState.round~=match.state.round or (#nextState.events&gt;#match.state.events and (nextState.events[#nextState.events] or {}).kind==&quot;CoreTie&quot;)) then match.coreWindowRevision=nextState.revision end
            match.state=nextState
        end
        if ok then broadcast(match,player);schedule(match) else send(player,member,err,true) end
    end)
    Players.PlayerRemoving:Connect(function(player) cancel(player,true);rates[player]=nil end)
    workspace:SetAttribute(&quot;MatchAvailable&quot;,true)
end
return Service
</ProtectedString></Properties></Item><Item class="Script" referent="RBX690"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source">-- Studio regressions must pass before the match service becomes available.
local Players = game:GetService(&quot;Players&quot;)
Players.CharacterAutoLoads = false
workspace:SetAttribute(&quot;DeadlockMilestone&quot;, &quot;Sprint2FunctionalQA&quot;)
workspace:SetAttribute(&quot;MatchAvailable&quot;, false)
print(&quot;[FirstMove] Command Room ready. Server-authoritative match starting.&quot;)
if game:GetService(&quot;RunService&quot;):IsStudio() then
    workspace:SetAttribute(&quot;OpeningAssertionsPassed&quot;, require(script.Parent.OpeningTests)())
    workspace:SetAttribute(&quot;CombatAssertionsPassed&quot;, require(script.Parent.CombatTests)())
    workspace:SetAttribute(&quot;ReportAssertionsPassed&quot;, require(script.Parent.BattleReportTests)())
end
require(script.Parent.DataService).start()
require(script.Parent.MatchService).start()
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX691"><Properties><string name="Name">ProfileSchema</string><ProtectedString name="Source">-- Server-owned profile operations. Match IDs make retrying writes idempotent.
local Schema={Version=2,HistoryLimit=5,ReceiptLimit=64}
local Progression=require(game.ReplicatedStorage.DeadlockShared.ProgressionConfig)
local defaults={master=.65,sfx=.7,music=.35,reduced=false,large=false,guide=true,language=&quot;auto&quot;}
local fields={gamesPlayed=0,wins=0,losses=0,draws=0,currentStreak=0,bestStreak=0,totalTurns=0,duration=0,readHits=0,readAttempts=0}
local function number(n,max) return type(n)==&quot;number&quot; and n==n and n&gt;=0 and n&lt;=max end
local function copy(t) if type(t)~=&quot;table&quot; then return t end;local c={};for k,v in pairs(t) do c[k]=copy(v) end;return c end
Schema.copy=copy
function Schema.settings(raw,strict)
    if type(raw)~=&quot;table&quot; then return strict and nil or copy(defaults) end
    local out=copy(defaults)
    for k,v in pairs(raw) do
        if defaults[k]==nil then if strict then return nil end
        elseif k==&quot;language&quot; then if v==&quot;auto&quot;or v==&quot;zh-cn&quot;or v==&quot;en-us&quot;then out[k]=v elseif strict then return nil end
        elseif type(defaults[k])==&quot;boolean&quot; then if type(v)==&quot;boolean&quot; then out[k]=v elseif strict then return nil end
        elseif number(v,1) then out[k]=v elseif strict then return nil end
    end
    return out
end
function Schema.new() return {schemaVersion=2,economy={credits=0,xp=0,rating=0,owned={},equipped=&quot;default&quot;},stats=copy(fields),settings=copy(defaults),tutorialComplete=false,firstMatchCompleted=false,learning={blockChosen=false,blockRead=false,skillUsed=false,attackCommitted=false},history={},receipts={},difficulty={Standard={played=0,wins=0},Advanced={played=0,wins=0},PvP={played=0,wins=0}}} end
function Schema.writable(raw)
    return raw==nil or (type(raw)==&quot;table&quot; and (raw.schemaVersion==1 or raw.schemaVersion==Schema.Version))
end
local function validView(v)
    if type(v)~=&quot;table&quot; or v.phase~=&quot;GameOver&quot; or type(v.sessionId)~=&quot;string&quot; or #v.sessionId&gt;80 or (v.winner~=&quot;A&quot; and v.winner~=&quot;B&quot; and v.winner~=&quot;Draw&quot;) or not number(v.round,1000) then return false end
    local r=v.report;if type(r)~=&quot;table&quot; or r.schemaVersion~=1 or type(r.rounds)~=&quot;table&quot; or #r.rounds&gt;100 or type(r.teams)~=&quot;table&quot; or type(v.events)~=&quot;table&quot; or #v.events&gt;200 or type(v.rosters)~=&quot;table&quot; then return false end
    for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do
        if type(r.teams[side])~=&quot;table&quot; or type(v.rosters[side])~=&quot;table&quot; or #v.rosters[side]&gt;5 then return false end
        for _,k in ipairs({&quot;damage&quot;,&quot;healing&quot;,&quot;blocks&quot;,&quot;executions&quot;,&quot;hp&quot;,&quot;survivors&quot;}) do if not number(r.teams[side][k],100000) then return false end end
        for _,h in ipairs(v.rosters[side]) do if type(h)~=&quot;table&quot; or type(h.id)~=&quot;string&quot; or type(h.alive)~=&quot;boolean&quot; or not number(h.hp,1000) then return false end end
    end
    if not number(r.finalRound,1000) or not number(r.completedRounds,1000) then return false end
    for _,row in ipairs(r.rounds) do
        if type(row)~=&quot;table&quot; or not number(row.round,1000) or not number(row.ties,10000) or type(row.fallen)~=&quot;table&quot; or type(row.teams)~=&quot;table&quot; then return false end
        for _,side in ipairs({&quot;A&quot;,&quot;B&quot;}) do if type(row.teams[side])~=&quot;table&quot; or not number(row.teams[side].damage,100000) or not number(row.teams[side].healing,100000) then return false end end
        for _,h in ipairs(row.fallen) do if type(h)~=&quot;table&quot; or type(h.id)~=&quot;string&quot; or (h.owner~=&quot;A&quot; and h.owner~=&quot;B&quot;) then return false end end
    end
    for _,e in ipairs(v.events) do if type(e)~=&quot;table&quot; or type(e.kind)~=&quot;string&quot; or not number(e.round,1000) then return false end end
    return true
end
function Schema.normalize(raw)
    local p=Schema.new();if type(raw)~=&quot;table&quot; or not Schema.writable(raw) then return p end
    local e=raw.economy
    if type(e)==&quot;table&quot; then
        for _,k in ipairs({&quot;credits&quot;,&quot;xp&quot;,&quot;rating&quot;})do if number(e[k],100000000)then p.economy[k]=math.floor(e[k])end end
        if type(e.owned)==&quot;table&quot; then for id in pairs(Progression.ById)do if e.owned[id]==true then p.economy.owned[id]=true end end end
        if type(e.equipped)==&quot;string&quot; and p.economy.owned[e.equipped] then p.economy.equipped=e.equipped end
    end
    p.settings=Schema.settings(raw.settings)
    -- Old tutorialComplete meant &quot;a match ended&quot;. Only explicit learning steps prove training.
    if type(raw.learning)==&quot;table&quot; then for k in pairs(p.learning) do p.learning[k]=raw.learning[k]==true end end
    p.tutorialComplete=p.learning.blockRead and p.learning.attackCommitted
    p.firstMatchCompleted=raw.firstMatchCompleted==true or (type(raw.stats)==&quot;table&quot; and number(raw.stats.gamesPlayed,100000000) and raw.stats.gamesPlayed&gt;0) or false
    if type(raw.stats)==&quot;table&quot; then for k in pairs(fields) do if number(raw.stats[k],100000000) then p.stats[k]=math.floor(raw.stats[k]) end end end
    for _,name in ipairs({&quot;Standard&quot;,&quot;Advanced&quot;,&quot;PvP&quot;}) do local d=type(raw.difficulty)==&quot;table&quot; and raw.difficulty[name];if type(d)==&quot;table&quot; and number(d.played,10000000) and number(d.wins,d.played) then p.difficulty[name]=copy(d) end end
    if type(raw.receipts)==&quot;table&quot; then for _,id in ipairs(raw.receipts) do if type(id)==&quot;string&quot; and #id&lt;=80 then table.insert(p.receipts,id);if #p.receipts==Schema.ReceiptLimit then break end end end end
    if type(raw.history)==&quot;table&quot; then for _,row in ipairs(raw.history) do if type(row)==&quot;table&quot; and validView(row.view) and number(row.duration,21600) and (row.difficulty==&quot;Standard&quot; or row.difficulty==&quot;Advanced&quot; or row.difficulty==&quot;PvP&quot;) and number(row.finishedAt,10000000000) then table.insert(p.history,copy(row));if #p.history==Schema.HistoryLimit then break end end end end
    p.stats.readHits=math.min(p.stats.readHits,p.stats.readAttempts)
    return p
end
function Schema.apply(raw,op)
    if not Schema.writable(raw) then return copy(raw) end
    local p=Schema.normalize(raw)
    if type(op)~=&quot;table&quot; then return p end
    if op.kind==&quot;Buy&quot; then
        local item=type(op.itemId)==&quot;string&quot; and Progression.ById[op.itemId]
        if item and not p.economy.owned[item.id] and p.economy.credits&gt;=item.price then
            p.economy.credits-=item.price;p.economy.owned[item.id]=true
        end;return p
    end
    if op.kind==&quot;Equip&quot; then
        if op.itemId==&quot;default&quot; or type(op.itemId)==&quot;string&quot; and p.economy.owned[op.itemId] then p.economy.equipped=op.itemId end
        return p
    end
    if op.kind==&quot;Settings&quot; then local s=Schema.settings(op.settings,true);if s then p.settings=s end;return p end
    if op.kind==&quot;Learning&quot; then
        if p.learning[op.step]~=nil then p.learning[op.step]=true end
        p.tutorialComplete=p.learning.blockRead and p.learning.attackCommitted
        return p
    end
    if op.kind~=&quot;Match&quot; or type(op.entry)~=&quot;table&quot; or not validView(op.entry.view) then return p end
    local v=op.entry.view;for _,id in ipairs(p.receipts) do if id==v.sessionId then return p end end
    local win=v.winner==&quot;A&quot;
    local credits=win and Progression.WinCredits or Progression.LossCredits
    local xp=win and Progression.WinXP or Progression.LossXP
    p.economy.credits+=credits;p.economy.xp+=xp
    local before=p.economy.rating
    if op.entry.difficulty==&quot;PvP&quot; and v.winner~=&quot;Draw&quot; then p.economy.rating=math.max(0,before+(win and Progression.RankWin or -Progression.RankLoss))end
    op=copy(op);op.entry.reward={credits=credits,xp=xp,rating=p.economy.rating-before}
    op.entry.view.reward=copy(op.entry.reward)
    table.insert(p.receipts,1,v.sessionId);while #p.receipts&gt;Schema.ReceiptLimit do table.remove(p.receipts) end
    local s=p.stats;s.gamesPlayed+=1;s.totalTurns+=v.round;s.duration+=op.entry.duration
    local outcome=v.winner==&quot;A&quot; and &quot;wins&quot; or v.winner==&quot;B&quot; and &quot;losses&quot; or &quot;draws&quot;;s[outcome]+=1
    s.currentStreak=v.winner==&quot;A&quot; and s.currentStreak+1 or 0;s.bestStreak=math.max(s.bestStreak,s.currentStreak)
    s.readAttempts+=op.readAttempts;s.readHits+=math.min(op.readHits,op.readAttempts)
    local d=p.difficulty[op.entry.difficulty];d.played+=1;if v.winner==&quot;A&quot; then d.wins+=1 end
    p.firstMatchCompleted=true;table.insert(p.history,1,copy(op.entry));while #p.history&gt;Schema.HistoryLimit do table.remove(p.history) end
    return p
end
function Schema.entry(view,difficulty,duration)
    local v=copy(view);while #v.events&gt;200 do table.remove(v.events,1) end;while #v.report.rounds&gt;100 do table.remove(v.report.rounds,1) end
    return {view=v,difficulty=difficulty,duration=math.clamp(math.floor(duration),0,21600),finishedAt=os.time()}
end
return Schema
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX692"><Properties><string name="Name">DataService</string><ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local Schema=require(script.Parent.ProfileSchema)
local Data={};local sessions={};local remote;local store
local studio=game:GetService(&quot;RunService&quot;):IsStudio();local memory={}
local function retry(fn)
    for attempt=1,3 do local ok,value=pcall(fn);if ok then return true,value end;if attempt&lt;3 then task.wait(2^(attempt-1)+math.random()*.25) end end
    return false
end
local function packet(s) return {profile=Schema.copy(s.profile),storage={mode=studio and &quot;Studio&quot; or &quot;Cloud&quot;,status=s.status}} end
local function push(player,s) if player.Parent and remote then remote:FireClient(player,packet(s)) end end
function Data.profile(player) local s=sessions[player];return s and Schema.copy(s.profile) or Schema.new() end
function Data.flush(player)
    local s=sessions[player];if not s or s.loading or s.busy or s.readOnly or #s.ops==0 then return false end
    s.busy=true;s.status=&quot;Saving&quot;;push(player,s);local count=#s.ops;local batch={};for i=1,count do batch[i]=Schema.copy(s.ops[i]) end
    local blocked=false
    local ok,value=retry(function()
        return store:UpdateAsync(&quot;user_&quot;..player.UserId,function(raw)
            if not Schema.writable(raw) then blocked=true;return nil end
            local p=Schema.normalize(raw);for _,op in ipairs(batch) do p=Schema.apply(p,op) end;return p
        end)
    end)
    if blocked then s.readOnly=true;s.busy=false;s.status=&quot;ReadOnly&quot;;s.ops={};push(player,s);return false end
    if ok then for _=1,count do table.remove(s.ops,1) end;s.profile=Schema.normalize(value);for _,op in ipairs(s.ops) do s.profile=Schema.apply(s.profile,op) end end
    s.busy=false;s.status=ok and (#s.ops==0 and &quot;Saved&quot; or &quot;Pending&quot;) or &quot;Unavailable&quot;;push(player,s)
    if ok and #s.ops&gt;0 then task.defer(Data.flush,player) end
    return ok
end
local function enqueue(player,op)
    local s=sessions[player];if not s then return end
    -- Coalesce pending preferences; do not let rapid toggling create an unbounded queue.
    if op.kind==&quot;Settings&quot; and not s.busy then for i=#s.ops,1,-1 do if s.ops[i].kind==&quot;Settings&quot; then table.remove(s.ops,i) end end end
    s.profile=Schema.apply(s.profile,op)
    if s.readOnly then s.status=&quot;ReadOnly&quot;;push(player,s);return end
    table.insert(s.ops,Schema.copy(op));s.status=&quot;Pending&quot;;push(player,s)
    s.serial+=1;local ticket=s.serial;task.delay(op.kind==&quot;Match&quot; and 0 or 3,function() if sessions[player]==s and s.serial==ticket then Data.flush(player) end end)
end
function Data.complete(player,view,difficulty,duration,attempts,hits)
    enqueue(player,{kind=&quot;Match&quot;,entry=Schema.entry(view,difficulty,duration),readAttempts=attempts,readHits=hits})
end
function Data.learning(player,step) enqueue(player,{kind=&quot;Learning&quot;,step=step}) end
function Data.settings(player,settings)
    local valid=Schema.settings(settings,true);if not valid then return false end
    enqueue(player,{kind=&quot;Settings&quot;,settings=valid});return true
end
local function load(player)
    local s={profile=Schema.new(),ops={},loading=true,busy=false,status=&quot;Loading&quot;,serial=0};sessions[player]=s
    task.spawn(function()
        local ok,value=retry(function() return store:GetAsync(&quot;user_&quot;..player.UserId) end)
        if sessions[player]~=s then return end
        if ok then
            s.readOnly=not Schema.writable(value)
            s.profile=Schema.normalize(value);for _,op in ipairs(s.ops) do s.profile=Schema.apply(s.profile,op) end
            if s.readOnly then s.ops={} end
        end
        s.loading=false;s.status=s.readOnly and &quot;ReadOnly&quot; or ok and (#s.ops&gt;0 and &quot;Pending&quot; or &quot;Saved&quot;) or &quot;Unavailable&quot;;push(player,s)
        if #s.ops&gt;0 then task.defer(Data.flush,player) end
    end)
end
function Data.start()
    if studio then store={GetAsync=function(_,key) return Schema.copy(memory[key]) end,UpdateAsync=function(_,key,fn) local nextValue=fn(Schema.copy(memory[key]));if nextValue~=nil then memory[key]=nextValue end;return Schema.copy(memory[key]) end}
    else store=game:GetService(&quot;DataStoreService&quot;):GetDataStore(&quot;FirstMoveProfiles_v1&quot;) end
    local folder=Instance.new(&quot;Folder&quot;);folder.Name=&quot;FirstMoveProfile&quot;;folder.Parent=game.ReplicatedStorage
    remote=Instance.new(&quot;RemoteEvent&quot;);remote.Name=&quot;Updated&quot;;remote.Parent=folder
    local request=Instance.new(&quot;RemoteFunction&quot;);request.Name=&quot;Request&quot;;request.Parent=folder
    local rates={}
    request.OnServerInvoke=function(player,message)
        local s=sessions[player];if not s then return nil end
        if message==&quot;Get&quot; then
            local now=os.clock();if now-(rates[player] or -10)&lt;.15 then return nil end;rates[player]=now
            return packet(s)
        end
        if type(message)~=&quot;table&quot; then return nil end
        local now=os.clock();if now-(rates[player] or -10)&lt;.15 then return packet(s) end;rates[player]=now
        if message.command==&quot;Buy&quot; or message.command==&quot;Equip&quot; then
            for key in pairs(message)do if key~=&quot;command&quot; and key~=&quot;itemId&quot;then return nil end end
            if s.loading or s.readOnly or s.busy or s.status==&quot;Unavailable&quot; then local result=packet(s);result.error=&quot;档案尚未就绪，请稍后重试&quot;;return result end
            local catalog=require(game.ReplicatedStorage.DeadlockShared.ProgressionConfig)
            local id=message.itemId
            if type(id)~=&quot;string&quot; or (#id&gt;40) or (id~=&quot;default&quot; and not catalog.ById[id])then return nil end
            local e=s.profile.economy;local err
            if message.command==&quot;Buy&quot; then
                if id==&quot;default&quot; or e.owned[id]then err=&quot;已拥有此外观&quot;
                elseif e.credits&lt;catalog.ById[id].price then err=&quot;核晶不足，完成对局可获得核晶&quot; end
            elseif id~=&quot;default&quot; and not e.owned[id]then err=&quot;尚未拥有此外观&quot; end
            if err then local result=packet(s);result.error=err;return result end
            enqueue(player,{kind=message.command,itemId=id});Data.flush(player)
            return packet(s)
        end
        if message.command~=&quot;Settings&quot; then return nil end
        for key in pairs(message) do if key~=&quot;command&quot; and key~=&quot;settings&quot; then return nil end end
        if not Data.settings(player,message.settings) then return nil end;return packet(s)
    end
    Players.PlayerAdded:Connect(load);for _,p in ipairs(Players:GetPlayers()) do load(p) end
    Players.PlayerRemoving:Connect(function(p)
        rates[p]=nil;task.spawn(function() local deadline=os.clock()+24;local s=sessions[p];while s and (s.loading or s.busy) and os.clock()&lt;deadline do task.wait(.1) end;Data.flush(p);sessions[p]=nil end)
    end)
    task.spawn(function() while task.wait(60) do for p in pairs(sessions) do task.spawn(Data.flush,p) end end end)
    game:BindToClose(function()
        local pending=0;for p in pairs(sessions) do pending+=1;task.spawn(function() local s=sessions[p];local deadline=os.clock()+23;while s and (s.loading or s.busy) and os.clock()&lt;deadline do task.wait(.1) end;Data.flush(p);pending-=1 end) end
        local deadline=os.clock()+25;while pending&gt;0 and os.clock()&lt;deadline do task.wait(.1) end
    end)
end
return Data
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX693"><Properties><string name="Name">AIDirector</string><ProtectedString name="Source">-- Every decision accepts a public projection. No session or private attack reference.
local Shared=game.ReplicatedStorage.DeadlockShared
local Legacy=require(Shared.LegacyConfig);local Tuning=require(Shared.AIConfig)
local Basic=require(script.Parent.StandardAI);local defs={};for _,h in ipairs(Legacy.heroes) do defs[h.id]=h end
local AI={}
function AI.intent(view,owner,rng,difficulty)
    local base=Basic.intent(view,owner,rng);if difficulty~=&quot;Advanced&quot; or not base then return base end
    local t=Tuning.Advanced;local enemy=owner==&quot;A&quot; and &quot;B&quot; or &quot;A&quot;
    if base.kind==&quot;CoreLock&quot; and rng:NextNumber()&gt;t.coreExploration then
        local counts={red=0,cyan=0,purple=0};local seen=0
        for i=#view.events,1,-1 do local e=view.events[i];if e.kind==&quot;CoreReveal&quot; then counts[e[enemy]]+=1;seen+=1;if seen&gt;=t.coreMemory then break end end end
        if seen&gt;0 then local predicted=&quot;red&quot;;for _,c in ipairs({&quot;cyan&quot;,&quot;purple&quot;}) do if counts[c]&gt;counts[predicted] then predicted=c end end;for core,beats in pairs(Legacy.beats) do if beats==predicted then base.core=core;break end end end
    elseif base.kind==&quot;AttackCommit&quot; then
        local blocked={};local owners={};for _,h in ipairs(view.rosters[enemy]) do owners[h.id]=true end
        for i=#view.events,1,-1 do local e=view.events[i];if e.round&lt;view.round-t.coreMemory then break end;if e.kind==&quot;Block&quot; and owners[e.target] then blocked[e.target]=(blocked[e.target] or 0)+1 end end
        local enemies={};for _,h in ipairs(view.rosters[enemy]) do if h.alive then table.insert(enemies,h) end end
        local best;local score=-math.huge
        for _,h in ipairs(view.rosters[owner]) do if h.alive then for _,e in ipairs(enemies) do
            local active=h.cooldown==0 and defs[h.id].skill.type==&quot;active_attack_phase&quot;;if h.id==&quot;shuang_xing&quot; and #enemies&lt;2 then active=false end
            local damage=e.id==&quot;lan_dun&quot; and math.min(h.atk,Legacy.normalDamageCap) or h.atk
            if active and h.id==&quot;beng_yue&quot; then damage*=2 end
            local value=math.min(e.hp,damage)+(damage&gt;=e.hp and t.killBonus or 0)+rng:NextNumber(0,t.exploration)
            if active and h.id==&quot;ting_sun&quot; then value+=e.hp*t.executionWeight+t.killBonus end
            if h.id==&quot;xuan_bao&quot; and not e.statuses.bleeding then value+=5 end
            if e.id==&quot;zhe_jing&quot; and e.hp&gt;damage then value-=math.min(h.hp,Legacy.reflection or 4) end
            if h.id~=&quot;huan_shi&quot; then value-=math.min(blocked[e.id] or 0,3)*t.blockPenalty else value+=3 end
            if value&gt;score then score=value;best={kind=&quot;AttackCommit&quot;,revision=view.revision,attackerId=h.id,useSkill=active,targets={e.id}}
                if active and h.id==&quot;beng_yue&quot; then table.insert(best.targets,e.id)
                elseif active and h.id==&quot;shuang_xing&quot; then local second;for _,s in ipairs(enemies) do if s.id~=e.id and (not second or s.hp&lt;second.hp) then second=s end end;table.insert(best.targets,second.id) end
            end
        end end end
        return best or base
    elseif base.kind==&quot;BlockCommit&quot; and rng:NextNumber()&lt;t.weakestProtection then
        local target;for _,h in ipairs(view.rosters[owner]) do if h.alive and (not target or h.hp&lt;target.hp) then target=h end end;base.blockerId=target.id
    end
    return base
end
return AI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX694"><Properties><string name="Name">PlayerProjection</string><ProtectedString name="Source">-- Canonical HUD: your side is A on either client. Start from the existing private-safe
-- projection, then swap labels; never project by cloning the authoritative state.
local Rules=require(script.Parent.MatchRules)
local Projection={}
local function swap(value)
    if type(value)~=&quot;table&quot; then if value==&quot;A&quot; then return &quot;B&quot; elseif value==&quot;B&quot; then return &quot;A&quot; end;return value end
    local out={};for key,item in pairs(value) do local k=key==&quot;A&quot; and &quot;B&quot; or key==&quot;B&quot; and &quot;A&quot; or key;out[k]=swap(item) end;return out
end
function Projection.view(state,owner)
    local view=Rules.view(state,owner)
    return owner==&quot;B&quot; and swap(view) or view
end
return Projection
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX695"><Properties><string name="Name">TrainingMatch</string><ProtectedString name="Source">-- Teaching scenarios execute the shipping rules. They never create competitive results.
local Rules=require(script.Parent.MatchRules)
local Training={}
local picks={&quot;lan_dun&quot;,&quot;xuan_bao&quot;,&quot;shuang_xing&quot;,&quot;bai_ji&quot;,&quot;beng_yue&quot;,&quot;chi_guang&quot;,&quot;huan_shi&quot;,&quot;zhe_jing&quot;,&quot;ting_sun&quot;,&quot;zhui_lie&quot;}
local owners={&quot;A&quot;,&quot;B&quot;,&quot;B&quot;,&quot;A&quot;,&quot;A&quot;,&quot;B&quot;,&quot;B&quot;,&quot;A&quot;,&quot;A&quot;,&quot;B&quot;}
local function apply(state,owner,action)
    action.revision=state.revision
    local ok,err=Rules.apply(state,owner,action);assert(ok,err)
end
function Training.new(revision)
    local state=Rules.new()
    for i,id in ipairs(picks) do apply(state,owners[i],{kind=&quot;DraftPick&quot;,heroId=id}) end
    apply(state,&quot;A&quot;,{kind=&quot;CoreLock&quot;,core=&quot;red&quot;})
    apply(state,&quot;B&quot;,{kind=&quot;CoreLock&quot;,core=&quot;purple&quot;})
    -- The injured support exercise is established by a real prior rules round.
    apply(state,&quot;B&quot;,{kind=&quot;SkillEnd&quot;})
    apply(state,&quot;B&quot;,{kind=&quot;AttackCommit&quot;,attackerId=&quot;shuang_xing&quot;,targets={&quot;lan_dun&quot;},useSkill=false})
    apply(state,&quot;A&quot;,{kind=&quot;BlockCommit&quot;})
    apply(state,&quot;A&quot;,{kind=&quot;SkillEnd&quot;})
    apply(state,&quot;A&quot;,{kind=&quot;AttackCommit&quot;,attackerId=&quot;lan_dun&quot;,targets={&quot;xuan_bao&quot;},useSkill=false})
    apply(state,&quot;B&quot;,{kind=&quot;BlockCommit&quot;})
    apply(state,&quot;A&quot;,{kind=&quot;CoreLock&quot;,core=&quot;red&quot;})
    apply(state,&quot;B&quot;,{kind=&quot;CoreLock&quot;,core=&quot;purple&quot;})
    apply(state,&quot;B&quot;,{kind=&quot;SkillEnd&quot;})
    apply(state,&quot;B&quot;,{kind=&quot;AttackCommit&quot;,attackerId=&quot;shuang_xing&quot;,targets={&quot;bai_ji&quot;},useSkill=false})
    if revision then state.revision=math.max(state.revision,revision) end
    return state,{step=1,feedback=nil,complete=false,hit=false,skillUsed=false}
end
function Training.model(t)
    local model
    if t.complete then model={step=4,feedback=&quot;complete&quot;,title=&quot;训练完成&quot;,body=&quot;你保护了复苏、用技能恢复了哨卫，并完成进攻承诺。技能窗口与普攻是两次不同的决策；攻击技能还要独立启用。正式对局中，你需要自己判断对手意图。&quot;,complete=true}
    elseif t.feedback then model={step=1,feedback=t.hit and &quot;success&quot; or &quot;miss&quot;,title=t.hit and &quot;格挡命中&quot; or &quot;格挡未命中&quot;,body=t.hit and &quot;你让复苏保护自己，正好挡住了双轨的攻击。接下来练习恢复受伤的哨卫。&quot; or &quot;格挡只保护你选中的那名单位，不会替队友承伤。观察教学提示，再试一次。&quot;,complete=false}
    elseif t.step==1 then model={step=1,title=&quot;保护支援单位&quot;,body=&quot;教学对手倾向攻击支援单位。复苏负责恢复；点选它，再确认格挡。哨卫已在前一回合受伤，稍后将练习恢复。&quot;,complete=false}
    elseif t.step==2 then model={step=2,title=&quot;恢复哨卫&quot;,body=&quot;哨卫现在为 23 / 26 生命。选择复苏，再释放修复脉冲，恢复所有受伤的己方单位。使用技能后仍有一次普攻。&quot;,complete=false,requiredCaster=&quot;bai_ji&quot;}
    else model={step=3,title=&quot;承诺进攻&quot;,body=&quot;哨卫已恢复至 26 / 26，复苏进入 3 回合冷却。进入攻击阶段，选择进攻单位和目标。可试选夺魄，再启用掠魂；不启用则是普通攻击。教学对手会格挡荒行，选择其他目标观察命中。&quot;,attackBody=&quot;选择进攻单位与目标。可启用掠魂；普通攻击不会自动使用技能。教学对手会格挡荒行。&quot;,complete=false} end
    model.total=3;model.skillUsed=t.skillUsed
    return model
end
function Training.apply(state,t,action)
    if action.revision~=state.revision then return false,&quot;StaleRevision&quot; end
    if action.kind==&quot;TrainingRetry&quot; then
        if not t.feedback or t.hit or t.complete then return false,&quot;WrongPhase&quot; end
        return true,&quot;Retry&quot;
    end
    if action.kind==&quot;TrainingContinue&quot; then
        if not t.feedback or not t.hit or t.complete then return false,&quot;WrongPhase&quot; end
        t.feedback=nil;t.step=2;state.revision+=1;return true
    end
    if t.feedback or t.complete then return false,&quot;TrainingFeedback&quot; end
    if t.step==1 and action.kind~=&quot;BlockCommit&quot; then return false,&quot;WrongPhase&quot; end
    if t.step==2 and (action.kind~=&quot;SkillCast&quot; or action.casterId~=&quot;bai_ji&quot;) then return false,&quot;TrainingSkillRequired&quot; end
    if t.step==3 and action.kind~=&quot;SkillCast&quot; and action.kind~=&quot;SkillEnd&quot; and action.kind~=&quot;AttackCommit&quot; then return false,&quot;WrongPhase&quot; end
    local before=#state.events
    local ok,err=Rules.apply(state,&quot;A&quot;,action);if not ok then return false,err end
    if t.step==1 then
        t.feedback=true
        for i=before+1,#state.events do if state.events[i].kind==&quot;Block&quot; and state.events[i].target==&quot;bai_ji&quot; then t.hit=true end end
        return true,t.hit and &quot;BlockRead&quot; or &quot;BlockChosen&quot;
    elseif t.step==2 then
        t.skillUsed=true;t.step=3;return true,&quot;SkillUsed&quot;
    elseif action.kind==&quot;AttackCommit&quot; then
        apply(state,&quot;B&quot;,{kind=&quot;BlockCommit&quot;,blockerId=&quot;zhui_lie&quot;})
        t.complete=true;return true,&quot;AttackCommitted&quot;
    end
    return true
end
return Training
</ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX728"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX727"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX726"><Properties><string name="Name">DeadlockClient</string></Properties><Item class="ModuleScript" referent="RBX698"><Properties><string name="Name">UnitPortrait</string><ProtectedString name="Source">-- Original illustration assets; the same authored face crop is used in every small slot.
-- Asset availability never blocks battle input or creates gameplay geometry.
local Assets=require(script.Parent.PortraitAssets)
local Identity=require(script.Parent.UnitIdentity)
local ContentProvider=game:GetService(&quot;ContentProvider&quot;)
local Portrait={}
local requested={}
function Portrait.render(parent,id,position,size,alive,framing)
    local def=Identity.byId[id];if not def then return end
    local asset=Assets.Units[id]
    local frame=Instance.new(&quot;ImageLabel&quot;)
    frame.Name=&quot;UnitPortrait&quot;;frame.BackgroundTransparency=1;frame.Position=position;frame.Size=size;frame.Active=false
    frame:SetAttribute(&quot;UnitId&quot;,id);frame:SetAttribute(&quot;PortraitParts&quot;,0)
    frame:SetAttribute(&quot;PortraitSource&quot;,asset and &quot;OriginalIllustration&quot; or &quot;InsigniaFallback&quot;)
    frame:SetAttribute(&quot;AssetLoaded&quot;,false)
    local mode=framing or &quot;Face&quot;;frame:SetAttribute(&quot;Framing&quot;,mode)
    frame.ImageColor3=alive==false and Color3.fromRGB(129,142,147) or Color3.new(1,1,1)
    frame.ImageTransparency=alive==false and .30 or 0
    if asset then
        frame.Image=asset.Image
        frame.ClipsDescendants=true
        -- Roblox may resize uploaded textures. Crop in normalized source coordinates.
        local art=Instance.new(&quot;ImageLabel&quot;);art.Name=&quot;Artwork&quot;;art.BackgroundTransparency=1
        art.Image=asset.Image;art.ScaleType=Enum.ScaleType.Stretch
        art.ImageColor3=frame.ImageColor3;art.ImageTransparency=frame.ImageTransparency
        art.Parent=frame;frame.ImageTransparency=1
        local function showCrop(x,y,w,h)
            art.Size=UDim2.fromScale(asset.Width/w,asset.Height/h)
            art.Position=UDim2.fromScale(-x/w,-y/h)
        end
        frame.ScaleType=mode==&quot;Full&quot; and Enum.ScaleType.Fit or Enum.ScaleType.Crop
        local crop=mode==&quot;Full&quot; and asset.Full or mode==&quot;Hero&quot; and asset.Hero or asset.Face
        frame.ImageRectOffset=Vector2.new(crop[1],crop[2]);frame.ImageRectSize=Vector2.new(crop[3],crop[4])
        showCrop(crop[1],crop[2],crop[3],crop[4])
        if mode==&quot;Face&quot; then
            local function fitFace()
                local v=frame.AbsoluteSize;if v.X&lt;=0 or v.Y&lt;=0 then return end
                local w=math.min(crop[3],crop[4]*v.X/v.Y);local h=w*v.Y/v.X
                showCrop(crop[1]+(crop[3]-w)/2,crop[2]+(crop[4]-h)/2,w,h)
            end
            frame:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(fitFace);task.defer(fitFace)
        end
        if mode==&quot;Full&quot; then art.Size=UDim2.fromScale(1,1);art.Position=UDim2.fromScale(0,0);art.ScaleType=Enum.ScaleType.Fit end
        if mode==&quot;Hero&quot; then
            local function fitHero()
                local view=frame.AbsoluteSize;if view.X&lt;=0 or view.Y&lt;=0 then return end
                -- Crop from the head's safe top, rather than centre-cropping away the face.
                local ratio=view.X/view.Y
                local height=math.min(asset.Height-crop[2],asset.Width/ratio)
                local width=math.min(asset.Width,height*ratio)
                local center=asset.Face[1]+asset.Face[3]/2
                frame.ImageRectOffset=Vector2.new(math.floor(math.clamp(center-width/2,0,asset.Width-width)),crop[2])
                frame.ImageRectSize=Vector2.new(math.floor(width),math.floor(height))
                showCrop(frame.ImageRectOffset.X,crop[2],width,height)
            end
            frame:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(fitHero)
            task.defer(fitHero)
        end
    end
    local fallback=Instance.new(&quot;Frame&quot;);fallback.Name=&quot;PortraitFallback&quot;;fallback.BackgroundTransparency=1
    fallback.AnchorPoint=Vector2.new(.5,.5);fallback.Position=UDim2.fromScale(.5,.5);fallback.Size=UDim2.fromScale(.68,.68);fallback.Parent=frame
    local aspect=Instance.new(&quot;UIAspectRatioConstraint&quot;);aspect.AspectRatio=1;aspect.Parent=fallback
    local color=alive==false and Color3.fromRGB(129,142,147) or Color3.fromRGB(202,187,151)
    for _,path in ipairs(def.paths) do for i=1,#path-1 do
        local a,b=path[i],path[i+1];local dx,dy=b[1]-a[1],b[2]-a[2]
        local line=Instance.new(&quot;Frame&quot;);line.Name=&quot;InsigniaLine&quot;;line.BorderSizePixel=0;line.BackgroundColor3=color
        line.AnchorPoint=Vector2.new(.5,.5);line.Position=UDim2.fromScale((a[1]+b[1])/2,(a[2]+b[2])/2)
        line.Size=UDim2.new(math.sqrt(dx*dx+dy*dy),0,0,2);line.Rotation=math.deg(math.atan2(dy,dx));line.Parent=fallback
    end end
    local function sync()
        local art=frame:FindFirstChild(&quot;Artwork&quot;)
        local loaded=asset~=nil and (art and art.IsLoaded or frame.IsLoaded)
        frame:SetAttribute(&quot;AssetLoaded&quot;,loaded)
        -- Insignia belongs in the log, never on top of an authored portrait.
        -- Rebuilding a HUD must not flash a symbol while a cached texture attaches.
        fallback.Visible=asset==nil
    end
    frame:GetPropertyChangedSignal(&quot;IsLoaded&quot;):Connect(sync)
    frame:GetPropertyChangedSignal(&quot;ZIndex&quot;):Connect(function()
        local art=frame:FindFirstChild(&quot;Artwork&quot;);if art then art.ZIndex=frame.ZIndex end
        fallback.ZIndex=frame.ZIndex+1
        for _,child in ipairs(fallback:GetChildren()) do if child:IsA(&quot;GuiObject&quot;) then child.ZIndex=frame.ZIndex+1 end end
    end)
    frame.Parent=parent;sync()
    -- IsLoaded changes are not consistently signalled by the engine. A bounded,
    -- instance-local watcher also covers cached textures and slow first loads.
    if asset and not frame:GetAttribute(&quot;AssetLoaded&quot;) then
        task.spawn(function()
            for _=1,120 do
                task.wait(.25)
                if not frame.Parent then return end
                sync();if frame:GetAttribute(&quot;AssetLoaded&quot;) then return end
            end
        end)
    end
    if asset and not requested[asset.Image] then
        requested[asset.Image]=true
        task.spawn(function()
            -- A rejected or slow texture keeps its readable insignia fallback. No waiting on the UI thread.
            local ok=pcall(function() ContentProvider:PreloadAsync({asset.Image}) end)
            if not ok then requested[asset.Image]=nil end
        end)
    end
    return frame
end
return Portrait
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX699"><Properties><string name="Name">InterfaceKit</string><ProtectedString name="Source">local TweenService=game:GetService(&quot;TweenService&quot;)
local Config=require(script.Parent.PresentationConfig)
local Audio=require(script.Parent.AudioController)
local Locale=require(script.Parent.LocaleController)
local C=Config.Colors
local function make(class, props, parent)
    local obj = Instance.new(class)
    for k,v in pairs(props) do obj[k] = v end
    obj.Parent = parent
    if obj:IsA(&quot;TextLabel&quot;) then
        local formatting=false
        local function optical()
            if Locale.isEnglish() then return end
            if obj:GetAttribute(&quot;NaturalGlyphs&quot;) then return end
            if formatting then return end
            local raw=obj.Text:gsub('&lt;font size=&quot;%d+&quot;&gt;复&lt;/font&gt;',&quot;复&quot;)
            if raw:find(&quot;复苏&quot;,1,true) and not raw:find(&quot;&lt;&quot;,1,true) then
                formatting=true;obj.RichText=true
                obj.Text=raw:gsub(&quot;复&quot;,'&lt;font size=&quot;'..math.floor(obj.TextSize*1.18+.5)..'&quot;&gt;复&lt;/font&gt;')
                formatting=false
            end
        end
        obj:GetPropertyChangedSignal(&quot;Text&quot;):Connect(optical)
        obj:GetPropertyChangedSignal(&quot;TextSize&quot;):Connect(optical);optical()
    end
    if obj:IsA(&quot;TextLabel&quot;) or obj:IsA(&quot;TextButton&quot;) then Locale.bind(obj) end
    return obj
end
local function text(parent, value, x,y,w,h,size,color,font)
    local face=font==Enum.Font.GothamBold and Enum.FontWeight.Bold or font==Enum.Font.Gotham and Enum.FontWeight.Regular or Enum.FontWeight.SemiBold
    return make(&quot;TextLabel&quot;, {BackgroundTransparency=1,Position=UDim2.fromScale(x,y),Size=UDim2.fromScale(w,h),Text=value,TextColor3=color or C.Paper,FontFace=Font.new(Config.DossierTypography.Family,face),TextSize=size,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,TextWrapped=true},parent)
end
local function line(parent,x,y,w,color)
    return make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=color or C.Line,Position=UDim2.fromScale(x,y),Size=UDim2.new(w,0,0,1)},parent)
end
local function panel(parent,x,y,w,h,alpha,stable)
    local p = make(&quot;CanvasGroup&quot;,{Name=&quot;Panel&quot;..(#parent:GetChildren()+1),BorderSizePixel=0,BackgroundColor3=C.Ink,BackgroundTransparency=math.min(alpha or 0.08,.035),Position=UDim2.fromScale(x,y),Size=UDim2.fromScale(w,h),GroupTransparency=stable and 0 or 1},parent)
    make(&quot;Frame&quot;,{Name=&quot;MachinedCorner&quot;,BorderSizePixel=0,BackgroundColor3=C.Line,Position=UDim2.fromOffset(0,0),Size=UDim2.fromOffset(18,2)},p)
    make(&quot;UIStroke&quot;,{Name=&quot;SurfaceEdge&quot;,Color=Color3.fromRGB(98,115,123),Thickness=1,Transparency=.68},p)
    make(&quot;UIGradient&quot;,{Name=&quot;GraphiteSurface&quot;,Rotation=90,
        Color=ColorSequence.new(Color3.fromRGB(255,255,255),Color3.fromRGB(175,187,193))},p)
    make(&quot;Frame&quot;,{Name=&quot;LowerSeam&quot;,BorderSizePixel=0,BackgroundColor3=Color3.fromRGB(4,9,12),
        BackgroundTransparency=.2,Position=UDim2.new(0,1,1,-2),Size=UDim2.new(1,-2,0,1)},p)
    if not stable then TweenService:Create(p,TweenInfo.new(Config.PanelTime,Enum.EasingStyle.Quad),{GroupTransparency=0}):Play() end
    return p
end
local function button(parent,label,x,y,w,h,fn,primary)
    local b=make(&quot;TextButton&quot;,{Name=label,AutoButtonColor=false,BorderSizePixel=0,Text=&quot;&quot;,Position=UDim2.fromScale(x,y),Size=UDim2.fromScale(w,h),BackgroundColor3=primary and C.Paper or C.Panel,BackgroundTransparency=primary and 0 or 0.15,Selectable=true},parent)
    make(&quot;UIGradient&quot;,{Name=&quot;MachinedSurface&quot;,Rotation=90,
        Color=ColorSequence.new(Color3.fromRGB(255,255,255),primary and Color3.fromRGB(213,220,222) or Color3.fromRGB(157,173,180))},b)
    make(&quot;UIStroke&quot;,{Name=&quot;ButtonEdge&quot;,Color=primary and C.Paper or Color3.fromRGB(104,125,135),
        Thickness=1,Transparency=primary and .4 or .65},b)
    local focus=make(&quot;Frame&quot;,{Name=&quot;FocusOutline&quot;,BackgroundTransparency=1,Size=UDim2.new(1,4,1,4),Position=UDim2.fromOffset(-2,-2)},b)
    make(&quot;UIStroke&quot;,{Color=C.Cyan,Thickness=1,Transparency=.15},focus)
    focus.Parent=nil;b.SelectionImageObject=focus
    b.Destroying:Connect(function() focus:Destroy() end)
    local padding=make(&quot;UIPadding&quot;,{PaddingLeft=UDim.new(0,16),PaddingRight=UDim.new(0,12)},b)
    local bevel=make(&quot;Frame&quot;,{Name=&quot;UpperBevel&quot;,BorderSizePixel=0,BackgroundColor3=primary and Color3.fromRGB(255,253,243) or Color3.fromRGB(120,144,155),
        BackgroundTransparency=primary and .25 or .55,Position=UDim2.fromOffset(-15,1),Size=UDim2.new(1,26,0,1)},b)
    local rail=make(&quot;Frame&quot;,{Name=&quot;CommandRail&quot;,BorderSizePixel=0,BackgroundColor3=primary and C.Amber or C.Muted,
        BackgroundTransparency=primary and .05 or .5,Position=UDim2.fromOffset(-15,3),Size=UDim2.new(0,2,1,-6)},b)
    make(&quot;UISizeConstraint&quot;,{MinSize=Vector2.new(Config.MinimumTarget,Config.MinimumTarget)},b)
    local caption=text(b,label,0,0,0.9,1,17,primary and C.Ink or C.Paper,Enum.Font.GothamMedium)
    caption.Name=&quot;ButtonCaption&quot;
    local arrow=text(b,&quot;›&quot;,0.91,0,0.09,1,24,primary and C.Ink or C.Muted)
    arrow.Name=&quot;ButtonArrow&quot;
    local function fitCaption()
        if not caption.Parent or not arrow.Parent then return end
        local small=b.AbsoluteSize.X&lt;150
        arrow.Visible=not small and not b:GetAttribute(&quot;HideArrow&quot;)
        local inset=b:GetAttribute(&quot;CaptionInset&quot;)
        if inset then
            caption.Position=UDim2.fromOffset(inset,0)
            caption.Size=UDim2.new(1,-inset-(arrow.Visible and 26 or 0),1,0)
        else caption.Size=UDim2.fromScale(small and 1 or .9,1) end
    end
    b:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(fitCaption);task.defer(fitCaption)
    b:GetAttributeChangedSignal(&quot;CaptionInset&quot;):Connect(fitCaption)
    b:GetAttributeChangedSignal(&quot;HideArrow&quot;):Connect(fitCaption)
    local original=b.BackgroundColor3;local hovered=false;local pressed=false;local restAlpha=b.BackgroundTransparency
    local function release()
        if pressed then b.BackgroundTransparency=restAlpha;pressed=false end
    end
    local function hover(on)
        if b:GetAttribute(&quot;Disabled&quot;) then return end
        if on and not hovered then original=b.BackgroundColor3 end
        hovered=on
        rail.BackgroundTransparency=on and 0 or primary and .05 or .5
        rail.BackgroundColor3=on and C.Cyan or primary and C.Amber or C.Muted
        TweenService:Create(b,TweenInfo.new(Config.HoverTime),{BackgroundColor3=on and (b:GetAttribute(&quot;HoverColor&quot;) or ((primary or b:GetAttribute(&quot;Selected&quot;)) and C.Cyan or Color3.fromRGB(45,63,71))) or b:GetAttribute(&quot;RestColor&quot;) or original}):Play()
        if on then Audio.Play(&quot;hover&quot;) end
    end
    b.MouseEnter:Connect(function() hover(true) end)
    b.MouseLeave:Connect(function() release();hover(false) end)
    b.SelectionGained:Connect(function() hover(true) end)
    b.SelectionLost:Connect(function() release();hover(false) end)
    b.MouseButton1Down:Connect(function() if not b:GetAttribute(&quot;Disabled&quot;) then restAlpha=b.BackgroundTransparency;pressed=true;b.BackgroundTransparency=math.min(1,restAlpha+.12) end end)
    b.MouseButton1Up:Connect(release)
    local defaultCue=label:find(&quot;返回&quot;,1,true) or label==&quot;上一位&quot; or label==&quot;上一步&quot; or label:find(&quot;取消&quot;,1,true)
    b.Activated:Connect(function() if b:GetAttribute(&quot;Disabled&quot;) then return end;Audio.Play(b:GetAttribute(&quot;AudioCue&quot;) or (defaultCue and &quot;back&quot; or primary and &quot;confirm&quot; or &quot;select&quot;));fn() end)
    return b
end
local function textSize(base,height,scale)
    local typography=Config.Typography
    local factor=math.clamp(height/typography.ReferenceHeight,1,typography.MaximumScale)
    local minimum=base&gt;=14 and typography.BodyMinimum or typography.MetaMinimum
    return math.floor(math.max(minimum,base*typography.OpticalScale)*factor*(scale or 1)+.5)
end
local function fit(root,scale)
    -- A scroller's own height is not the viewport. Keep settings consistent with the HUD.
    local screen=root:FindFirstAncestorWhichIsA(&quot;ScreenGui&quot;)
    local router=screen and screen:FindFirstChild(&quot;Router&quot;)
    local height=router and router.AbsoluteSize.Y or root.AbsoluteSize.Y
    for _,obj in ipairs(root:GetDescendants()) do if obj:IsA(&quot;TextLabel&quot;) then
        local base=obj:GetAttribute(&quot;BaseTextSize&quot;)
        if not base then base=obj.TextSize;obj:SetAttribute(&quot;BaseTextSize&quot;,base) end
        obj.TextSize=textSize(base,height,scale)
    end end
end
local function icon(parent,kind,x,y,size,color)
    local f=make(&quot;Frame&quot;,{Name=&quot;SystemIcon&quot;,BackgroundTransparency=1,Position=UDim2.fromOffset(x,y),Size=UDim2.fromOffset(size,size)},parent)
    local function segment(ax,ay,bx,by)
        local dx,dy=(bx-ax)*size,(by-ay)*size
        make(&quot;Frame&quot;,{BorderSizePixel=0,BackgroundColor3=color or C.Muted,AnchorPoint=Vector2.new(.5,.5),
            Position=UDim2.fromOffset((ax+bx)*size/2,(ay+by)*size/2),Size=UDim2.fromOffset(math.sqrt(dx*dx+dy*dy),1.6),Rotation=math.deg(math.atan2(dy,dx))},f)
    end
    local points=kind==&quot;Shop&quot; and {{.18,.28,.82,.28},{.18,.28,.08,.46},{.08,.46,.92,.46},{.92,.46,.82,.28},{.18,.48,.18,.87},{.18,.87,.82,.87},{.82,.87,.82,.48},{.43,.87,.43,.64},{.43,.64,.65,.64},{.65,.64,.65,.87}}
        or kind==&quot;Inventory&quot; and {{.2,.3,.8,.3},{.2,.3,.2,.86},{.2,.86,.8,.86},{.8,.86,.8,.3},{.34,.3,.34,.13},{.34,.13,.66,.13},{.66,.13,.66,.3},{.2,.5,.8,.5},{.44,.5,.44,.61},{.44,.61,.56,.61},{.56,.61,.56,.5}}
        or kind==&quot;Career&quot; and {{.2,.18,.8,.18},{.2,.18,.24,.56},{.8,.18,.76,.56},{.24,.56,.5,.76},{.76,.56,.5,.76},{.5,.76,.5,.9},{.31,.9,.69,.9},{.22,.29,.07,.29},{.07,.29,.12,.52},{.12,.52,.25,.55},{.78,.29,.93,.29},{.93,.29,.88,.52},{.88,.52,.75,.55}}
        or {{.3,.12,.42,.24},{.42,.24,.3,.38},{.3,.38,.18,.24},{.18,.24,.3,.12},{.7,.16,.8,.27},{.8,.27,.7,.4},{.7,.4,.59,.27},{.59,.27,.7,.16},{.08,.84,.12,.6},{.12,.6,.3,.49},{.3,.49,.48,.6},{.48,.6,.52,.84},{.6,.55,.74,.5},{.74,.5,.88,.61},{.88,.61,.92,.84}}
    for _,p in ipairs(points)do segment(table.unpack(p))end
    return f
end
return {make=make,text=text,line=line,panel=panel,button=button,fit=fit,textSize=textSize,icon=icon}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX700"><Properties><string name="Name">ReportStory</string><ProtectedString name="Source">-- A factual summary of revealed terminal events, not a claim about hidden intent.
local Identity=require(script.Parent.UnitIdentity)
local Locale=require(script.Parent.LocaleController)
local Story={}
local function name(id) return Locale.translate(Identity.name(id)) end
local function fatal(source,target,damageType)
    local types={Normal=&quot;attack&quot;,Skill=&quot;skill&quot;,Bleeding=&quot;bleed&quot;,Reflection=&quot;reflection&quot;,DeathRattle=&quot;deathrattle&quot;}
    if Locale.isEnglish() then return name(source)..&quot;'s &quot;..(types[damageType]or&quot;damage&quot;)..&quot; eliminated &quot;..name(target) end
    local cn={Normal=&quot;普攻&quot;,Skill=&quot;技能&quot;,Bleeding=&quot;流血&quot;,Reflection=&quot;反伤&quot;,DeathRattle=&quot;亡语&quot;}
    return name(source)..&quot;的&quot;..(cn[damageType]or&quot;伤害&quot;)..&quot;使&quot;..name(target)..&quot;阵亡&quot;
end
function Story.event(event)
    local kind=event.kind
    if Locale.isEnglish() then
        local source,target=name(event.source),name(event.target)
        if kind==&quot;Damage&quot;then return source..&quot; → &quot;..target..&quot; −&quot;..tostring(event.effective or event.amount)..&quot; / &quot;..(({Normal=&quot;Attack&quot;,Skill=&quot;Skill&quot;,Bleeding=&quot;Bleed&quot;,Reflection=&quot;Reflection&quot;,DeathRattle=&quot;Deathrattle&quot;})[event.damageType]or&quot;Damage&quot;)end
        if kind==&quot;Heal&quot;then return source..&quot; → &quot;..target..&quot; +&quot;..tostring(event.amount)..&quot; / Heal&quot;end
        if kind==&quot;Block&quot;then return target..&quot; blocked &quot;..source..&quot;'s attack&quot;end
        if kind==&quot;Death&quot;then return target..&quot; was eliminated&quot;end
        if kind==&quot;Execute&quot;then return source..&quot; executed &quot;..target..&quot; with Soul Reap&quot;end
        if kind==&quot;LinkTrigger&quot;then return source..&quot; fell; Life Tether took &quot;..target..&quot; with them&quot;end
        if kind==&quot;Skill&quot;then local unit=Identity.byId[event.source];return source..&quot; used &quot;..Locale.translate(unit and unit.skill.name or&quot;技能&quot;)end
        if kind==&quot;Lock&quot;then return target..&quot; was locked out&quot;end
        if kind==&quot;CoreReveal&quot;then local cores={red=&quot;Order&quot;,cyan=&quot;Crescent&quot;,purple=&quot;Wastes&quot;};return &quot;Core reveal: You · &quot;..(cores[event.A]or&quot;Unknown&quot;)..&quot; / Opponent · &quot;..(cores[event.B]or&quot;Unknown&quot;)end
        if kind==&quot;CoreTie&quot;then return &quot;Same core — choose again&quot;end
        if kind==&quot;AttackCommitted&quot;then return (event.owner==&quot;A&quot;and&quot;You&quot;or&quot;Opponent&quot;)..&quot; committed an attack&quot;end
        if kind==&quot;ActionStart&quot;then return (event.owner==&quot;A&quot;and&quot;Your&quot;or&quot;Opponent's&quot;)..&quot; action began&quot;end
        if kind==&quot;RoundEnd&quot;then return &quot;Round ended&quot;end
    end
    if kind==&quot;Damage&quot; then return name(event.source)..&quot; → &quot;..name(event.target)..&quot; −&quot;..tostring(event.effective or event.amount)..&quot; / &quot;..(({Normal=&quot;普攻&quot;,Skill=&quot;技能&quot;,Bleeding=&quot;流血&quot;,Reflection=&quot;反伤&quot;,DeathRattle=&quot;亡语&quot;})[event.damageType] or &quot;伤害&quot;) end
    if kind==&quot;Heal&quot; then return name(event.source)..&quot; → &quot;..name(event.target)..&quot; +&quot;..tostring(event.amount)..&quot; / 恢复&quot; end
    if kind==&quot;Block&quot; then return name(event.target)..&quot;挡住了&quot;..name(event.source)..&quot;的攻击&quot; end
    if kind==&quot;Death&quot; then return name(event.target)..&quot;阵亡&quot; end
    if kind==&quot;Execute&quot; then return name(event.source)..&quot;以掠魂处决&quot;..name(event.target) end
    if kind==&quot;LinkTrigger&quot; then return name(event.source)..&quot;阵亡，命线带走&quot;..name(event.target) end
    if kind==&quot;Skill&quot; then local unit=Identity.byId[event.source];return name(event.source)..&quot;释放&quot;..(unit and unit.skill.name or &quot;技能&quot;) end
    if kind==&quot;Lock&quot; then return name(event.target)..&quot;被封锁&quot; end
    if kind==&quot;CoreReveal&quot; then local cores={red=&quot;秩序&quot;,cyan=&quot;新月&quot;,purple=&quot;荒芜&quot;};return &quot;能核揭示：你 · &quot;..(cores[event.A] or &quot;未知&quot;)..&quot; / 对手 · &quot;..(cores[event.B] or &quot;未知&quot;) end
    if kind==&quot;CoreTie&quot; then return &quot;能核相同，重新暗选&quot; end
    if kind==&quot;AttackCommitted&quot; then return (event.owner==&quot;A&quot; and &quot;你&quot; or &quot;对手&quot;)..&quot;已承诺进攻&quot; end
    if kind==&quot;ActionStart&quot; then return (event.owner==&quot;A&quot; and &quot;你&quot; or &quot;对手&quot;)..&quot;开始行动&quot; end
    if kind==&quot;RoundEnd&quot; then return &quot;本回合结束&quot; end
end
function Story.build(view)
    local result={title=view.winner==&quot;A&quot; and &quot;胜利&quot; or view.winner==&quot;B&quot; and &quot;失利&quot; or view.winner==&quot;Draw&quot; and &quot;同归于尽&quot; or &quot;行动结束&quot;,lines={}}
    local final=view.round;local events=view.events or {};local candidates={}
    for i,event in ipairs(events) do
        local label
        if event.kind==&quot;Execute&quot; then label=Story.event(event)
        elseif event.kind==&quot;LinkTrigger&quot; then label=Story.event(event)
        elseif event.kind==&quot;Damage&quot; and event.damageType==&quot;DeathRattle&quot; then label=Story.event(event)
        elseif event.kind==&quot;Death&quot; then
            local cause
            for j=i-1,1,-1 do
                local previous=events[j]
                if previous.round~=event.round then break end
                if previous.target==event.target and (previous.kind==&quot;Damage&quot; or previous.kind==&quot;Execute&quot; or previous.kind==&quot;LinkTrigger&quot;) then cause=previous;break end
            end
            if cause and cause.kind==&quot;Damage&quot; and cause.damageType~=&quot;DeathRattle&quot; then
                local types={Normal=&quot;普攻&quot;,Skill=&quot;技能&quot;,Bleeding=&quot;流血&quot;,Reflection=&quot;反伤&quot;}
                label=fatal(cause.source,event.target,cause.damageType)
            elseif not cause then label=Story.event(event) end
        end
        if label then table.insert(candidates,{round=event.round,text=label}) end
    end
    -- Show up to three final-round facts in their actual order; earlier facts only if needed.
    local start=math.max(1,#candidates-2)
    for i=start,#candidates do table.insert(result.lines,candidates[i]) end
    if #result.lines==0 then table.insert(result.lines,{round=final,text=&quot;终局已由服务器确认&quot;}) end
    result.subtitle=view.winner==&quot;A&quot; and &quot;对手阵容全部阵亡，行动完成。&quot; or view.winner==&quot;B&quot; and &quot;己方阵容全部阵亡，行动结束。&quot; or view.winner==&quot;Draw&quot; and &quot;死亡连锁结束后，双方阵容全部阵亡。&quot; or &quot;等待服务器确认结果。&quot;
    local owners={}
    for side,roster in pairs(view.rosters or {}) do for _,h in ipairs(roster) do owners[h.id]=side end end
    local lastDeath
    for i=#events,1,-1 do if events[i].kind==&quot;Death&quot; then lastDeath=i;break end end
    result.closing={round=final,steps={},summary=&quot;终局已由服务器确认&quot;,partial=false}
    if lastDeath then
        local first=lastDeath
        for i=lastDeath-1,1,-1 do
            local event=events[i]
            if event.round~=events[lastDeath].round or event.kind==&quot;RoundEnd&quot; then break end
            first=i
            if event.kind==&quot;AttackCommitted&quot; or event.kind==&quot;Skill&quot; or event.kind==&quot;ActionStart&quot; or event.kind==&quot;CoreReveal&quot; then break end
        end
        local closing=result.closing
        closing.round=events[lastDeath].round
        closing.partial=first==1 and events[first].kind~=&quot;AttackCommitted&quot; and events[first].kind~=&quot;Skill&quot; and events[first].kind~=&quot;ActionStart&quot; and events[first].kind~=&quot;CoreReveal&quot;
        local cause
        for i=lastDeath-1,first,-1 do
            local event=events[i]
            if event.target==events[lastDeath].target and (event.kind==&quot;Damage&quot; or event.kind==&quot;Execute&quot; or event.kind==&quot;LinkTrigger&quot;) then cause=event;break end
        end
        closing.source=cause and cause.source;closing.target=events[lastDeath].target
        local summary=cause and Story.event(cause) or (Locale.isEnglish()and name(closing.target)..&quot; was eliminated. Operation ended.&quot;or name(closing.target)..&quot;阵亡，行动结束&quot;)
        if cause and cause.kind==&quot;Damage&quot; then
            local types={Normal=&quot;普攻&quot;,Skill=&quot;技能&quot;,Bleeding=&quot;流血&quot;,Reflection=&quot;反伤&quot;,DeathRattle=&quot;亡语&quot;}
            summary=fatal(cause.source,closing.target,cause.damageType)
        end
        closing.summary=view.winner==&quot;Draw&quot; and &quot;死亡连锁结束 · 双方阵容全部阵亡&quot; or summary
        for i=first,lastDeath do
            local event=events[i];local label=Story.event(event)
            if label then
                if event.kind==&quot;AttackCommitted&quot; then label=&quot;进攻已承诺&quot; elseif event.kind==&quot;ActionStart&quot; then label=&quot;行动开始&quot; end
                local unit=event.kind==&quot;Block&quot; and event.target or event.source or event.target
                local side=event.owner or owners[unit]
                table.insert(closing.steps,{index=i,kind=event.kind,unit=unit,side=side,text=label})
            end
        end
    end
    return result
end
return Story
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX701"><Properties><string name="Name">AudioSources</string><ProtectedString name="Source">-- Audio-only Creator Store assets; no model or executable dependency.
